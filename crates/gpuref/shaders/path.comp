#version 460
// GPU reference path tracer (genos-gpuref): the same light transport as the CPU
// proof (genos-debug reference.rs path_from): Lambertian surfaces, point and
// directional lamps by next-event estimation (shadow ray from the hit lifted 2 cm
// along its normal, irradiance color * 72 / max(d^2, 0.01), a sun at d^2 49), a
// constant sky on a miss, cosine-sampled bounces, Russian roulette from the third
// bounce. Lamps are points (delta lights), so next-event estimation is the only
// way to reach them and there is nothing for MIS to weight; the sky is reached by
// the cosine bounce only. Traced on the hardware ray tracer through its own
// acceleration structures (VK_KHR_ray_query). No denoiser, no clamp.
//
// One difference from the CPU proof, on purpose: rays start at t = 1e-5, not 1e-3.
// Every ray already starts 2 cm off its own surface, so the larger start only lets
// a ray that begins within 1 mm of another face skip it: at a concave corner (the
// stress room's long wall meeting a cross wall) a shadow ray from the corner
// passed through the cross wall and lit the corner from the far side, a column of
// white specks along the seam in the CPU references.
//
// One dispatch: every pixel runs `paths` paths into each half (A: even, B: odd
// sample numbers) and writes the means of this pass; the host sums passes in f64.
#extension GL_EXT_ray_query : require
#extension GL_EXT_scalar_block_layout : require
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
struct Tri {
    vec4 n0; // xyz normal at corner 0, w: albedo r
    vec4 n1; // w: albedo g
    vec4 n2; // w: albedo b
};
layout(std430, set = 0, binding = 1) readonly buffer Tris { Tri tri[]; };
struct Lamp {
    vec4 pos;   // w 1: point lamp at xyz; w 0: directional, xyz the way rays travel
    vec4 color;
};
layout(std430, set = 0, binding = 2) readonly buffer Lamps { Lamp lamp[]; };
layout(std430, set = 0, binding = 3) buffer Out { vec4 px[]; }; // per group, 2 per pixel: A, B (w: luma^2 sum)

layout(push_constant) uniform Push {
    vec4 eye;      // w: tan(fovy / 2)
    vec4 forward;  // w: aspect
    vec4 right;    // w: lamp count
    vec4 up;       // w: max bounces
    vec4 sky;      // w: pass number
    uvec4 dims;    // width, height, paths per half, seed
} pc;

const float LAMBERT = 0.254647909;
const float PI = 3.14159265358979;
const float REACH = 200.0;
const float LAMP_UNIT = 72.0;
const float LAMP_RADIUS = 0.1;
const float GI_T_MIN = 1.0e-5;

uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}
uint rng_state;
float rnd() {
    rng_state = rng_state * 747796405u + 2891336453u;
    uint w = ((rng_state >> ((rng_state >> 28u) + 4u)) ^ rng_state) * 277803737u;
    w = (w >> 22u) ^ w;
    return float(w >> 8u) * (1.0 / 16777216.0);
}

struct Hit {
    vec3 p;
    vec3 n;
    vec3 albedo;
};

// The closest hit within reach; the normal faces the ray (two-sided back hits flip).
bool first_hit(vec3 o, vec3 d, float reach, out Hit h) {
    rayQueryEXT q;
    rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsCullBackFacingTrianglesEXT, 0xFF, o, GI_T_MIN, d, reach);
    while (rayQueryProceedEXT(q)) {}
    if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
        return false;
    }
    float t = rayQueryGetIntersectionTEXT(q, true);
    uint id = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true)) + uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true));
    vec2 b = rayQueryGetIntersectionBarycentricsEXT(q, true);
    Tri tr = tri[id];
    vec3 n = normalize((1.0 - b.x - b.y) * tr.n0.xyz + b.x * tr.n1.xyz + b.y * tr.n2.xyz);
    if (!rayQueryGetIntersectionFrontFaceEXT(q, true)) {
        n = -n;
    }
    h.p = o + d * t;
    h.n = n;
    h.albedo = vec3(tr.n0.w, tr.n1.w, tr.n2.w);
    return true;
}

bool blocked(vec3 a, vec3 b) {
    vec3 d = b - a;
    float dist = length(d);
    if (dist < 1.0e-3) {
        return false;
    }
    rayQueryEXT q;
    rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsCullBackFacingTrianglesEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, a, GI_T_MIN, d / dist, dist - 1.0e-3);
    while (rayQueryProceedEXT(q)) {}
    return rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
}

vec3 direct_in(vec3 o, vec3 n) {
    vec3 sum = vec3(0.0);
    uint count = uint(pc.right.w);
    for (uint i = 0u; i < count; i++) {
        Lamp l = lamp[i];
        vec3 toward;
        float dist2;
        vec3 target;
        if (l.pos.w < 0.5) {
            toward = -normalize(l.pos.xyz);
            dist2 = 49.0;
            target = o + toward * 80.0;
        } else {
            vec3 t = l.pos.xyz - o;
            float dist = max(length(t), 1.0e-4);
            toward = t / dist;
            dist2 = dist * dist;
            target = l.pos.xyz;
        }
        float nd = dot(toward, n);
        if (nd <= 0.0 || blocked(o, target)) {
            continue;
        }
        sum += l.color.rgb * (nd * LAMP_UNIT / max(dist2, LAMP_RADIUS * LAMP_RADIUS));
    }
    return sum;
}

vec3 cosine(vec3 n, float u, float v) {
    float r = sqrt(u);
    float phi = 2.0 * PI * v;
    vec3 up = abs(n.y) < 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 t = normalize(cross(up, n));
    vec3 b = cross(n, t);
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(1.0 - u, 0.0)));
}

vec3 lift(Hit h) {
    return h.p + h.n * 0.02;
}

vec3 path_from(Hit first) {
    Hit at = first;
    vec3 weight = first.albedo * LAMBERT;
    vec3 sum = weight * direct_in(lift(at), at.n);
    uint maxb = uint(pc.up.w);
    for (uint bounce = 0u; bounce < maxb; bounce++) {
        vec3 dir = cosine(at.n, rnd(), rnd());
        weight *= PI;
        Hit next;
        if (!first_hit(lift(at), dir, REACH, next)) {
            sum += weight * pc.sky.rgb;
            break;
        }
        weight *= next.albedo * LAMBERT;
        sum += weight * direct_in(lift(next), next.n);
        if (bounce >= 2u) {
            float keep = clamp(max(next.albedo.r, max(next.albedo.g, next.albedo.b)) * LAMBERT * PI, 0.05, 0.95);
            if (rnd() >= keep) {
                break;
            }
            weight /= keep;
        }
        at = next;
    }
    return sum;
}

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.dims.x || p.y >= pc.dims.y) {
        return;
    }
    uint idx = p.y * pc.dims.x + p.x;
    // Sample groups along z fill the GPU at small sizes; each writes its own sums.
    uint g = gl_GlobalInvocationID.z;
    uint slot = (g * pc.dims.x * pc.dims.y + idx) * 2u;
    float tan_y = pc.eye.w;
    float aspect = pc.forward.w;
    float nx = (2.0 * (float(p.x) + 0.5) / float(pc.dims.x) - 1.0) * tan_y * aspect;
    float ny = (1.0 - 2.0 * (float(p.y) + 0.5) / float(pc.dims.y)) * tan_y;
    vec3 dir = normalize(pc.forward.xyz + pc.right.xyz * nx + pc.up.xyz * ny);
    Hit first;
    if (!first_hit(pc.eye.xyz, dir, REACH, first)) {
        px[slot] = vec4(-1.0);
        px[slot + 1u] = vec4(-1.0);
        return;
    }
    rng_state = hash(idx ^ hash(pc.dims.w ^ hash(uint(pc.sky.w) * 0x9e3779b9u ^ hash(g + 0x51u))));
    uint n = pc.dims.z;
    vec4 acc[2] = vec4[2](vec4(0.0), vec4(0.0));
    for (uint k = 0u; k < 2u * n; k++) {
        vec3 l = path_from(first);
        float y = dot(l, vec3(0.2126, 0.7152, 0.0722));
        acc[k & 1u] += vec4(l, y * y);
    }
    px[slot] = acc[0];
    px[slot + 1u] = acc[1];
}
