#version 450
// Log-luminance histogram of every scene pixel, plus a short still check.
// The CPU reads the header after the fence and clips the tails. Luma stays here.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;

layout(push_constant) uniform Push {
    uvec4 dims;
    uvec4 params;
    uvec4 lamp;
} pc;

#include "hdr_scene.glsl"

// words[0..bins) counts, words[bins] moved, words[bins + 1] total, two pads,
// then two luma halves at `luma_base`. The CPU sizes the buffer to the preset.
layout(std430, set = 0, binding = 18) buffer HdrMeter {
    uint words[];
} meter;

const float REC709_R = 0.2126;
const float REC709_G = 0.7152;
const float REC709_B = 0.0722;
const float LOG_LO = -16.0;
const float LOG_HI = 15.999;
const float LOG_SPAN = 32.0;
const float STILL_MOVE = 0.01;

float scene_y(vec3 c) {
    return dot(c, vec3(REC709_R, REC709_G, REC709_B));
}

uint bin_of(float y, uint bins) {
    float log_l = clamp(log2(y), LOG_LO, LOG_HI);
    float scaled = (log_l - LOG_LO) / LOG_SPAN * float(bins);
    uint index = uint(floor(scaled));
    if (index >= bins) {
        index = bins - 1u;
    }
    return index;
}

void main() {
    uint width = pc.dims.x;
    uint height = pc.dims.y;
    uint pixels = width * height;
    uint i = gl_GlobalInvocationID.x;
    if (i >= pixels) {
        return;
    }
    float y = scene_y(scene_load(i).rgb);
    uint bins = pc.dims.z;
    if (pc.params.w != 0u && y > 0.0 && bins > 0u) {
        if (bins > 256u) {
            bins = 256u;
        }
        atomicAdd(meter.words[bin_of(y, bins)], 1u);
    }
    uint stride = pc.params.z;
    if (stride == 0u || (i % stride) != 0u) {
        return;
    }
    uint slot = i / stride;
    uint slots = pc.dims.w;
    if (slot >= slots) {
        return;
    }
    uint ping = pc.params.y & 1u;
    uint next = 1u - ping;
    uint luma_base = pc.lamp.x;
    if (pc.params.x != 0u) {
        float prev = uintBitsToFloat(meter.words[luma_base + ping * slots + slot]);
        atomicAdd(meter.words[bins + 1u], 1u);
        if (abs(prev - y) > STILL_MOVE) {
            atomicAdd(meter.words[bins], 1u);
        }
    }
    meter.words[luma_base + next * slots + slot] = floatBitsToUint(y);
}
