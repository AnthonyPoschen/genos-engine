#version 450
// Cone-traced cascades, pass 7: a pixel's irradiance is the cosine-weighted
// sum of the merged cascade-0 cones of the voxel-layer probes around it, each
// weighted by the share that passes from the pixel to its seat (lamp.x bit 1).
// The pixel's light, its emission plus its albedo's share of that and of the
// suns (one exact ray a pixel each, cone_sun), goes in
// the G-buffer word compose reads as emitted light (the direct pass does not
// run in this mode).
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
#include "lighting_common.glsl"
#include "cone_common.glsl"

// The irradiance a pixel at `pos` facing `n` reads from the voxel-layer
// probes of level `lod` around it.
vec3 level_irradiance(int lod, vec3 pos, vec3 n) {
    uint probes[8];
    float weights[8];
    ivec3 own = cone_cell(pos, n, cone_spacing(lod, 0));
    int count = cone_weights(0, lod, pos, (pc.lamp.x & 2u) != 0u, pos + n * CONE_SURFACE_LIFT, own, probes, weights);
    uint theta = cone_theta(0);
    uint dirs = cone_dirs(0);
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (uint bin = 0u; bin < dirs; bin++) {
        vec3 d = cone_bin_dir(bin, theta);
        float cosine = dot(d, n);
        if (cosine <= 0.0) {
            continue;
        }
        vec3 v = vec3(0.0);
        vec3 m = vec3(0.0);
        float wsum = 0.0;
        for (int k = 0; k < count; k++) {
            vec3 l;
            float th;
            vec3 mm;
            if (cone_get(cone_record_at(0, probes[k], bin), l, th, mm)) {
                v += l * weights[k];
                m += mm * weights[k];
                wsum += weights[k];
            }
        }
        if (wsum <= 0.0) {
            continue;
        }
        v /= wsum;
        m /= wsum;
        // The light's own cosine when it is known (the bin mean cosine).
        float held = length(m);
        float y = dot(v, CONE_LUMA);
        float lit = cosine;
        if (held > CONE_TINIER && y > CONE_TINIER) {
            float spread = min(held / y, 1.0);
            lit = max(dot(m / held, n), 0.0) * spread + cosine * (1.0 - spread);
        }
        sum += v * lit;
        weight += cosine;
    }
    return weight > 0.0 ? sum * (CONE_PI / weight) : vec3(0.0);
}

// The suns, one exact shadow ray a pixel each (plan section 3's fallback for
// the sun): a cone cascade reads the sky only past its coarsest interval, so
// the sun came through in probe-sized blocks. Point lamps stay in the cones.
// Lit as the old direct pass lights a pixel (lamp_light, albedo over pi).
vec3 cone_sun(vec3 pos, vec3 n, bool two_sided) {
    vec3 from = pos + n * CONE_SURFACE_LIFT;
    vec3 sum = vec3(0.0);
    for (uint i = 0u; i < scene.lamp_count; i++) {
        Lamp lamp = scene_lamp(i);
        if (lamp.pos.w <= 0.5) {
            continue;
        }
        vec3 target;
        vec3 light = lamp_light(lamp, from, n, two_sided, target);
        if (light.r + light.g + light.b > 0.0 && !trace_occluded(from, target)) {
            sum += light;
        }
    }
    return sum;
}

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, pc.dims.xy))) {
        return;
    }
    vec3 pos;
    vec3 n;
    vec3 albedo;
    bool two_sided;
    if (!lighting_surface(p, pos, n, albedo, two_sided)) {
        return;
    }
    uint pixel = p.y * pc.dims.x + p.x;
    vec3 irradiance = level_irradiance(cone_pixel_lod(pos), pos, n);
    uint emitted = gbuf_word(pixel, 3u);
    vec3 glow = emitted == ~0u ? vec3(0.0) : lighting_unpack_rgb9e5(emitted);
    gbuf.words[pixel * GBUF_STRIDE + 3u] = lighting_pack_rgb9e5(glow + albedo * SCENE_LAMBERT * irradiance + albedo * (1.0 / CONE_PI) * cone_sun(pos, n, two_sided));
}
