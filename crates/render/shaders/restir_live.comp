#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// Live ReSTIR DI for screen pixels (ADR 0022 stage C5).
// The initial, temporal, and spatial math is the checker includes
// (restir_sample.glsl, restir_merge.glsl, restir_spatial_ops.glsl, restir_tree.glsl).
// This file only supplies the gbuffer receiver, lamp_light p̂, the previous
// camera, and depth/normal rejection. One thread is one pixel. The push
// constant is the lighting layout: pc.lamp.w is the chunk base, bits 22-23
// of pc.lamp.y select the pass (0 initial, 1 temporal, 2 spatial).
//
// Departure from the checker: each pixel has its own PCG stream, mixed by
// pixel, frame, and pass. The checker keeps one stream in receiver order.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
#include "lighting_common.glsl"

layout(std430, set = 0, binding = 19) buffer RestirWords {
    uint restir_words[];
};

const uint LAMP_EMPTY = 0xffffffffu;
const uint PROPOSAL_TARGET = 1u;
const float M_HI = 65536.0;
// Product history test, the same numbers as lamp_pick_reproject:
// relative depth 0.02, absolute 0.05 m, normal dot 0.9. Bitterli 2020 §6
// and the C5 head use 0.1. That widening is not this port.
const float RESTIR_DEPTH_REL = 0.02;
const float RESTIR_DEPTH_ABS = 0.05;
const float RESTIR_NORMAL_MIN = 0.9;
const float RESTIR_ORIGIN_LIFT = 0.02;
const vec3 RESTIR_LUMA = vec3(0.2126, 0.7152, 0.0722);
const float RESTIR_FWD_MIN = 0.5;
const float RESTIR_Z_MIN = 1.0e-3;
const float RESTIR_NDC_HALF = 0.5;
// One reprojected pixel. C5 searched this pixel and four neighbours
// (RESTIR_TEMPORAL_TRIES 5). Those taps are not accepted here.
const uint RESTIR_TEMPORAL_TRIES = 1u;
const ivec2 RESTIR_TEMPORAL_OFFSETS[1] = ivec2[1](ivec2(0, 0));
// Temporal reprojection decision, one count per surfaced pixel when header
// word 15 is clear. A reset counts neither. These are restir header words,
// copied to the stats readback. Compact keeps gstats.diag[5] and [6] for the
// gradient check when LIGHTING_DIAG is on. The host reads the copy only when
// pc.lamp.y bit 17 is set.
const uint RESTIR_DIAG_HIST_ACCEPT = 43u;
const uint RESTIR_DIAG_HIST_REJECT = 44u;

uint64_t g_state;
uint64_t g_inc;

uint64_t pcg_step() {
    uint64_t old = g_state;
    g_state = old * 6364136223846793005ul + g_inc;
    return old;
}

uint rot_r(uint bits, uint rot) {
    uint r = rot & 31u;
    if (r == 0u) {
        return bits;
    }
    return (bits >> r) | (bits << (32u - r));
}

uint next_u32() {
    uint64_t old = pcg_step();
    uint64_t mixed = ((old >> 18ul) ^ old) >> 27ul;
    uint bits = uint(mixed & 0xfffffffful);
    uint rot = uint(old >> 59ul);
    return rot_r(bits, rot);
}

float next_f32() {
    uint bits = next_u32() >> 8u;
    return float(bits & 0xffffu) * (1.0 / M_HI);
}

uint restir_hdr(uint i) {
    return restir_words[i];
}

float load_f(uint index) {
    return uintBitsToFloat(restir_words[index]);
}

#define RESTIR_WORDS restir_words
#define RESTIR_TREE_BASE restir_hdr(3u)
#define RESTIR_RECV_BASE 0u
#define RESTIR_TREE_COUNT restir_hdr(2u)
#define RESTIR_PROPOSAL restir_hdr(10u)
#define RESTIR_CANDIDATES restir_hdr(9u)
#define RESTIR_LAMP_COUNT restir_hdr(0u)
#define RESTIR_M_CLAMP restir_hdr(11u)
#define RESTIR_M_CAP restir_hdr(12u)
#define RESTIR_WIDTH restir_hdr(7u)
#define RESTIR_SPATIAL_NEIGHBORS restir_hdr(13u)
#define RESTIR_SPATIAL_RADIUS restir_hdr(14u)
#define RESTIR_REVERSE 0u
#define RESTIR_LIVE_RECEIVER
#define RESTIR_LIVE_PHAT

// One surface per invocation. The tree walk asks for the receiver at every
// node it scores and p̂ asks again per candidate; both are this pixel, so the
// G-buffer is decoded once (same values, so the estimator is unchanged).
uint g_surf_recv;
bool g_surf_ok;
vec3 g_surf_pos;
vec3 g_surf_n;
bool g_surf_two;

uint restir_scale() {
    uint s = restir_hdr(46u);
    // 0 and anything outside 1..4 are full resolution. A stale word must not
    // turn the product default into a half-resolution grid.
    if (s < 1u || s > 4u) {
        return 1u;
    }
    return s;
}

// Header 7 is the reservoir grid. Header 46 is screen pixels per edge.
// The gbuffer pixel is the one whose centre is the reservoir pixel's ray.
// Scale 1 is that screen pixel. Scale 2 is the top-left of the 2×2.
uvec2 restir_screen_px(uint pixel) {
    uint width = restir_hdr(7u);
    uint scale = restir_scale();
    uint x = (pixel % width) * scale;
    uint y = (pixel / width) * scale;
    uint screen_w = restir_hdr(48u);
    uint screen_h = restir_hdr(49u);
    if (screen_w != 0u && x >= screen_w) {
        x = screen_w - 1u;
    }
    if (screen_h != 0u && y >= screen_h) {
        y = screen_h - 1u;
    }
    return uvec2(x, y);
}

bool restir_surface_of(uint recv, out vec3 pos, out vec3 n, out bool two_sided) {
    if (recv != g_surf_recv) {
        g_surf_recv = recv;
        g_surf_ok = false;
        g_surf_pos = vec3(0.0);
        g_surf_n = vec3(0.0, 1.0, 0.0);
        g_surf_two = false;
        uint width = restir_hdr(7u);
        uint height = restir_hdr(8u);
        if (width != 0u && recv < width * height) {
            vec3 albedo;
            g_surf_ok = lighting_surface(restir_screen_px(recv), g_surf_pos, g_surf_n, albedo, g_surf_two);
        }
    }
    pos = g_surf_pos;
    n = g_surf_n;
    two_sided = g_surf_two;
    return g_surf_ok;
}

bool restir_receiver_two_sided(uint recv) {
    vec3 pos;
    vec3 n;
    bool two_sided;
    return restir_surface_of(recv, pos, n, two_sided) && two_sided;
}

void restir_receiver(uint recv, out float px, out float py, out float pz, out float nx, out float ny, out float nz) {
    px = 0.0;
    py = 0.0;
    pz = 0.0;
    nx = 0.0;
    ny = 1.0;
    nz = 0.0;
    vec3 pos;
    vec3 n;
    bool two_sided;
    if (!restir_surface_of(recv, pos, n, two_sided)) {
        return;
    }
    px = pos.x;
    py = pos.y;
    pz = pos.z;
    nx = n.x;
    ny = n.y;
    nz = n.z;
}

float restir_phat_at(vec3 pos, vec3 n, bool two_sided, uint lamp) {
    if (lamp >= restir_hdr(0u)) {
        return 0.0;
    }
    uint at = restir_hdr(1u) + lamp * 8u;
    Lamp src;
    src.pos = vec4(load_f(at), load_f(at + 1u), load_f(at + 2u), 0.0);
    src.color = vec4(load_f(at + 4u), load_f(at + 5u), load_f(at + 6u), load_f(at + 3u));
    vec3 origin = pos + n * RESTIR_ORIGIN_LIFT;
    vec3 target;
    vec3 light = lamp_light(src, origin, n, two_sided, target);
    return dot(light, RESTIR_LUMA);
}

float restir_phat(uint recv, uint lamp) {
    vec3 pos;
    vec3 n;
    bool two_sided;
    if (!restir_surface_of(recv, pos, n, two_sided)) {
        return 0.0;
    }
    return restir_phat_at(pos, n, two_sided, lamp);
}

// The product proposal is the light tree. initial_at's 64-bin weight array
// is the checker's other proposal and is not compiled into this pass.
#define RESTIR_TREE_ONLY
#include "restir_tree.glsl"
#include "restir_sample.glsl"
#include "restir_merge.glsl"
#include "restir_spatial_ops.glsl"

// One cell of the in-bounds Chebyshev window, centre skipped. `i` is the
// index neighbor_count would have stored in its pool.
uint restir_window_cell(uint i, uint x0, uint y0, uint span_x, uint width, uint centre) {
    uint cell = i >= centre ? i + 1u : i;
    return (y0 + cell / span_x) * width + (x0 + cell % span_x);
}

// Same partial Fisher-Yates as neighbor_count. The swap table holds the
// slots that moved, not the whole window, so this pass does not carry a
// 256-wide array. `take` calls of uniform_index, then those cells. A short
// rejection draw returned fewer neighbours and a different set each time
// the stream shifted, which is the dabaff8e picture gap.
uint restir_pick_neighbors(uint index, uint receivers, out uint picked[16]) {
    uint width = restir_hdr(7u);
    uint take = restir_hdr(13u);
    uint reach = restir_hdr(14u);
    if (width == 0u || take == 0u || reach == 0u) {
        return 0u;
    }
    uint height = receivers / width;
    if (height == 0u) {
        return 0u;
    }
    uint x = index % width;
    uint y = index / width;
    uint x0 = x > reach ? x - reach : 0u;
    uint y0 = y > reach ? y - reach : 0u;
    uint x1 = min(x + reach, width - 1u);
    uint y1 = min(y + reach, height - 1u);
    uint span_x = x1 - x0 + 1u;
    uint span_y = y1 - y0 + 1u;
    uint cells = span_x * span_y;
    if (cells <= 1u) {
        return 0u;
    }
    uint pool_n = cells - 1u;
    uint centre = (y - y0) * span_x + (x - x0);
    if (take > pool_n) {
        take = pool_n;
    }
    if (take > 16u) {
        take = 16u;
    }
    uint sw_i[32];
    uint sw_v[32];
    for (uint s = 0u; s < 32u; s++) {
        sw_i[s] = 0u;
        sw_v[s] = 0u;
    }
    uint nswap = 0u;
    for (uint slot = 0u; slot < take; slot++) {
        uint span = pool_n - slot;
        uint pick = slot + uniform_index(span);
        uint a = 0u;
        uint b = 0u;
        bool a_hit = false;
        bool b_hit = false;
        for (uint s = 0u; s < nswap; s++) {
            if (sw_i[s] == slot) {
                a = sw_v[s];
                a_hit = true;
            }
            if (sw_i[s] == pick) {
                b = sw_v[s];
                b_hit = true;
            }
        }
        if (!a_hit) {
            a = restir_window_cell(slot, x0, y0, span_x, width, centre);
        }
        if (!b_hit) {
            b = restir_window_cell(pick, x0, y0, span_x, width, centre);
        }
        bool wrote_slot = false;
        bool wrote_pick = false;
        for (uint s = 0u; s < nswap; s++) {
            if (sw_i[s] == slot) {
                sw_v[s] = b;
                wrote_slot = true;
            }
            if (sw_i[s] == pick) {
                sw_v[s] = a;
                wrote_pick = true;
            }
        }
        if (!wrote_slot) {
            sw_i[nswap] = slot;
            sw_v[nswap] = b;
            nswap += 1u;
        }
        if (!wrote_pick && pick != slot) {
            sw_i[nswap] = pick;
            sw_v[nswap] = a;
            nswap += 1u;
        }
        picked[slot] = b;
    }
    return take;
}

void restir_rng(uint pixel, uint pass_id) {
    uint64_t seed = uint64_t(restir_hdr(17u)) | (uint64_t(restir_hdr(18u)) << 32ul);
    seed ^= uint64_t(pixel) * 0x9E3779B97F4A7C15ul;
    seed ^= uint64_t(restir_hdr(16u)) << 17ul;
    seed ^= uint64_t(pass_id) * 0xBF58476D1CE4E5B9ul;
    g_inc = (seed << 1ul) | 1ul;
    g_state = 0ul;
    g_state = pcg_step() + seed;
    next_u32();
}

// Prefix bit per point lamp: its position, colour, or range changed since
// the frame that stored the history (header word 38 is the bitset base).
bool restir_lamp_changed(uint lamp) {
    if (lamp >= restir_hdr(0u)) {
        return true;
    }
    return ((restir_words[restir_hdr(38u) + lamp / 32u] >> (lamp % 32u)) & 1u) != 0u;
}

void restir_store4(uint at, uint lamp, float w_sum, uint m, float target) {
    if (m == 0u || lamp == LAMP_EMPTY || target <= 0.0 || w_sum <= 0.0) {
        restir_words[at] = LAMP_EMPTY;
        restir_words[at + 1u] = floatBitsToUint(0.0);
        restir_words[at + 2u] = 0u;
        restir_words[at + 3u] = floatBitsToUint(0.0);
    } else {
        restir_words[at] = lamp;
        restir_words[at + 1u] = floatBitsToUint(w_sum);
        restir_words[at + 2u] = m;
        restir_words[at + 3u] = floatBitsToUint(target);
    }
}

void restir_load4(uint at, out uint lamp, out float w_sum, out uint m, out float target) {
    lamp = restir_words[at];
    w_sum = uintBitsToFloat(restir_words[at + 1u]);
    m = restir_words[at + 2u];
    target = uintBitsToFloat(restir_words[at + 3u]);
    if (is_empty(lamp, m) || target <= 0.0 || w_sum <= 0.0) {
        store_empty(lamp, w_sum, m, target);
    }
}

bool restir_pixel_surface(uint pixel, out vec3 pos, out vec3 nrm) {
    uint width = restir_hdr(7u);
    uint height = restir_hdr(8u);
    pos = vec3(0.0);
    nrm = vec3(0.0, 1.0, 0.0);
    if (width == 0u || pixel >= width * height) {
        return false;
    }
    vec3 albedo;
    bool two_sided;
    return lighting_surface(restir_screen_px(pixel), pos, nrm, albedo, two_sided);
}

bool restir_depth_normal(float z_ref, float z_other, vec3 n_ref, vec3 n_other) {
    if (!(z_ref > 0.0) || !(z_other > 0.0)) {
        return false;
    }
    float gap = abs(z_ref - z_other);
    if (gap / z_ref > RESTIR_DEPTH_REL && gap > RESTIR_DEPTH_ABS) {
        return false;
    }
    return dot(n_ref, n_other) >= RESTIR_NORMAL_MIN;
}

// The history pixel and the surface it showed last frame (the point the
// history reservoir's weights were built for), rebuilt from the previous
// camera, the pixel centre, and the stored view depth.
bool restir_reproject(vec3 pos, vec3 nrm, out uint hist_pixel, out vec3 hist_pos, out vec3 hist_n) {
    hist_pixel = 0u;
    hist_pos = vec3(0.0);
    hist_n = vec3(0.0, 1.0, 0.0);
    if (restir_hdr(21u) == 0u) {
        return false;
    }
    vec3 eye = vec3(load_f(22u), load_f(23u), load_f(24u));
    vec3 right = vec3(load_f(25u), load_f(26u), load_f(27u));
    float t = load_f(28u);
    vec3 up = vec3(load_f(29u), load_f(30u), load_f(31u));
    vec3 fwd = vec3(load_f(33u), load_f(34u), load_f(35u));
    float aspect = load_f(36u);
    if (dot(fwd, fwd) < RESTIR_FWD_MIN || t == 0.0) {
        return false;
    }
    vec3 rel = pos - eye;
    float z = dot(rel, fwd);
    if (z <= RESTIR_Z_MIN) {
        return false;
    }
    uint width = restir_hdr(7u);
    uint height = restir_hdr(8u);
    // Project in screen pixels, then fold into the reservoir cell. Scale 1
    // is the old reservoir-pixel ray. The history ray is the gbuffer pixel
    // this cell sampled, so a still view compares the same depth.
    uint scale = restir_scale();
    // Scale 1 projects in reservoir pixels, the aa44b042 ray. Screen words
    // apply only when a cell covers more than one pixel.
    uint proj_w = width;
    uint proj_h = height;
    if (scale > 1u) {
        uint screen_w = restir_hdr(48u);
        uint screen_h = restir_hdr(49u);
        if (screen_w != 0u) {
            proj_w = screen_w;
        }
        if (screen_h != 0u) {
            proj_h = screen_h;
        }
    }
    vec2 ndc = vec2(dot(rel, right) / (z * t * aspect), dot(rel, up) / (z * t));
    vec2 px = vec2((ndc.x + 1.0) * RESTIR_NDC_HALF * float(proj_w), (1.0 - ndc.y) * RESTIR_NDC_HALF * float(proj_h));
    if (px.x < 0.0 || px.y < 0.0 || px.x >= float(proj_w) || px.y >= float(proj_h)) {
        return false;
    }
    uint stride = restir_hdr(19u);
    uint prev = restir_hdr(20u) == 0u ? restir_hdr(4u) : restir_hdr(5u);
    // The reprojected pixel only. A neighbour search would keep history the
    // product depth test rejects. A miss drops the history.
    ivec2 base = ivec2(floor(px));
    if (scale > 1u) {
        base = ivec2(int(uint(base.x) / scale), int(uint(base.y) / scale));
    }
    for (uint i = 0u; i < RESTIR_TEMPORAL_TRIES; i++) {
        ivec2 q = base + RESTIR_TEMPORAL_OFFSETS[i];
        if (q.x < 0 || q.y < 0 || q.x >= int(width) || q.y >= int(height)) {
            continue;
        }
        uint cand = uint(q.y) * width + uint(q.x);
        uint geo = prev + cand * stride;
        float z_prev = uintBitsToFloat(restir_words[geo + 4u]);
        vec3 n_prev = lighting_unpack_normal(restir_words[geo + 5u]);
        uvec2 sp = restir_screen_px(cand);
        vec2 centre = vec2(sp) + RESTIR_NDC_HALF;
        vec2 ndc_h = vec2(centre.x / (RESTIR_NDC_HALF * float(proj_w)) - 1.0, 1.0 - centre.y / (RESTIR_NDC_HALF * float(proj_h)));
        vec3 dir_h = fwd + ndc_h.x * t * aspect * right + ndc_h.y * t * up;
        // Compare at the candidate's own ray: this frame's surface plane
        // (pos, nrm) hit along the history pixel's ray, against the stored depth.
        float denom = dot(dir_h, nrm);
        float z_cmp = abs(denom) > RESTIR_Z_MIN ? dot(pos - eye, nrm) / denom : z;
        if (restir_depth_normal(z_cmp, z_prev, nrm, n_prev)) {
            hist_pixel = cand;
            hist_pos = eye + z_prev * dir_h;
            hist_n = n_prev;
            return true;
        }
    }
    return false;
}

void restir_initial(uint pixel, out uint lamp, out float w_sum, out uint m, out float target) {
    initial_tree(pixel, lamp, w_sum, m, target);
    restir_store4(restir_hdr(6u) + pixel * 4u, lamp, w_sum, m, target);
}

void restir_temporal_from(uint pixel, uint lamp, float w_sum, uint m, float target) {
    uint n = restir_hdr(0u);
    bool tree = restir_hdr(10u) >= 2u;
    if (!tree && n > 64u) {
        n = 64u;
    }
    vec3 pos;
    vec3 nrm;
    bool surfaced = restir_pixel_surface(pixel, pos, nrm);
    uint hist_pixel = 0u;
    vec3 hist_pos;
    vec3 hist_n;
    bool reuse = restir_hdr(15u) == 0u && surfaced && restir_reproject(pos, nrm, hist_pixel, hist_pos, hist_n);
    // reuse is the same flag the merge below consumes. A reset (word 15)
    // counts neither an accept nor a reject.
    if (((pc.lamp.y >> 17u) & 1u) != 0u && surfaced && restir_hdr(15u) == 0u) {
        if (reuse) {
            atomicAdd(restir_words[RESTIR_DIAG_HIST_ACCEPT], 1u);
        } else {
            atomicAdd(restir_words[RESTIR_DIAG_HIST_REJECT], 1u);
        }
    }
    uint stride = restir_hdr(19u);
    uint prev = restir_hdr(20u) == 0u ? restir_hdr(4u) : restir_hdr(5u);
    uint h_lamp;
    float h_w;
    uint h_m;
    float h_target;
    if (reuse) {
        restir_load4(prev + hist_pixel * stride, h_lamp, h_w, h_m, h_target);
    } else {
        store_empty(h_lamp, h_w, h_m, h_target);
    }
    float unit = next_f32();
    uint out_lamp = lamp;
    float out_w = w_sum;
    uint out_m = m;
    float out_target = target;
    if (h_m != 0u && h_lamp != LAMP_EMPTY) {
        uint hist_m = h_m;
        float hist_w = h_w;
        // An empty initial reservoir still drew its candidates; restir_store4
        // drops its M to 0, so restore the candidate count here. Without it
        // the history skips every all-miss frame and reads 1/P(hit) too bright.
        bool c_empty = is_empty(lamp, m);
        uint m_now = c_empty ? restir_hdr(9u) : m;
        cap_history(hist_m, hist_w, m_now);
        // Validation: the history sample is re-scored at this frame's point
        // with this frame's lamp (tq_h below), so a lamp that dimmed, moved
        // out of reach, or switched off drops out (tq_h = 0). A lamp that
        // changed this frame also keeps at most the current sample's
        // confidence: its W was built against the old target, so it gets an
        // equal vote instead of up to 20 frames' worth. Scaling w_sum with M
        // keeps the reservoir's W, so the estimate stays unbiased.
        // The clamp must not depend on which lamp the history holds: a
        // weight keyed to the sample (only a changed lamp loses M) breaks
        // the M-weight partition of unity and darkened a wall by a moving
        // lamp ~20 %. Header word 39 is "any lamp changed this frame".
        if (m_now != 0u && hist_m > m_now && restir_hdr(39u) != 0u) {
            hist_w *= m_as_f(m_now) / m_as_f(hist_m);
            hist_m = m_now;
        }
        // Generalized balance heuristic (GRIS): each sample's MIS weight
        // compares M * p_hat over both domains, with the history domain's
        // p_hat taken at the surface the history pixel showed. Scoring both
        // at this pixel (1/M weights) is unbiased only when the two points
        // see the same lamps alike; after camera motion the history point is
        // another surface, and near the camera that error was 29 % (turn).
        bool two_sided = restir_receiver_two_sided(pixel);
        bool c_ok = lamp != LAMP_EMPTY && (tree ? lamp < restir_hdr(0u) : lamp < n);
        bool h_ok = h_lamp != LAMP_EMPTY && (tree ? h_lamp < restir_hdr(0u) : h_lamp < n);
        float pc_c = c_ok && !c_empty ? restir_phat(pixel, lamp) : 0.0;
        float ph_c = c_ok && !c_empty ? restir_phat_at(hist_pos, hist_n, two_sided, lamp) : 0.0;
        float pc_h = h_ok ? restir_phat(pixel, h_lamp) : 0.0;
        float ph_h = h_ok ? restir_phat_at(hist_pos, hist_n, two_sided, h_lamp) : 0.0;
        merge_pair_balance(
            c_empty ? LAMP_EMPTY : lamp, w_sum, m_now, target, pc_c, ph_c,
            h_lamp, hist_w, hist_m, h_target, pc_h, ph_h,
            unit,
            out_lamp, out_w, out_m, out_target);
    }
    uint next = restir_hdr(20u) == 0u ? restir_hdr(5u) : restir_hdr(4u);
    uint at = next + pixel * stride;
    restir_store4(at, out_lamp, out_w, out_m, out_target);
    float depth = 0.0;
    uint packed = lighting_pack_normal(vec3(0.0, 1.0, 0.0));
    if (surfaced) {
        depth = dot(pos - scene.eye.xyz, scene.view_forward.xyz);
        packed = lighting_pack_normal(nrm);
    }
    restir_words[at + 4u] = floatBitsToUint(depth);
    restir_words[at + 5u] = packed;
}

void restir_temporal(uint pixel) {
    uint lamp;
    float w_sum;
    uint m;
    float target;
    restir_load4(restir_hdr(6u) + pixel * 4u, lamp, w_sum, m, target);
    restir_temporal_from(pixel, lamp, w_sum, m, target);
}

void restir_spatial(uint pixel) {
    uint width = restir_hdr(7u);
    uint height = restir_hdr(8u);
    uint receivers = width * height;
    uint n = restir_hdr(0u);
    uint stride = restir_hdr(19u);
    uint next = restir_hdr(20u) == 0u ? restir_hdr(5u) : restir_hdr(4u);
    uint lamp;
    float w_sum;
    uint m;
    float target;
    restir_load4(next + pixel * stride, lamp, w_sum, m, target);
    uint out_lamp = lamp;
    float out_w = w_sum;
    uint out_m = m;
    float out_target = target;
    vec3 pos;
    vec3 nrm;
    bool surfaced = restir_pixel_surface(pixel, pos, nrm);
    float z_here = surfaced ? dot(pos - scene.eye.xyz, scene.view_forward.xyz) : 0.0;
    // Header 47: odd reservoir pixels keep the temporal sample. The copy
    // pass writes the even neighbour's spatial result into them afterwards.
    bool skip = false;
    if (restir_hdr(47u) != 0u && width != 0u) {
        uint x = pixel % width;
        uint y = pixel / width;
        skip = ((x + y) & 1u) != 0u;
    }
    // No surface: the temporal sample is the result. Skipping the shuffle
    // does not change it (a rejected neighbour never reaches the merge).
    if (!skip && surfaced && restir_hdr(13u) != 0u && restir_hdr(14u) != 0u && width != 0u) {
        uint picked[16];
        uint nbor = restir_pick_neighbors(pixel, receivers, picked);
        float unit = next_f32();
        if (nbor != 0u) {
            uint src_recv[17];
            uint in_lamp[17];
            float in_w[17];
            uint in_m[17];
            float in_target[17];
            float in_tq[17];
            uint nslots = 1u;
            src_recv[0] = pixel;
            in_lamp[0] = is_empty(lamp, m) ? LAMP_EMPTY : lamp;
            in_w[0] = w_sum;
            // An empty reservoir still drew its candidates (stored as M 0).
            in_m[0] = is_empty(lamp, m) ? RESTIR_CANDIDATES : m;
            in_target[0] = target;
            in_tq[0] = phat_at(pixel, lamp, n);
            for (uint s = 0u; s < nbor; s++) {
                uint source = picked[s];
                // The temporal pass stored this frame's view depth in the same
                // buffer. A depth miss fails the live test too, so the gbuffer
                // fetch and p-hat are skipped. A depth hit still uses the live
                // surface, including its full-precision normal.
                float z_stored = uintBitsToFloat(restir_words[next + source * stride + 4u]);
                if (!(z_here > 0.0) || !(z_stored > 0.0)) {
                    continue;
                }
                float gap = abs(z_here - z_stored);
                if (gap / z_here > RESTIR_DEPTH_REL && gap > RESTIR_DEPTH_ABS) {
                    continue;
                }
                vec3 npos;
                vec3 nn;
                bool ok = restir_pixel_surface(source, npos, nn);
                if (ok) {
                    float z_n = dot(npos - scene.eye.xyz, scene.view_forward.xyz);
                    ok = restir_depth_normal(z_here, z_n, nrm, nn);
                }
                if (!ok) {
                    continue;
                }
                src_recv[nslots] = source;
                restir_load4(next + source * stride, in_lamp[nslots], in_w[nslots], in_m[nslots], in_target[nslots]);
                if (is_empty(in_lamp[nslots], in_m[nslots])) {
                    in_lamp[nslots] = LAMP_EMPTY;
                    in_m[nslots] = RESTIR_CANDIDATES;
                }
                in_tq[nslots] = phat_at(pixel, in_lamp[nslots], n);
                nslots += 1u;
            }
            if (nslots > 1u) {
                balance_list(
                    nslots, src_recv, in_lamp, in_w, in_m, in_target, in_tq,
                    unit, n,
                    out_lamp, out_w, out_m, out_target);
            }
        }
    }
    restir_store4(restir_hdr(6u) + pixel * 4u, out_lamp, out_w, out_m, out_target);
}

void restir_checker_copy(uint pixel) {
    if (restir_hdr(47u) == 0u) {
        return;
    }
    uint width = restir_hdr(7u);
    if (width == 0u) {
        return;
    }
    uint x = pixel % width;
    uint y = pixel / width;
    if (((x + y) & 1u) == 0u) {
        return;
    }
    uint src = pixel;
    if (x > 0u) {
        src = pixel - 1u;
    } else if (y > 0u) {
        src = pixel - width;
    }
    uint at = restir_hdr(6u);
    uint lamp;
    float w_sum;
    uint m;
    float target;
    restir_load4(at + src * 4u, lamp, w_sum, m, target);
    restir_store4(at + pixel * 4u, lamp, w_sum, m, target);
}

void main() {
    uint width = restir_hdr(7u);
    uint height = restir_hdr(8u);
    uint pixel = pc.lamp.w + gl_GlobalInvocationID.x;
    if (width == 0u || pixel >= width * height) {
        return;
    }
    uint pass_id = (pc.lamp.y >> 22u) & 3u;
    g_surf_recv = 0xffffffffu;
    restir_rng(pixel, pass_id);
    // Header 50 clear: temporal follows initial in this invocation and
    // reseeds with pass 1, the same stream a split temporal dispatch draws.
    // The sample stays in registers. Reloading it from the buffer raced the
    // store on the 4070 and the picture moved with frame pacing.
    // Header 50 set: pass 1 is the temporal dispatch, after the host barrier.
    if (pass_id == 0u) {
        uint lamp;
        float w_sum;
        uint m;
        float target;
        restir_initial(pixel, lamp, w_sum, m, target);
        if (restir_hdr(50u) == 0u) {
            restir_rng(pixel, 1u);
            restir_temporal_from(pixel, lamp, w_sum, m, target);
        }
    } else if (pass_id == 1u) {
        if (restir_hdr(50u) != 0u) {
            restir_temporal(pixel);
        }
    } else if (pass_id == 2u) {
        restir_spatial(pixel);
    } else {
        restir_checker_copy(pixel);
    }
}
