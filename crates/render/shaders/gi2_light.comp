#version 450
// GI v2 direct light: every lamp at a surface point, each with a shadow ray through
// the tracer. The points are the picture's pixels (G-buffer) followed by the screen
// probes' and the light cache's ray hits, so all share this loop and its one trace
// site. A pixel keeps its irradiance; a hit adds the light cache's bounced
// irradiance and turns the sum into the light it sends back along the ray, plus
// any light the surface emits. A pixel's emitted light (G-buffer w from the
// raster) moves to the output buffer for the final pass.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "gi2_common.glsl"

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint pixels = pc.dims.x * pc.dims.y;
    uint mode = gi2_mode();
    if (mode == 2u) {
        idx += pixels + gi2_probe_rays();
    }
    uint rays = mode == 1u ? gi2_probe_rays() : gi2_all_rays();
    if (idx >= pixels + rays) {
        return;
    }
    vec3 pos;
    vec3 n;
    vec3 reflectance = vec3(1.0);
    bool two_sided = false;
    vec3 glow = vec3(0.0);
    if (idx < pixels) {
        vec3 albedo;
        if (!gi2_surface(uvec2(idx % pc.dims.x, idx / pc.dims.x), pos, n, albedo, two_sided)) {
            return;
        }
    } else {
        vec4 h = work.v[gi2_hit_at(idx - pixels)];
        vec3 origin;
        vec3 dir;
        vec3 from_n;
        if (h.x < 0.0 || !gi2_ray(idx - pixels, origin, dir, from_n)) {
            return;
        }
        pos = origin + dir * h.x;
        n = gi2_unpack_normal(floatBitsToUint(h.y));
        reflectance = unpackUnorm4x8(floatBitsToUint(h.z)).rgb * (1.0 / GI2_PI);
        glow = gi2_unpack_rgb9e5(floatBitsToUint(h.w));
    }
    vec3 origin = pos + n * 0.02;
    LampList list = lamps_at(origin);
    uint count = lamp_list_size(list);
    vec3 e = vec3(0.0);
    [[dont_unroll]] for (uint k = 0u; k < count; k++) {
        vec3 target;
        vec3 light = lamp_light(lamp_list_get(list, k), origin, n, two_sided, target);
        if (light.r + light.g + light.b <= 0.0) {
            continue;
        }
        if (!trace_occluded(origin, target)) {
            e += light;
        }
    }
    if (idx < pixels) {
        uint emitted = gbuf.px[idx].w;
        outc.px[idx] = emitted == ~0u ? 0u : emitted;
        gbuf.px[idx].w = gi2_pack_rgb9e5(e);
    } else {
        e += gi2_cache_irradiance(pos, n);
        work.v[gi2_rad_at(idx - pixels)] = vec4(reflectance * e + glow, 0.0);
    }
}
