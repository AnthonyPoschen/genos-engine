#version 450
// GI v2 direct light: every lamp at a surface point, each with a shadow ray through
// the tracer. The points are the picture's pixels (G-buffer) followed by every kept
// hit of the screen probes (all strata, so a kept hit always carries this frame's
// light: no light history), the light cache's ray hits and the probes' fills, so all share this loop
// and its one trace site. A pixel keeps its irradiance; a hit adds the light cache's bounced
// irradiance and turns the sum into the light it sends back along the ray, plus
// any light the surface emits. A pixel's emitted light (G-buffer w from the
// raster) moves to the output buffer for the final pass.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "gi2_common.glsl"

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint pixels = pc.dims.x * pc.dims.y;
    uint mode = gi2_mode();
    uint kept = gi2_kept_hits();
    uint cache_rays = GI2_CACHE_BATCH * GI2_CACHE_RAYS;
    if (mode == 2u) {
        idx += pixels + kept;
    }
    // Then (not on the async queue) one point per fill slot (gi2_fill_ray).
    uint fills = pixels + kept + (mode == 1u ? 0u : cache_rays);
    uint points = fills + (mode == 2u ? 0u : kept);
    if (idx >= points) {
        return;
    }
    // A kept probe hit (index h), a light cache ray (ray) or a fill (index h).
    bool fill_hit = idx >= fills;
    bool probe_hit = (idx >= pixels && idx < pixels + kept) || fill_hit;
    uint h = fill_hit ? idx - fills : idx - pixels;
    uint ray = idx < pixels + kept || fill_hit ? 0u : gi2_probe_rays() + (idx - pixels - kept);
    vec3 pos;
    vec3 n;
    vec3 reflectance = vec3(1.0);
    bool two_sided = false;
    vec3 glow = vec3(0.0);
    if (idx < pixels) {
        vec3 albedo;
        if (!gi2_surface(uvec2(idx % pc.dims.x, idx / pc.dims.x), pos, n, albedo, two_sided)) {
            return;
        }
    } else {
        vec4 rec;
        vec3 origin;
        vec3 dir;
        vec3 from_n;
        bool live;
        if (probe_hit) {
            uint rays = gi2_rays();
            uint ps = h / rays;
            if (fill_hit) {
                live = gi2_fill_ray(ps / GI2_STRATA, ps % GI2_STRATA, h % rays, origin, dir, from_n);
                if (!live) {
                    return;
                }
                rec = work.v[gi2_fill_at(h)];
                if (rec.x < -0.75) {
                    gi2_put_fill_light(h, has_sky() ? scene.sky.rgb : vec3(0.0));
                    return;
                }
            } else {
                rec = work.v[gi2_kept_at(h)];
                live = gi2_stratum_ray(ps / GI2_STRATA, ps % GI2_STRATA, h % rays, origin, dir, from_n);
                if (live && rec.x < -0.75) {
                    gi2_put_kept_light(h, has_sky() ? scene.sky.rgb : vec3(0.0));
                    return;
                }
            }
        } else {
            rec = work.v[gi2_hit_at(ray)];
            live = gi2_ray(ray, origin, dir, from_n);
        }
        if (rec.x < 0.0 || !live) {
            return;
        }
        pos = origin + dir * rec.x;
        n = gi2_unpack_normal(floatBitsToUint(rec.y));
        reflectance = unpackUnorm4x8(floatBitsToUint(rec.z)).rgb * (1.0 / GI2_PI);
        glow = gi2_unpack_rgb9e5(floatBitsToUint(rec.w));
    }
    vec3 origin = pos + n * 0.02;
    LampList list = lamps_at(origin);
    uint count = lamp_list_size(list);
    // Light cache rays (params.z bit 11): at most GI2_CACHE_PICKS shadow rays,
    // lamps picked systematically in proportion to their unshadowed light, each
    // weighted by how often it is expected to be picked (unbiased, as
    // lamps_light_only). The pick offset hangs on the patch and the ray, so a
    // still scene relights to the same value.
    bool pick = idx >= pixels + kept && !fill_hit && ((pc.params.z >> 11u) & 1u) != 0u;
    float total = 0.0;
    uint lit = 0u;
    float u = 0.0;
    if (pick) {
        uint r = ray - gi2_probe_rays();
        uint slot = gi2_cache_batch_slot(r / GI2_CACHE_RAYS);
        uint key = slot == ~0u ? 0u : ckeys.key[slot];
        u = gi2_unit(key ^ ((r % GI2_CACHE_RAYS) * 0x85ebca6bu + 0x5bd1e995u));
        [[dont_unroll]] for (uint k = 0u; k < count; k++) {
            vec3 target;
            vec3 light = lamp_light(lamp_list_get(list, k), origin, n, two_sided, target);
            float w = light.r + light.g + light.b;
            total += w;
            lit += w > 0.0 ? 1u : 0u;
        }
    }
    bool exact = !pick || lit <= GI2_CACHE_PICKS;
    float step = total / float(GI2_CACHE_PICKS);
    float run = 0.0;
    vec3 e = vec3(0.0);
    [[dont_unroll]] for (uint k = 0u; k < count; k++) {
        vec3 target;
        vec3 light = lamp_light(lamp_list_get(list, k), origin, n, two_sided, target);
        float w = light.r + light.g + light.b;
        if (w <= 0.0) {
            continue;
        }
        float times = 1.0;
        if (!exact) {
            float before = ceil(run / step - u);
            run += w;
            times = ceil(run / step - u) - before;
        }
        if (times > 0.0 && !trace_occluded(origin, target)) {
            e += exact ? light : light * (times * step / w);
        }
    }
    if (idx < pixels) {
        uint emitted = gbuf.px[idx].w;
        outc.px[idx] = emitted == ~0u ? 0u : emitted;
        gbuf.px[idx].w = gi2_pack_rgb9e5(e);
    } else {
        e += gi2_cache_irradiance(pos, n);
        if (fill_hit) {
            gi2_put_fill_light(h, reflectance * e + glow);
        } else if (probe_hit) {
            gi2_put_kept_light(h, reflectance * e + glow);
        } else {
            work.v[gi2_rad_at(ray)] = vec4(reflectance * e + glow, 0.0);
        }
    }
}
