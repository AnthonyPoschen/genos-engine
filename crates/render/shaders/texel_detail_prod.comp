#version 450
// Production path for ADR 0039 stage 3. This dispatch calls
// lighting_world_irradiance_in from lighting_cache.glsl, the function
// lighting_compose.comp calls through lighting_world_irradiance.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 1) in;
#include "lighting_common.glsl"

// Default experiments.sc_flags. Head 3.w bit 0 is surface_cache.sh_cells.
// Bit 17 is surface_cache.sh_texel_detail. Denoise is ctrl bit 64.
const uint PROD_SC_FLAGS = 6007050u;
const uint PROD_SH_CELLS = 1u;
const uint PROD_DETAIL_BIT = 131072u;
const uint PROD_DENOISE = 64u;
const uint PROD_FRAME = 10u;
const uint PROD_STAMP = 3u;
const uint PROD_MODE = 3008u;
const float PROD_HALF = 0.5;
const float PROD_HALF_TEXEL = 0.0625;
const float PROD_GAP = 8.0;
const float PROD_CELL_N = 16.0;
const float PROD_OWN_N = 1.0;
const float PROD_LAMP_RANGE = 64.0;
const float PROD_LAMP_POWER = 8.0;
const float PROD_LAMP_SHIFT = 1.0;
const float PROD_CONF = 0.25;
const vec3 PROD_UP = vec3(0.0, 1.0, 0.0);
const vec3 PROD_RED = vec3(8.0, 0.0, 0.0);
const vec3 PROD_GREEN = vec3(0.0, 6.0, 0.0);
const vec3 PROD_BLUE = vec3(0.0, 0.0, 7.0);
const vec3 PROD_OWN = vec3(4.0, 2.0, 0.0);
const vec3 PROD_SLANT = vec3(0.6, 0.8, 0.2);
const vec3 PROD_PROBE = vec3(1.0, 2.0, 3.0);
const uint PROD_HEAD = 4u;
const uint PROD_STRIDE = 24u;
const uint PROD_ROWS = 10u;

void prod_u(uint i, uint v) {
    outc.px[i] = v;
}

void prod_f(uint i, float v) {
    outc.px[i] = floatBitsToUint(v);
}

void prod_head(bool detail_on) {
    uint at = lighting_change_at();
    work.v[at] = vec4(0.0, 1.0, float(2u * PROD_SC_FLAGS), float(PROD_MODE));
    work.v[at + 1u] = vec4(0.0);
    work.v[at + 2u] = vec4(0.0);
    uint head_w = PROD_SH_CELLS;
    if (detail_on) {
        head_w |= PROD_DETAIL_BIT;
    }
    work.v[at + 3u] = vec4(0.0, 0.0, 0.0, float(head_w));
    work.v[at + 4u] = vec4(0.0, 0.0, 1.0, 0.0);
    gstats.ctrl_bits = PROD_DENOISE;
}

void prod_lamp(vec3 p) {
    uint at = LIGHTING_WRC_RING_AT;
    vec3 b = p + vec3(PROD_LAMP_SHIFT, 0.0, 0.0);
    ckeys.key[at] = floatBitsToUint(p.x);
    ckeys.key[at + 1u] = floatBitsToUint(p.y);
    ckeys.key[at + 2u] = floatBitsToUint(p.z);
    ckeys.key[at + 3u] = floatBitsToUint(b.x);
    ckeys.key[at + 4u] = floatBitsToUint(b.y);
    ckeys.key[at + 5u] = floatBitsToUint(b.z);
    ckeys.key[at + 6u] = floatBitsToUint(PROD_LAMP_RANGE);
    ckeys.key[at + 7u] = floatBitsToUint(PROD_LAMP_POWER);
    ckeys.key[at + 8u] = PROD_FRAME;
    ckeys.key[at + 9u] = floatBitsToUint(0.0);
}

uint prod_sh_hash(uint s) {
    uvec4 a = floatBitsToUint(cache.v[LIGHTING_SH_AT + s]);
    vec4 b = cache.v[LIGHTING_SH_B_AT + (s >> 1u)];
    return a.x ^ a.y ^ a.z ^ a.w ^ floatBitsToUint(b.x) ^ floatBitsToUint(b.y) ^ floatBitsToUint(b.z) ^ floatBitsToUint(b.w);
}

vec3 prod_pos(uint id) {
    return vec3(float(id) * PROD_GAP + PROD_HALF_TEXEL, 0.0, PROD_HALF_TEXEL);
}

vec3 prod_texel(vec3 pos, vec3 n) {
    uint ax = lighting_axis(n) >> 1u;
    vec3 ta = vec3(0.0);
    vec3 tb = vec3(0.0);
    ta[(ax + 1u) % 3u] = 1.0;
    tb[(ax + 2u) % 3u] = 1.0;
    float size = LIGHTING_SC_TEXEL;
    vec2 uv = vec2(dot(pos, ta), dot(pos, tb)) / size - PROD_HALF;
    vec2 g0 = floor(uv);
    vec2 c = g0 + vec2(PROD_HALF);
    return pos + ta * (c.x * size - dot(pos, ta)) + tb * (c.y * size - dot(pos, tb));
}

void prod_paint(vec3 q, vec3 n, vec3 rgb, float samples) {
    uint ax = lighting_axis(n) >> 1u;
    vec3 ta = vec3(0.0);
    vec3 tb = vec3(0.0);
    ta[(ax + 1u) % 3u] = 1.0;
    tb[(ax + 2u) % 3u] = 1.0;
    float size = LIGHTING_SH_CELL;
    vec2 uv = vec2(dot(q, ta), dot(q, tb)) / size - PROD_HALF;
    vec2 g0 = floor(uv);
    for (uint k = 0u; k < 4u; k++) {
        vec2 c = g0 + vec2(float(k & 1u), float(k >> 1u)) + vec2(PROD_HALF);
        vec3 p = q + ta * (c.x * size - dot(q, ta)) + tb * (c.y * size - dot(q, tb));
        uint s = lighting_cache_find_sized(p, n, true, size, p);
        if (s == ~0u) {
            continue;
        }
        cache.v[3u * s + 2u] = vec4(rgb, samples);
        lighting_sh_put(s, rgb, vec3(0.0), vec3(0.0), vec3(0.0));
        cache.v[3u * s].w = uintBitsToFloat(PROD_STAMP);
    }
}

uint prod_owner(vec3 q, vec3 n, vec3 rgb, float samples) {
    uint s = lighting_cache_find_sized(q, n, true, LIGHTING_SH_CELL, q);
    if (s == ~0u) {
        return s;
    }
    cache.v[3u * s + 2u] = vec4(rgb, samples);
    lighting_sh_put(s, rgb, vec3(0.0), vec3(0.0), vec3(0.0));
    cache.v[3u * s].w = uintBitsToFloat(PROD_STAMP);
    return s;
}

void prod_store(uint id, vec4 shown, uint cell, vec4 mean_before, uint stamp_before, uint hash_before, bool detail_on) {
    uint at = PROD_HEAD + id * PROD_STRIDE;
    vec4 mean_after = cell == ~0u ? vec4(0.0) : cache.v[3u * cell + 2u];
    uint stamp_after = cell == ~0u ? 0u : floatBitsToUint(cache.v[3u * cell].w);
    uint hash_after = cell == ~0u ? 0u : prod_sh_hash(cell);
    vec3 q = prod_texel(prod_pos(id), PROD_UP);
    uint texel = lighting_cache_find_sized(q, PROD_UP, false, LIGHTING_SC_TEXEL, q);
    float conf = 0.0;
    float own = 0.0;
    vec3 seed_rgb = vec3(0.0);
    if (texel != ~0u) {
        conf = cache.v[LIGHTING_SC_SPARSE_AT + texel].z;
        own = cache.v[3u * texel + 2u].w;
        seed_rgb = lighting_sc_seed(texel).rgb;
    }
    prod_f(at, shown.r);
    prod_f(at + 1u, shown.g);
    prod_f(at + 2u, shown.b);
    prod_f(at + 3u, shown.w);
    prod_f(at + 4u, mean_before.r);
    prod_f(at + 5u, mean_before.g);
    prod_f(at + 6u, mean_before.b);
    prod_f(at + 7u, mean_before.w);
    prod_f(at + 8u, mean_after.r);
    prod_f(at + 9u, mean_after.g);
    prod_f(at + 10u, mean_after.b);
    prod_f(at + 11u, mean_after.w);
    prod_u(at + 12u, stamp_before);
    prod_u(at + 13u, stamp_after);
    prod_u(at + 14u, hash_before);
    prod_u(at + 15u, hash_after);
    prod_f(at + 16u, conf);
    prod_f(at + 17u, own);
    prod_f(at + 18u, detail_on ? 1.0 : 0.0);
    prod_u(at + 19u, lighting_sc_flags());
    prod_f(at + 20u, seed_rgb.r);
    prod_f(at + 21u, seed_rgb.g);
    prod_f(at + 22u, seed_rgb.b);
    prod_f(at + 23u, (gstats.ctrl_bits & PROD_DENOISE) != 0u ? 1.0 : 0.0);
}

void main() {
    prod_head(true);
    prod_u(0u, lighting_sc_flags());
    prod_u(1u, uint(work.v[lighting_change_at() + 3u].w));
    prod_u(2u, gstats.ctrl_bits);
    prod_u(3u, lighting_world_mode());
    prod_lamp(prod_pos(0u));
    for (uint id = 0u; id < PROD_ROWS; id++) {
        bool detail_on = id != 2u && id != 9u;
        prod_head(detail_on);
        if (id >= 8u) {
            gstats.ctrl_bits = 0u;
        }
        lighting_px_probes = id == 0u ? PROD_PROBE : vec3(-1.0);
        vec3 pos = prod_pos(id);
        vec3 n = id == 6u ? normalize(PROD_SLANT) : PROD_UP;
        vec3 q = prod_texel(pos, PROD_UP);
        vec3 owner_rgb = PROD_RED;
        float owner_n = PROD_CELL_N;
        if (id == 1u) {
            owner_rgb = vec3(0.0);
            owner_n = 0.0;
        } else if (id == 3u) {
            owner_rgb = PROD_BLUE;
        }
        uint cell = ~0u;
        if (id != 7u) {
            prod_paint(q, PROD_UP, PROD_GREEN, PROD_CELL_N);
            cell = prod_owner(q, PROD_UP, owner_rgb, owner_n);
        }
        if (id == 3u) {
            uint texel = lighting_cache_find_sized(q, PROD_UP, true, LIGHTING_SC_TEXEL, q);
            lighting_sc_set_seed(texel, PROD_GREEN, PROD_CONF, 0.0);
        }
        if (id == 4u || id == 7u) {
            uint texel = lighting_cache_find_sized(q, PROD_UP, true, LIGHTING_SC_TEXEL, q);
            cache.v[3u * texel + 2u] = vec4(PROD_OWN, PROD_OWN_N);
        }
        vec4 mean = cell == ~0u ? vec4(0.0) : cache.v[3u * cell + 2u];
        uint stamp = cell == ~0u ? 0u : floatBitsToUint(cache.v[3u * cell].w);
        uint hash = cell == ~0u ? 0u : prod_sh_hash(cell);
        bool mover = id == 5u;
        vec4 shown = lighting_world_irradiance_in(pos, n, pos, mover);
        prod_store(id, shown, cell, mean, stamp, hash, detail_on);
    }
}
