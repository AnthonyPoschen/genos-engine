#version 450
// GI v2 light cache, first pass: list the live patch slots, mature from the front
// and young from the back (both counts were zeroed before the round), so the
// round's batch relights live patches only, the young first. A slot claimed but
// not yet written (normal w 0) waits for the next round. No trace.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "gi2_common.glsl"

void main() {
    uint slot = gl_GlobalInvocationID.x;
    if (gi2_dense()) {
        // S70A: the args pass (one group, after the counts are in).
        if (slot == 0u) {
            gi2_write_args();
        }
        return;
    }
    if (slot >= GI2_CACHE_SLOTS || ckeys.key[slot] == 0u || !(cache.v[3u * slot + 1u].w > 0.0)) {
        return;
    }
    // Near a change (params.z bit 5): a patch on or around an object that moved,
    // came or went sees a different scene, so it is relit with the young (first),
    // not when the sweep comes round (every live / batch rounds).
    bool near = ((pc.params.z >> 5u) & 1u) != 0u && gi2_near_change(gi2_sc_texel_pos(slot));
    float t = cache.v[3u * slot + 2u].w;
    if (gi2_world_mode() == 3u) {
        gi2_sc_pool(slot);
        // Flag 4096: near a change the point a texel is lit from may now be inside
        // the object that moved there; the readers of this frame offer again.
        if (near && (gi2_sc_flags() & 4096u) != 0u) {
            cache.v[GI2_WORLD_AT + slot].x = 1.0e30;
        }
        // Surface cache: the young are new texels and those near a change; the
        // sweep takes the texels still adding sets that someone read in the last
        // second (every eighth round, all of them), and converged texels only while
        // the light is changing.
        // Texels pixels read in the last second grow to the cap; texels only rays
        // read (the light bounced off them) to GI2_SC_HIT_CAP sets.
        uint last = floatBitsToUint(cache.v[3u * slot].w);
        uint shown = floatBitsToUint(cache.v[GI2_WORLD_AT + slot].z);
        bool on_screen = shown != 0u && int(gi2_frame() - shown) <= 60;
        bool read = int(gi2_frame() - last) <= 60;
        bool growing = (gi2_sc_flags() & 4u) != 0u
            ? (on_screen && t < gi2_sc_cap(slot) - 0.5) || (read && t < GI2_SC_HIT_CAP - 0.5)
            : (read && t < gi2_sc_cap(slot) - 0.5);
        // Flag 8192: texels someone read keep relighting at the cap (a running mean
        // of weight 2 / (cap + 1)), so light bounced in after they converged (the
        // cache around them was darker while they took their first sets) still
        // reaches them.
        if ((gi2_sc_flags() & 8192u) != 0u && read) {
            growing = (gi2_sc_flags() & 262144u) == 0u || t < GI2_SC_HOLD * gi2_sc_cap(slot) - 0.5;
        }
        // Flag 1048576: a dormant texel (converged, its sets agree with its mean)
        // is relit one sweep in GI2_SC_DORMANT, by slot, to notice change.
        if ((gi2_sc_flags() & 1048576u) != 0u && growing && t >= gi2_sc_cap(slot) - 0.5 && gi2_sc_dormant(slot)) {
            growing = ((gi2_hash(slot) + gi2_round()) % GI2_SC_DORMANT) == 0u;
        }
        // Flag 1024: while the light changes only the patches ray hits read (25 cm
        // and up, flag 256) are relit, as in the other modes; pixels show the probes.
        bool hit_patch = cache.v[3u * slot + 1u].w > 0.2;
        bool changing = !gi2_sc_light_quiet() && ((gi2_sc_flags() & 1024u) == 0u || hit_patch);
        if ((gi2_sc_flags() & 1024u) != 0u && !gi2_sc_light_quiet() && !hit_patch && !near) {
            growing = false;
        }
        if ((gi2_sc_flags() & 131072u) != 0u && hit_patch) {
            growing = true;
        }
        // Lumen priority (GI2_SC_SCHED): replaces growing / changing / dormant
        // above. Priority = frames read since the last relight (LastUsed -
        // LastUpdated), times cap / sets (GIBS: unconverged first, at most 8x),
        // over GI2_SC_DORMANT when dormant; a texel nobody read since its relight
        // waits. Listed when its bucket reaches the threshold.
        // WRC cells (25 cm) a pixel needs as a seed this frame with fewer than
        // GI2_WRC_YOUNG sets are the reveal burst: young, whole sets. New fine
        // texels start from the WRC (gi2_sc_resample) and take their turn.
        bool wrc = cache.v[3u * slot + 1u].w > 0.2;
        // S62B: the burst ends at what the cell can hold now (under changing
        // light gi2_sc_count keeps it to the light window, 8 samples, which never
        // reached GI2_WRC_YOUNG = 16: every needed cell stayed a burst and took
        // the batch from the fine texels), and at most GI2_WRC_BURST_MAX cells a
        // round burst.
        // S62C: near a mover the count stays short; those cells refresh from the
        // change list, not as bursts.
        bool burst = wrc && !near && t < GI2_WRC_YOUNG - 0.5 && int(gi2_frame() - floatBitsToUint(cache.v[GI2_WORLD_AT + slot].z)) <= 2;
        if (burst && atomicAdd(ckeys.key[GI2_WRC_BURST_COUNT_AT], 1u) >= GI2_WRC_BURST_MAX) {
            burst = false;
        }
        if (wrc && !burst && GI2_SC_SCHED) {
            // WRC refresh (fixed budget): change-driven list, else background.
            if (int(gi2_frame() - last) > int(GI2_CACHE_LIFE)) {
                atomicAdd(gstats.freed, 1u);
                ckeys.key[slot] = 0u;
                cache.v[3u * slot + 1u] = vec4(0.0);
                cache.v[3u * slot + 2u] = vec4(0.0);
                return;
            }
            uint updated = gi2_sc_updated(slot);
            vec3 cp = gi2_sc_texel_pos(slot);
            if (near || gi2_wrc_lamp_changed(cp, updated)) {
                uint at = atomicAdd(ckeys.key[GI2_WRC_CHG_COUNT_AT], 1u);
                if (at < GI2_WRC_REFRESH_CELLS) {
                    ckeys.key[GI2_WRC_CHG_AT + at] = slot;
                }
                return;
            }
            bool stale = int(gi2_frame() - updated) >= int(GI2_WRC_REFRESH_FRAMES);
            bool growing_wrc = t < GI2_WRC_CAP - 0.5 && (int(last - updated) > 0 || int(gi2_frame() - last) <= int(GI2_SC_READ_SLACK));
            if (stale || growing_wrc) {
                uint at = atomicAdd(ckeys.key[GI2_WRC_BG_COUNT_AT], 1u);
                if (at < GI2_WRC_REFRESH_CELLS) {
                    ckeys.key[GI2_WRC_BG_AT + at] = slot;
                }
            }
            return;
        }
        bool young_now = near || burst || (!GI2_SC_SCHED && t < 1.5);
        if (GI2_SC_SCHED && !young_now) {
            uint updated = gi2_sc_updated(slot);
            int used = int(last - updated);
            if (updated == 0u) {
                // Never relit: as if read for a second since.
                used = min(used, 60);
            }
            if (int(gi2_frame() - last) > int(GI2_CACHE_LIFE)) {
                atomicAdd(gstats.freed, 1u);
                ckeys.key[slot] = 0u;
                cache.v[3u * slot + 1u] = vec4(0.0);
                cache.v[3u * slot + 2u] = vec4(0.0);
                return;
            }
            // S68A: the readers stamp the frame of the relight itself (or the
            // one before, rounds are async), so a texel read every frame looked
            // unread the round after each relight and was relit every other
            // round (due alternated ~25k / ~50, half the rounds near idle).
            // Read within the last GI2_SC_READ_SLACK frames counts as read.
            if (used <= 0 && int(gi2_frame() - last) <= int(GI2_SC_READ_SLACK)) {
                used = 1;
            }
            if (used <= 0) {
                // S62E (a): resident but unread, and the global light moved more
                // than 10 % since its relight: a whole set from the WRC
                // background list (within the WRC refresh cap). Shown rescaled
                // meanwhile (gi2_ls_ratio).
                if (abs(gi2_ls_ratio(gi2_sc_updated(slot)) - 1.0) > 0.1) {
                    uint at = atomicAdd(ckeys.key[GI2_WRC_BG_COUNT_AT], 1u);
                    if (at < GI2_WRC_REFRESH_CELLS) {
                        ckeys.key[GI2_WRC_BG_AT + at] = slot;
                    }
                }
                return;
            }
            // S64A: relit only once due (the budget is a ceiling).
            if (int(gi2_frame() - updated) < int(gi2_sc_interval(slot, t))) {
                atomicAdd(gstats.waiting, 1u);
                return;
            }
            vec4 est = cache.v[GI2_SC_EST_AT + 2u * slot + 1u];
            bool settled_now = gi2_sc_settled(slot, t);
            // S65C: the change is the larger of the estimator's measure and the
            // moved lamps' delta at the texel (GI2_SC_LAMP_K per unit ratio).
            float chg = est.x > 0.0 ? max(max(max(est.y, 0.0), GI2_SC_LAMP_K * gi2_sc_lamp_change(slot)), gi2_sc_global_change(slot)) : 1.0e9;
            bool mover_t;
            // Eligible once it has its own history (GI2_DN_MIN_SETS sets and the
            // estimator running), settled or not: the threshold alone splits.
            if (est.x > 0.0 && t >= GI2_DN_MIN_SETS - 0.5 && chg < GI2_SC_TRICKLE_THR && !gi2_sc_local_change(slot, mover_t)) {
                // S65A trickle tier.
                uint at = atomicAdd(ckeys.key[GI2_SC_TRICKLE_COUNT_AT], 1u);
                if (at < GI2_SC_TRICKLE) {
                    ckeys.key[GI2_SC_TRICKLE_AT + at] = slot;
                    atomicAdd(gstats.pad2, 1u);
                }
                return;
            }
            float cap = gi2_sc_cap(slot);
            // Hit patches taking each relight whole (flag 131072) hold at most
            // GI2_CACHE_MATURE sets: they weigh against that, not the pixel cap
            // (S59C weighed them 8x for good and they took the budget).
            float w = clamp(cap / max(t, 1.0), 1.0, 8.0);
            if (wrc) {
                // WRC cells near the camera first (Lumen keeps the radiance cache
                // densest around the eye).
                float d = length(gi2_sc_texel_pos(slot) - scene.eye.xyz);
                w *= d < GI2_WRC_NEAR ? 2.0 : 0.5;
            }
            if (!settled_now) {
                // Not settled: never below twice a settled texel's priority.
                w = max(w, GI2_SC_UNSETTLED_W);
            } else {
                // S65A: settled above the trickle threshold, ranked by its change.
                w *= 1.0 + GI2_SC_RATE_K * min(chg, 8.0);
            }
            if ((gi2_sc_flags() & 1048576u) != 0u && t >= cap - 0.5 && gi2_sc_dormant(slot)) {
                w /= float(GI2_SC_DORMANT);
            }
            uint b = uint(clamp(log2(1.0 + float(used) * w) * 4.0, 0.0, float(GI2_SC_BUCKETS - 1u)));
            // Whole 64-ray sets until settled, and above the trickle threshold.
            bool full = !settled_now || chg >= GI2_SC_TRICKLE_THR || (est.x > 0.0 && est.y > GI2_SC_FULL_INC);
            uint m = gi2_sc_entries(slot, full);
            atomicAdd(gstats.due, m);
            atomicAdd(ckeys.key[GI2_SC_HIST_AT + b], m);
            if (b < ckeys.key[GI2_SC_THR_AT]) {
                return;
            }
            uint at = atomicAdd(ckeys.key[GI2_CACHE_SLOTS], m);
            for (uint i = 0u; i < m; i++) {
                ckeys.key[GI2_CACHE_SLOTS + 1u + at + i] = slot;
            }
            return;
        }
        if (!(near || t < 0.5 || growing || changing)) {
            // Not in this round: a texel nobody has read for GI2_CACHE_LIFE frames
            // is freed here (gi2_cache.comp frees only what a round relights).
            if (int(gi2_frame() - last) > int(GI2_CACHE_LIFE)) {
                atomicAdd(gstats.freed, 1u);
                ckeys.key[slot] = 0u;
                cache.v[3u * slot + 1u] = vec4(0.0);
                cache.v[3u * slot + 2u] = vec4(0.0);
            }
            return;
        }
        bool young = young_now;
        uint m = gi2_sc_entries(slot, true);
        if (young) {
            uint at = atomicAdd(ckeys.key[2u * GI2_CACHE_SLOTS + 1u], m);
            for (uint i = 0u; i < m; i++) {
                ckeys.key[2u * GI2_CACHE_SLOTS - at - i] = slot;
            }
        } else {
            uint at = atomicAdd(ckeys.key[GI2_CACHE_SLOTS], m);
            for (uint i = 0u; i < m; i++) {
                ckeys.key[GI2_CACHE_SLOTS + 1u + at + i] = slot;
            }
        }
        return;
    }
    uint m = gi2_sc_entries(slot, true);
    if (near || t < GI2_CACHE_MATURE - 0.5) {
        uint at = atomicAdd(ckeys.key[2u * GI2_CACHE_SLOTS + 1u], m);
        for (uint i = 0u; i < m; i++) {
            ckeys.key[2u * GI2_CACHE_SLOTS - at - i] = slot;
        }
    } else {
        uint at = atomicAdd(ckeys.key[GI2_CACHE_SLOTS], m);
        for (uint i = 0u; i < m; i++) {
            ckeys.key[GI2_CACHE_SLOTS + 1u + at + i] = slot;
        }
    }
}
