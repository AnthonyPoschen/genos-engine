#version 450
// GI v2 light cache, first pass: list the live patch slots, mature from the front
// and young from the back (both counts were zeroed before the round), so the
// round's batch relights live patches only, the young first. A slot claimed but
// not yet written (normal w 0) waits for the next round. No trace.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "gi2_common.glsl"

void main() {
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= GI2_CACHE_SLOTS || ckeys.key[slot] == 0u || !(cache.v[3u * slot + 1u].w > 0.0)) {
        return;
    }
    // Near a change (params.z bit 5): a patch on or around an object that moved,
    // came or went sees a different scene, so it is relit with the young (first),
    // not when the sweep comes round (every live / batch rounds).
    bool near = false;
    if (((pc.params.z >> 5u) & 1u) != 0u) {
        vec4 head = work.v[gi2_change_at()];
        uint changes = head.y > 0.5 ? 0u : min(uint(head.x + 0.5), GI2_CHANGES);
        vec3 p = cache.v[3u * slot].xyz;
        [[dont_unroll]] for (uint c = 0u; c < changes && !near; c++) {
            vec4 b = work.v[gi2_change_at() + GI2_CHANGE_HEAD + c];
            vec3 d = p - b.xyz;
            float r = b.w + GI2_NEAR_CHANGE;
            near = dot(d, d) < r * r;
        }
    }
    if (near || cache.v[3u * slot + 2u].w < GI2_CACHE_MATURE - 0.5) {
        uint at = atomicAdd(ckeys.key[2u * GI2_CACHE_SLOTS + 1u], 1u);
        ckeys.key[2u * GI2_CACHE_SLOTS - at] = slot;
    } else {
        uint at = atomicAdd(ckeys.key[GI2_CACHE_SLOTS], 1u);
        ckeys.key[GI2_CACHE_SLOTS + 1u + at] = slot;
    }
}
