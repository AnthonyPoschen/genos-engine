#version 450
// Picture compose. Do not call scene_candidates_skip or include a work-tube
// here. That walk, compiled into this dispatch, is what made a moving frame's
// compose tens of milliseconds and the NVIDIA compiler sit for minutes. A
// small sun step uses lighting_sun_compose.comp instead.
// GI final pass: per pixel, emitted light, then direct irradiance plus the
// screen probes' irradiance
// (the 4 nearest probes, weighted by plane distance and normal; the light cache
// where none matches), through the same
// legacy shoulder and dither as the picture. The scene-referred radiance is
// stored first (binding 13) and is not toned. Pixels with no surface keep the raster
// colour already in the output. Clears the G-buffer record for the next frame.
//
// Quiet frames dispatch one 8x8 group per block whose inputs changed
// (LIGHTING_COMPOSE_LIST). A full frame (camera, resize, or a picture bigger
// than the list) sets LIGHTING_COMPOSE_FULL and covers the image. The picture
// stays in outc[0..pixels); emitted light for this frame is outc[pixels..).
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
// Surface-cache claims, stamps, resample, parent seeds, first fill and
// sc_offer stay in this pipeline (specialization constant 0, on). A second
// maintenance compile of this file was removed: it was an extra startup
// pipeline, and the world cache is what the picture reads.
layout(constant_id = 0) const bool COMPOSE_SC_WRITES = true;
#define LIGHTING_SC_WRITES COMPOSE_SC_WRITES
#include "lighting_common.glsl"
#include "lighting_screen_probe.glsl"
#include "dither.glsl"
#include "froxel_compose.glsl"

// GENOS_HDR_COMPOSE is the second compile of this file. The plain compile is
// the legacy shoulder with no extra buffers: declaring them here moved the
// bounce between frames on lavapipe. `legacy_bytes` uses the plain compile.
#ifdef GENOS_HDR_COMPOSE
// Scene-referred radiance, before the display transform. w is eye distance in metres.
layout(std430, set = 0, binding = 13) restrict buffer SceneReferred {
    vec4 px[];
} scene_lin;

// x exposure (0 means 1), y display mode, z bloom intensity.
layout(std430, set = 0, binding = 14) restrict readonly buffer HdrPost {
    vec4 v;
} hdr;

#include "hdr_display.glsl"
#endif

const float LAMBERT = 0.254647909;

#include "hdr_shoulder.glsl"

uint pack_rgb(vec3 rgb) {
    uvec3 c = uvec3(clamp(rgb, 0.0, 1.0) * 255.0 + 0.5);
    if ((pc.params.z & 1u) == 1u) {
        return c.b | (c.g << 8u) | (c.r << 16u) | (255u << 24u);
    }
    return c.r | (c.g << 8u) | (c.b << 16u) | (255u << 24u);
}

vec3 indirect(uvec2 p, vec3 pos, vec3 n) {
    // lighting_screen_probe_indirect. A pixel whose displayed indirect is the
    // SH texel detail value does not read screen-probe irradiance. A covered
    // mover is one of those pixels. Coverage and the display each call
    // lighting_sh_read, so that pixel is two lookups, and diag counts the
    // compose call, not one lookup. A mover whose read rejects, a miss, and
    // an empty slant still read the probes.
    return lighting_screen_probe_indirect(p, pos, n);
}

void main() {
    lighting_px_unfilled = false;
    uvec2 p;
    // GI off, or compose reuse off, covers the image and does not read the key
    // table. The table is a dummy while GI is off.
    bool reuse = (gstats.ctrl_bits & 4u) != 0u && (gstats.ctrl_bits & 128u) != 0u && (gstats.ctrl_bits & 32u) != 0u;
    if (!reuse || ckeys.key[LIGHTING_COMPOSE_FULL] != 0u) {
        p = gl_GlobalInvocationID.xy;
    } else {
        uint bw = (pc.dims.x + 7u) / 8u;
        uint block = ckeys.key[LIGHTING_COMPOSE_LIST + gl_WorkGroupID.x];
        uvec2 b = uvec2(block % bw, block / bw);
        p = b * 8u + gl_LocalInvocationID.xy;
    }
    if (p.x >= pc.dims.x || p.y >= pc.dims.y) {
        return;
    }
    lighting_compose_px = p;
    vec3 pos;
    vec3 n;
    vec3 albedo;
    bool two_sided;
    uint index = p.y * pc.dims.x + p.x;
    if (!lighting_surface(p, pos, n, albedo, two_sided)) {
#ifdef GENOS_HDR_COMPOSE
        // The clear already wrote the toned sky. Keep those bytes. The grade
        // reads this linear sky and does not invert the shoulder.
        scene_lin.px[index] = vec4(scene.sky.rgb, 1000.0);
#endif
        return;
    }
    uint scale = max(gstats.ctrl_scale, 1u);
    uvec2 sp = (p / scale) * scale;
    uint sindex = sp.y * pc.dims.x + sp.x;
    vec3 direct = lighting_unpack_rgb9e5(gbuf_word(sindex, 3u));
    vec3 glow;
    if ((gstats.ctrl_bits & 1u) == 0u) {
        // The pixel direct pass did not run, so gbuf.w is still emission
        // (~0 when the surface emits nothing) and the glow half of the picture
        // was never written. Reading that half unpacks uninitialised rgb9e5,
        // which is a solid red field with bright speckles.
        direct = vec3(0.0);
        uint emitted = gbuf_word(index, 3u);
        glow = emitted == ~0u || (gstats.ctrl_bits & 512u) == 0u ? vec3(0.0) : lighting_unpack_rgb9e5(emitted);
    } else {
        if (gstats.ctrl_history != 0u && (gstats.ctrl_bits & 32768u) == 0u) {
            direct = lighting_unpack_rgb9e5(outc.px[pc.dims.x * pc.dims.y * 2u + sindex]);
        }
        // The light pass left the pixel's emitted light past the picture.
        glow = lighting_unpack_rgb9e5(outc.px[pc.dims.x * pc.dims.y + index]);
        if ((gstats.ctrl_bits & 512u) == 0u) {
            glow = vec3(0.0);
        }
    }
    gbuf_clear_pixel(index);
    if (two_sided && dot(n, scene.eye.xyz - pos) < 0.0) {
        n = -n;
    }
    // Debug view (debug_view.rs ViewMode): 0 full, 1 direct, 2 bounce, 3 albedo,
    // 4 normal, 5 depth, 6 light, 7 texels.
    uint mode = scene.grid_at.w & 255u;
    vec3 shown;
    if (mode == 3u || mode == 4u || mode == 5u) {
        float depth = clamp(1.0 - length(pos - scene.eye.xyz) / 50.0, 0.0, 1.0);
        shown = mode == 3u ? albedo : (mode == 4u ? n * 0.5 + 0.5 : vec3(depth));
        outc.px[index] = pack_rgb(shown);
        return;
    }
    if (mode == 8u) {
        // Short-term relative standard deviation (debug_view.rs ViewMode::Variance).
        // Missing or unallocated entries are grey. Quiet is blue, noisy is red.
        float rel = lighting_sc_debug_variance(pos, n);
        shown = rel < 0.0 ? vec3(0.55, 0.55, 0.55) : mix(vec3(0.15, 0.25, 0.9), vec3(0.9, 0.15, 0.1), rel);
        outc.px[index] = pack_rgb(shown);
        return;
    }
    if (mode == 7u) {
        // Texel sizes (debug_view.rs ViewMode::Texels).
        vec2 ts = lighting_sc_debug_size(pos, n);
        vec3 col = ts.x < 0.09 ? vec3(1.0, 0.2, 0.2) : (ts.x < 0.2 ? vec3(0.2, 1.0, 0.2) : (ts.x < 0.4 ? vec3(0.25, 0.4, 1.0) : vec3(1.0, 0.3, 1.0)));
        float lit = 0.55 + 0.45 * abs(dot(n, vec3(0.3, 0.8, 0.5)));
        shown = col * lit * (ts.y >= 4.0 ? 1.0 : 0.35);
        outc.px[index] = pack_rgb(shown);
        return;
    }
    vec3 bounce = vec3(0.0);
    bool gi = (gstats.ctrl_bits & 4u) != 0u;
    if (gi && ((gstats.ctrl_bits & 16384u) != 0u || gstats.ctrl_bounce > 0u)) {
        bounce = indirect(p, pos, n);
    }
    if ((gstats.ctrl_bits & 4096u) != 0u) {
        vec3 sky_fill = vec3(gstats.ctrl_ambient_r, gstats.ctrl_ambient_g, gstats.ctrl_ambient_b);
        vec3 fill = sky_fill;
        if ((gstats.ctrl_bits & 8192u) != 0u) {
            float up = clamp(n.y * 0.5 + 0.5, 0.0, 1.0);
            vec3 ground = vec3(gstats.ctrl_ground_r, gstats.ctrl_ground_g, gstats.ctrl_ground_b);
            fill = mix(ground, sky_fill, up);
        }
        bounce += fill * gstats.ctrl_ambient_i;
    }
    if (mode == 1u || mode == 6u) {
        bounce = vec3(0.0);
    }
    if (mode == 2u) {
        direct = vec3(0.0);
        glow = vec3(0.0);
    }
    vec3 c = (gstats.ctrl_bits & 2097152u) != 0u
        ? direct + albedo * LAMBERT * bounce + glow
        : albedo * LAMBERT * (direct + bounce) + glow;
    // The column is the integral through 64 m plus the height-fog tail. History
    // is off, so this is the pixel's own column and not a reprojection.
    // A zero fog header leaves the radiance alone. The scene image stores that result.
    c = froxel_compose(c, p, pc.dims.xy);
#ifdef GENOS_HDR_COMPOSE
    scene_lin.px[index] = vec4(c, length(pos - scene.eye.xyz));
    c = add_bloom(c, index);
    float exposure = hdr.v.x;
    if (exposure == 0.0) {
        exposure = 1.0;
    }
    c *= exposure;
#endif
    // The shoulder stays in this shader. AgX is hdr_agx.comp, after this pass.
    shown = vec3(tone_channel(c.r), tone_channel(c.g), tone_channel(c.b));
    // Magenta on pixels whose surface-cache corners had no finished set.
    // GENOS_LIGHTING_UNFILLED_TINT, or Shift+F8. Quiet compose only tints the
    // blocks it redrew; a turn composes the whole frame.
    if (lighting_px_unfilled && lighting_unfilled_tint()) {
        shown = mix(shown, vec3(1.0, 0.0, 1.0), 0.75);
    }
    outc.px[index] = pack_rgb(dither8(shown, p));
}
