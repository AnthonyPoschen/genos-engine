#version 450
// GI v2 S72V: layer 2 as SVGF over the surface-cache texels (lighting_cache.glsl,
// "S72V layer 2 as SVGF"): stage 0 variance, 1-5 a-trous, 6 push + IC placement.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "lighting_common.glsl"

void main() {
    uint slot = gl_GlobalInvocationID.x;
    // S78X: levels 1-5 run their work list (lighting_svgf_mark).
    uint stage0 = lighting_atrous_stage();
    // Phase 0 d8-d12: one thread records the list count (a value past the cap overflowed).
    if (LIGHTING_DIAG != 0 && stage0 >= 1u && stage0 <= 5u && slot == 0u) {
        atomicMax(gstats.dp[8u + stage0 - 1u], ckeys.key[lighting_atrous_list(stage0)]);
    }
    if (LIGHTING_DIRTY_ATROUS && LIGHTING_ATROUS_LISTS && stage0 >= 1u && stage0 <= 5u) {
        uint cnt = ckeys.key[lighting_atrous_list(stage0)];
        if (cnt <= LIGHTING_ATROUS_LIST_CAP) {
            if (slot >= cnt) {
                return;
            }
            slot = ckeys.key[lighting_atrous_list(stage0) + 1u + slot];
        }
    }
    if (slot >= LIGHTING_CACHE_SLOTS || !lighting_sc_svgf() || ckeys.key[slot] == 0u || !(cache.v[3u * slot + 1u].w > 0.0)) {
        return;
    }
    lighting_obj_salt = cache.v[LIGHTING_SC_OBJ_AT + slot].x > 0.5 ? cache.v[LIGHTING_SC_OBJ_AT + slot].x : 0.0;
    uint stage = lighting_atrous_stage();
    if (!lighting_svgf_active(slot)) {
        if (stage == 0u) {
            // No data for the levels: mask 0 in both ping-pong buffers.
            lighting_svgf_store(LIGHTING_SC_ATROUS_A, slot, vec3(0.0), 0.0, 0.0);
            lighting_svgf_store(LIGHTING_SC_ATROUS_B, slot, vec3(0.0), 0.0, 0.0);
            if (LIGHTING_DIRTY_ATROUS) {
                lighting_svgf_inactive(slot); // S77D: every kept level too
            }
        }
        return;
    }
    if (stage == 0u) {
        lighting_svgf_variance(slot);
    } else if (stage <= 5u) {
        lighting_svgf_iter(slot, stage - 1u);
    } else {
        lighting_svgf_push(slot);
    }
}
