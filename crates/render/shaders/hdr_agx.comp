#version 450
// Display pass. The lattice sample stays out of the GI compose shader so the
// plain compile stays the pre-HDR shader. This pass reads the scene radiance
// compose stored, adds the same-frame bloom, applies exposure, and replaces
// the 8-bit picture. Mode 1 is AgX. Mode 0 and mode 2 keep the shoulder.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
#include "dither.glsl"

layout(push_constant) uniform Push {
    uvec4 dims;
    uvec4 params;
    uvec4 lamp;
} pc;

layout(std430, set = 0, binding = 8) buffer Out {
    uint px[];
} outc;

layout(std430, set = 0, binding = 13) restrict readonly buffer SceneReferred {
    vec4 px[];
} scene_lin;

layout(std430, set = 0, binding = 14) restrict readonly buffer HdrPost {
    vec4 v;
    vec4 extra;
} hdr;

// PQ or scRGB codes. The fp16 tail, used when the swapchain is RGBA16F, starts
// after one vec4 per pixel.
layout(std430, set = 0, binding = 17) buffer HdrEncode {
    uint words[];
} encode;

#include "hdr_display.glsl"

// Lattice of agx_rec709. N = 32, log2 from -12 to 10, x-fastest.
layout(std430, set = 0, binding = 15) restrict readonly buffer AgxLut {
    vec4 texel[];
} agx_lut;

vec3 agx_fetch(int x, int y, int z) {
    int index = (z * 32 + y) * 32 + x;
    return agx_lut.texel[index].rgb;
}

vec3 agx_sample(vec3 c) {
    vec3 p = (log2(max(c, vec3(1e-8))) - vec3(-12.0)) / 22.0;
    p = clamp(p, 0.0, 1.0);
    vec3 g = p * 31.0;
    ivec3 i0 = clamp(ivec3(floor(g)), ivec3(0), ivec3(31));
    ivec3 i1 = min(i0 + ivec3(1), ivec3(31));
    vec3 f = g - vec3(i0);
    vec3 c000 = agx_fetch(i0.x, i0.y, i0.z);
    vec3 c100 = agx_fetch(i1.x, i0.y, i0.z);
    vec3 c010 = agx_fetch(i0.x, i1.y, i0.z);
    vec3 c110 = agx_fetch(i1.x, i1.y, i0.z);
    vec3 c001 = agx_fetch(i0.x, i0.y, i1.z);
    vec3 c101 = agx_fetch(i1.x, i0.y, i1.z);
    vec3 c011 = agx_fetch(i0.x, i1.y, i1.z);
    vec3 c111 = agx_fetch(i1.x, i1.y, i1.z);
    vec3 c00 = mix(c000, c100, f.x);
    vec3 c10 = mix(c010, c110, f.x);
    vec3 c01 = mix(c001, c101, f.x);
    vec3 c11 = mix(c011, c111, f.x);
    vec3 c0 = mix(c00, c10, f.y);
    vec3 c1 = mix(c01, c11, f.y);
    return mix(c0, c1, f.z);
}

#include "hdr_shoulder.glsl"

float pq_st2084(float nits) {
    float c1 = 3424.0 / 4096.0;
    float c2 = 2413.0 / 128.0;
    float c3 = 2392.0 / 128.0;
    float m1 = 2610.0 / 16384.0;
    float m2 = 2523.0 / 32.0;
    float y = max(nits, 0.0) / 10000.0;
    float y_m = y <= 0.0 ? 0.0 : pow(y, m1);
    return pow((c1 + c2 * y_m) / (1.0 + c3 * y_m), m2);
}

float nits_of(float d, float white) {
    if (!(d > 0.0)) {
        return 0.0;
    }
    d = min(d, 1.0);
    white = clamp(white, 1e-4, 0.999);
    if (d <= white) {
        return d / white * 203.0;
    }
    float t = (d - white) / (1.0 - white);
    return 203.0 + t * (1000.0 - 203.0);
}

vec3 rec2020_from_rec709(vec3 c) {
    return vec3(
        dot(c, vec3(0.6274019247, 0.3292919718, 0.0433061035)),
        dot(c, vec3(0.0690954897, 0.9195442813, 0.0113602290)),
        dot(c, vec3(0.0163937091, 0.0880281624, 0.8955781285))
    );
}

vec3 hdr10_of(vec3 linear, float white) {
    vec3 rec2020 = rec2020_from_rec709(linear);
    return vec3(
        pq_st2084(nits_of(rec2020.r, white)),
        pq_st2084(nits_of(rec2020.g, white)),
        pq_st2084(nits_of(rec2020.b, white))
    );
}

vec3 scrgb_of(vec3 linear, float white) {
    return vec3(
        nits_of(linear.r, white),
        nits_of(linear.g, white),
        nits_of(linear.b, white)
    ) / 80.0;
}

uint pack_a2b10(vec3 code) {
    uvec3 q = uvec3(clamp(code, 0.0, 1.0) * 1023.0 + 0.5);
    return q.r | (q.g << 10u) | (q.b << 20u) | (3u << 30u);
}

uint pack_a2r10(vec3 code) {
    uvec3 q = uvec3(clamp(code, 0.0, 1.0) * 1023.0 + 0.5);
    return q.b | (q.g << 10u) | (q.r << 20u) | (3u << 30u);
}

uint pack_rgb(vec3 rgb) {
    uvec3 c = uvec3(clamp(rgb, 0.0, 1.0) * 255.0 + 0.5);
    if ((pc.params.z & 1u) == 1u) {
        return c.b | (c.g << 8u) | (c.r << 16u) | (255u << 24u);
    }
    return c.r | (c.g << 8u) | (c.b << 16u) | (255u << 24u);
}

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.dims.x || p.y >= pc.dims.y) {
        return;
    }
    uint index = p.y * pc.dims.x + p.x;
    vec3 c = scene_lin.px[index].rgb;
    c = add_bloom(c, index);
    float exposure = hdr.v.x;
    if (exposure == 0.0) {
        exposure = 1.0;
    }
    c *= exposure;
    vec3 formed = (hdr.v.y > 0.5 && hdr.v.y < 1.5)
        ? agx_sample(c)
        : vec3(tone_channel(c.r), tone_channel(c.g), tone_channel(c.b));
    outc.px[index] = pack_rgb(dither8(formed, p));
    if (hdr.v.w > 0.5) {
        vec3 linear = pow(max(formed, vec3(0.0)), vec3(2.4));
        float white = hdr.extra.x;
        vec3 encoded = hdr.v.w < 1.5 ? hdr10_of(linear, white) : scrgb_of(linear, white);
        uint at = index * 4u;
        encode.words[at] = floatBitsToUint(encoded.r);
        encode.words[at + 1u] = floatBitsToUint(encoded.g);
        encode.words[at + 2u] = floatBitsToUint(encoded.b);
        encode.words[at + 3u] = 0u;
        float fmt = hdr.extra.z;
        if (fmt > 63.0 && fmt < 65.0) {
            outc.px[index] = pack_a2b10(encoded);
        } else if (fmt > 57.0 && fmt < 59.0) {
            outc.px[index] = pack_a2r10(encoded);
        } else if (fmt > 96.0 && fmt < 98.0) {
            uint base = pc.dims.x * pc.dims.y * 4u + index * 2u;
            encode.words[base] = packHalf2x16(encoded.rg);
            encode.words[base + 1u] = packHalf2x16(vec2(encoded.b, 1.0));
        }
    }
}
