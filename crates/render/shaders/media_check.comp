#version 450
// Compile check for media.glsl. Not embedded. build.rs compiles it and discards it.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 1) in;

layout(std430, set = 0, binding = 0) buffer Out {
    float values[];
} result;

#include "media.glsl"

void main() {
    result.values[0] = media_transmittance(0.5);
    result.values[1] = media_height_density(0.08, 40.0, 10.0, 0.0);
    result.values[2] = media_phase_hg(0.4, 0.5);
    result.values[3] = media_homogeneous_inscatter(0.2, 0.15, 2.0);
    result.values[4] = media_height_optical_depth(0.08, 40.0, 0.0, 10.0, 20.0, 0.5, 40.0);
}
