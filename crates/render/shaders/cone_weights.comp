#version 450
// Cone-traced cascades, pass 5: the probes of cascade params.x + 1 that a
// probe of cascade params.x reads in the merge, trilinear about its cell's
// centre, each weighted by the share that passes from its seat to theirs
// (lamp.x bit 0).
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "lighting_common.glsl"
#include "cone_common.glsl"

// A coarser probe's seat this many of the probe's own cell sides off its
// surface weighs nothing; on it, its full weight. None weighs less than
// CONE_MERGE_PLANE_FLOOR of its own.
const float CONE_MERGE_PLANE = 1.0;
const float CONE_MERGE_PLANE_FLOOR = 0.001;

void main() {
    int c = int(pc.params.x);
    uint i = gl_GlobalInvocationID.x;
    if (i >= min(cwork.w[CONE_COUNTS + uint(c)], cone_cap(c))) {
        return;
    }
    uint r = cone_probe(c, i);
    int lod = int(cwork.w[r + 1u]);
    int face = cone_key_face(cwork.w[r]);
    ivec3 cell = ivec3(int(cwork.w[r + 4u]), int(cwork.w[r + 5u]), int(cwork.w[r + 6u]));
    vec3 centre = (vec3(cell) + CONE_HALF) * cone_spacing(lod, c);
    uint probes[8];
    float weights[8];
    // A probe the field had no seat for (a mover) reads its parent alone,
    // which it put there itself (cone_spread.comp); the trilinear read skips
    // unseated probes, and the mover's probes read no coarser cascade.
    bool unseated = (cwork.w[r + CONE_PROBE_SEATED] & CONE_FLAG_SEATED) == 0u;
    // A world probe too: its coarser probes are metres off, the test to
    // each walks all that way at the fine levels, and it comes one frame in
    // four. The pass ran as long as the few world probes' tests took: 2.3 ms
    // with them, 1.5 without.
    bool world = (cwork.w[r + CONE_PROBE_SEATED] & CONE_FLAG_WORLD) != 0u;
    if (c + 1 >= CONE_PARENT_ONLY || unseated || world) {
        // The parent, which this probe put there (cone_spread.comp).
        vec3 at = (vec3(cell) + CONE_HALF) * cone_spacing(lod, c);
        uint parent = cone_find(c + 1, cone_key(lod, ivec3(floor(at / cone_spacing(lod, c + 1))), c + 1, face));
        for (int k = 0; k < 8; k++) {
            cwork.w[r + 20u + uint(k)] = k == 0 ? parent : CONE_NO_BRICK;
        }
        cwork.w[r + 28u] = packHalf2x16(vec2(parent == CONE_NO_BRICK ? 0.0 : 1.0, 0.0));
        return;
    }
    cone_weights(c + 1, lod, face, centre, (pc.lamp.x & 1u) != 0u, cone_word3(r + 8u), CONE_NO_CELL, probes, weights);
    // Each by how near its seat lies to this probe's surface, along the
    // face's way: a coarser probe sits on the front surface of its cell,
    // and a floor's coarser probe beside a balustrade sat on a hanging
    // cloth's hem 34 cm up, in the cloth's shade; its cones were read as
    // the floor's, and the floor at the foot of each cloth had half the
    // bounce of the floor beside it (the path-traced reference has them
    // equal). The weights of all may fall: the merge divides by their sum.
    vec3 own = cone_word3(r + 8u);
    vec3 way = cone_axis(face);
    float reach = CONE_MERGE_PLANE * cone_spacing(lod, c);
    for (int k = 0; k < 8; k++) {
        if (probes[k] != CONE_NO_BRICK && probes[k] < cone_cap(c + 1)) {
            float off = abs(dot(cone_word3(cone_probe(c + 1, probes[k]) + 8u) - own, way));
            weights[k] *= max(1.0 - clamp(off / reach, 0.0, 1.0), CONE_MERGE_PLANE_FLOOR);
        }
    }
    for (int k = 0; k < 8; k++) {
        cwork.w[r + 20u + uint(k)] = probes[k];
    }
    for (int k = 0; k < 4; k++) {
        cwork.w[r + 28u + uint(k)] = packHalf2x16(vec2(weights[2 * k], weights[2 * k + 1]));
    }
}
