#version 450
// GI screen probes, pass 4: each probe's kept rays binned by direction into the
// cells of its pattern as it stands now (lighting_common.glsl "cells"): per cell the mean
// light and hit distance, which the spatial filter (lighting_filter.comp) compares
// across neighbours and turns into SH.
//
// A probe keeps the hits of its last LIGHTING_STRATA strata (lighting_common.glsl), and the
// light pass has shaded every one of them this frame, so the probe sees up to
// LIGHTING_STRATA x R rays with no light carried over from a past frame: a lamp that
// moves, dims or goes off shows in full on the next frame and never needs a reset.
// Only visibility is kept, and only while it still holds:
// - each kept stratum comes from whichever of last frame's probes in the 5 x 5
//   tiles around this place's old screen tile (reprojected through last frame's
//   camera) traced it nearest this place, on the same surface: facing the same
//   way (25 degrees), on its plane, within LIGHTING_REACH probe spacings along it. A
//   still probe takes its own; one that slid across its surface (the camera
//   moved) or was just uncovered (an object moved off it) takes its neighbours'.
//   Its hits are then seen from the probe's place (parallax), and a hit that
//   falls behind the probe is not used;
// - a kept ray whose path crosses the bounds of an object that moved, came or went
//   since the last frame was traced again this frame (lighting_trace.comp);
// - every kept stratum is dropped when the traced world changes as a whole;
// - a stratum no probe near this place traced (a surface the camera just turned
//   or walked onto) is traced from here this frame (a fill, lighting_fill_ray), so a
//   newly seen surface starts with all its rays, not one stratum: turning the
//   camera reveals a band of such surfaces at the leading edge every frame, and
//   with one stratum on the first frame, two on the next, the band was noisy and
//   its noise moved with the turn (gi-check's turn run).
// The picks (which probe each kept stratum comes from) are made in a first round
// before the trace, so it knows what to fill; the binning runs after the light.
// Each kept ray is binned by its own direction (from the probe's place) into the
// probe's direction cells, so strata traced with other turns (a moving probe's)
// land where they point. Each cell is the mean of the rays that land in it (this
// frame's ray always does), each weighted by 1 / cos to undo the cosine aim, so a cell's light is its
// mean over solid angle and a dropped ray thins a cell, never darkens it.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "lighting_common.glsl"

// Hit distance standing in for a miss (lighting_filter.comp's angle test).
const float LIGHTING_FAR = 1000.0;

// S78P: the binning round runs one workgroup a probe (a thread a ray k), the
// cell sums in shared memory instead of read-modify-writes to VRAM: each thread
// leaves its 8 strata's (cell, light*w, w*t) in shared memory, then thread c
// sums cell c and writes it once. Same sums (order aside), same outputs.
const bool LIGHTING_GATHER_SHARED = true;
shared uint g_cell[64 * 8];
shared vec4 g_val[64 * 8];
shared float g_t[64 * 8];
shared uint g_samples;

void gather_bin() {
    uint probe = gl_WorkGroupID.x;
    uint k = gl_LocalInvocationID.x;
    // The workgroup is 64 threads. A preset with fewer rays must not index
    // kept hits as if every probe still had 64, or the cells fill with
    // neighbouring probes' memory and the tiles go saturated.
    uint rays = lighting_rays();
    if (k == 0u) {
        g_samples = 0u;
    }
    vec4 pp = work.v[lighting_probe_at(probe)];
    vec3 n = work.v[lighting_probe_at(probe) + 1u].xyz;
    bool live = probe < lighting_probes() && pp.w > 0.5;
    uint samples = 0u;
    vec3 from = pp.xyz + n * 0.02;
    // S78Q held probe: its own strata only (no fills, no neighbour's), the same
    // place as at its last gather and no kept hit or light of it changed since
    // (lighting_gdirty): the inputs are the same, so its raw cells stand.
    if (LIGHTING_GATHER_HOLD && live) {
        vec4 gd = work.v[lighting_gdirty_at() + 2u * probe];
        vec4 gp = work.v[lighting_gdirty_at() + 2u * probe + 1u];
        if (k == 0u) {
            lighting_chg(CHG_G_RUN, 1u);
            lighting_chg(CHG_G_DIRTY, floatBitsToUint(gd.x) == lighting_frame() ? 1u : 0u);
            lighting_chg(CHG_G_MOVED, all(equal(floatBitsToUint(gp.xyz), floatBitsToUint(pp.xyz))) ? 0u : 1u);
            uint own = 0u;
            for (uint s = 0u; s < LIGHTING_STRATA; s++) { own += lighting_pick(probe, s) == probe + 1u ? 1u : 0u; }
            lighting_chg(CHG_G_PICKS, own == LIGHTING_STRATA ? 0u : 1u);
        }
        bool same = floatBitsToUint(gd.x) != lighting_frame() && all(equal(floatBitsToUint(gp.xyz), floatBitsToUint(pp.xyz)))
            && work.v[lighting_change_at()].y < 0.5;
        [[dont_unroll]] for (uint s = 0u; s < LIGHTING_STRATA && same; s++) {
            same = lighting_pick(probe, s) == probe + 1u;
        }
        if (same) {
            if (k == 0u) {
                lighting_chg(CHG_G_HELD, 1u);
                atomicAdd(gstats.pad0, floatBitsToUint(gd.y));
                atomicAdd(gstats.pad1, 1u);
            }
            return;
        }
    }
    [[dont_unroll]] for (uint s = 0u; s < LIGHTING_STRATA; s++) {
        uint e = k * LIGHTING_STRATA + s;
        g_cell[e] = ~0u;
        if (!live) {
            continue;
        }
        uint src = lighting_pick(probe, s);
        vec3 origin;
        vec3 dir;
        vec3 sn;
        bool fill = src == 0u;
        if (k >= rays) {
            continue;
        }
        uint h = ((fill ? probe : src - 1u) * LIGHTING_STRATA + s) * rays + k;
        if (fill && !lighting_fill_ray(probe, s, k, origin, dir, sn)) {
            continue;
        }
        vec4 rec = work.v[fill ? lighting_fill_at(h) : lighting_kept_at(h)];
        if (rec.x < 0.0 && rec.x > -0.75) {
            continue;
        }
        if (!fill) {
            lighting_stratum_ray(src - 1u, s, k, origin, dir, sn);
        }
        bool hit = rec.x >= 0.0;
        vec3 end = origin + dir * (hit ? rec.x : 200.0);
        vec3 d = hit ? end - from : dir;
        float len = length(d);
        if (len < 1.0e-4) {
            continue;
        }
        d /= len;
        uint cell = lighting_cell_of(pp.xyz, n, d);
        if (cell == ~0u) {
            continue;
        }
        float w = 1.0 / max(dot(d, n), 0.05);
        g_cell[e] = cell;
        g_val[e] = vec4((fill ? lighting_fill_light(h) : lighting_kept_light(h)) * w, w);
        g_t[e] = w * (hit ? len : LIGHTING_FAR);
        samples += fill ? 0u : 1u;
    }
    barrier();
    if (!live) {
        return;
    }
    atomicAdd(g_samples, samples);
    if (k < rays) {
        vec4 a = vec4(0.0);
        float t = 0.0;
        [[dont_unroll]] for (uint e = 0u; e < rays * LIGHTING_STRATA; e++) {
            if (g_cell[e] == k) {
                a += g_val[e];
                t += g_t[e];
            }
        }
        work.v[LIGHTING_GATHER_HOLD ? lighting_graw_at(probe, k) : lighting_cell_at(0u, probe, k)] = a.w > 0.0 ? vec4(a.rgb / a.w, t / a.w) : vec4(0.0, 0.0, 0.0, -1.0);
    }
    barrier();
    if (LIGHTING_GATHER_HOLD && k == 0u) {
        work.v[lighting_gdirty_at() + 2u * probe].y = uintBitsToFloat(g_samples);
        // S78Y: the raw cells were redone: the filter's round 0 reads them.
        work.v[lighting_gdirty_at() + 2u * probe].x = uintBitsToFloat(lighting_frame());
        work.v[lighting_gdirty_at() + 2u * probe + 1u].xyz = pp.xyz;
    }
    barrier();
    if (k == 0u) {
        atomicAdd(gstats.pad0, g_samples);
        atomicAdd(gstats.pad1, 1u);
    }
}

void main() {
    if (LIGHTING_GATHER_SHARED && ((pc.params.z >> 1u) & 1u) == 0u) {
        gather_bin();
        return;
    }
    uint probe = gl_GlobalInvocationID.x;
    if (probe >= lighting_probes()) {
        return;
    }
    vec4 pp = work.v[lighting_probe_at(probe)];
    vec3 n = work.v[lighting_probe_at(probe) + 1u].xyz;
    uint rays = lighting_rays();
    uint now = lighting_stratum();
    vec4 head = work.v[lighting_change_at()];
    bool drop_all = head.y > 0.5;
    uint last = uint(head.z) & 1u;
    uint next = 1u - last;
    uint src[LIGHTING_STRATA];
    [[dont_unroll]] for (uint s = 0u; s < LIGHTING_STRATA; s++) {
        src[s] = 0u;
    }
    // Round 1 (params.z bit 1, before the trace): the picks. Round 2 (after the
    // light pass): read them back and bin.
    bool pick = ((pc.params.z >> 1u) & 1u) != 0u;
    if (!pick) {
        [[dont_unroll]] for (uint s = 0u; s < LIGHTING_STRATA; s++) {
            src[s] = lighting_pick(probe, s);
        }
    }
    if (pick && pp.w > 0.5) {
        src[now] = probe + 1u;
        // Where this place stood on last frame's screen: its tile there.
        vec4 eye = work.v[lighting_change_at() + 1u];
        ivec2 t = ivec2(-1000);
        if (!drop_all && eye.w > 0.5) {
            vec4 right = work.v[lighting_change_at() + 2u];
            vec3 up = work.v[lighting_change_at() + 3u].xyz;
            vec4 fwd = work.v[lighting_change_at() + 4u];
            vec3 rel = pp.xyz - eye.xyz;
            float z = dot(rel, fwd.xyz);
            if (z > 1.0e-3) {
                vec2 ndc = vec2(dot(rel, right.xyz) / (z * right.w * fwd.w), dot(rel, up) / (z * right.w));
                vec2 px = vec2((ndc.x + 1.0) * 0.5 * float(pc.dims.x), (1.0 - ndc.y) * 0.5 * float(pc.dims.y));
                t = ivec2(floor(px / float(pc.params.y)));
            }
        }
        // Each kept stratum comes from whichever of last frame's probes around
        // that tile traced it nearest this place on the same surface: the probe's
        // own (it stays put while the camera does), a neighbour's when the probe
        // slid across its surface (the camera moved) or was just uncovered (an
        // object moved off it). Its hits are then seen from here (parallax).
        float dist = length(pp.xyz - scene.eye.xyz);
        float plane = 0.05 + 0.02 * dist;
        // A probe's spacing on its surface at its distance (the tile across the
        // view, stretched where the surface is seen at a slant).
        float facing = max(abs(dot(n, normalize(scene.eye.xyz - pp.xyz))), 0.2);
        float spacing = float(pc.params.y) * 2.0 * scene.view_right.w * dist / float(pc.dims.y) / facing;
        float reach = LIGHTING_REACH * spacing + 0.02;
        // The changes this frame (params.z bit 3): a kept stratum traced from inside
        // the bounds of an object that moved, came or went (a probe on a moving box,
        // or right by it) is not picked, so the probe traces it again from where it
        // stands (a fill). Its old origin sits where the surface was, or inside the
        // box now, and its re-trace (lighting_kept_crossed) would shade from there.
        vec4 chead = work.v[lighting_change_at()];
        uint changes = ((pc.params.z >> 3u) & 1u) != 0u ? min(uint(chead.x), LIGHTING_CHANGES) : 0u;
        float best[LIGHTING_STRATA];
        [[dont_unroll]] for (uint s = 0u; s < LIGHTING_STRATA; s++) {
            best[s] = 1.0e9;
        }
        [[dont_unroll]] for (int dy = -2; dy <= 2; dy++) {
            [[dont_unroll]] for (int dx = -2; dx <= 2; dx++) {
                ivec2 q = t + ivec2(dx, dy);
                if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, ivec2(pc.dims.zw)))) {
                    continue;
                }
                uint from_probe = uint(q.y) * pc.dims.z + uint(q.x);
                uvec4 v0 = floatBitsToUint(work.v[lighting_view_at(last, from_probe)]);
                uvec4 v1 = floatBitsToUint(work.v[lighting_view_at(last, from_probe) + 1u]);
                uint was[8] = uint[8](v0.x, v0.y, v0.z, v0.w, v1.x, v1.y, v1.z, v1.w);
                [[dont_unroll]] for (uint s = 0u; s < LIGHTING_STRATA; s++) {
                    if (s == now || was[s] == 0u) {
                        continue;
                    }
                    vec4 sp = work.v[lighting_stratum_at(was[s] - 1u, s)];
                    vec3 sn = work.v[lighting_stratum_at(was[s] - 1u, s) + 1u].xyz;
                    vec3 d = pp.xyz - sp.xyz;
                    float off = abs(dot(d, n));
                    float side = length(d - n * dot(d, n));
                    float score = side + 4.0 * off;
                    bool moved = false;
                    [[dont_unroll]] for (uint c = 0u; c < changes && !moved; c++) {
                        vec4 b = work.v[lighting_change_at() + LIGHTING_CHANGE_HEAD + c];
                        vec3 db = sp.xyz - b.xyz;
                        moved = dot(db, db) < b.w * b.w;
                    }
                    if (!moved && sp.w > 0.5 && dot(sn, n) > 0.9 && off < plane && side < reach && score < best[s]) {
                        best[s] = score;
                        src[s] = was[s];
                    }
                }
            }
        }
    }
    if (pick) {
        work.v[lighting_view_at(next, probe)] = uintBitsToFloat(uvec4(src[0], src[1], src[2], src[3]));
        work.v[lighting_view_at(next, probe) + 1u] = uintBitsToFloat(uvec4(src[4], src[5], src[6], src[7]));
        return;
    }
    if (pp.w > 0.5) {
        vec3 from = pp.xyz + n * 0.02;
        [[dont_unroll]] for (uint k = 0u; k < rays; k++) {
            work.v[lighting_cell_at(0u, probe, k)] = vec4(0.0);
            work.v[lighting_cell_at(1u, probe, k)] = vec4(0.0);
        }
        uint samples = 0u;
        [[dont_unroll]] for (uint k = 0u; k < rays; k++) {
            [[dont_unroll]] for (uint s = 0u; s < LIGHTING_STRATA; s++) {
                vec3 origin;
                vec3 dir;
                vec3 sn;
                bool fill = src[s] == 0u;
                uint h = ((fill ? probe : src[s] - 1u) * LIGHTING_STRATA + s) * rays + k;
                if (fill && !lighting_fill_ray(probe, s, k, origin, dir, sn)) {
                    continue;
                }
                vec4 rec = work.v[fill ? lighting_fill_at(h) : lighting_kept_at(h)];
                if (rec.x < 0.0 && rec.x > -0.75) {
                    continue;
                }
                if (!fill) {
                    lighting_stratum_ray(src[s] - 1u, s, k, origin, dir, sn);
                }
                bool hit = rec.x >= 0.0;
                vec3 end = origin + dir * (hit ? rec.x : 200.0);
                // Seen from where the probe stands now: a hit point from its new
                // place, a miss (at infinity) along its own direction.
                vec3 d = hit ? end - from : dir;
                float len = length(d);
                if (len < 1.0e-4) {
                    continue;
                }
                d /= len;
                uint cell = lighting_cell_of(pp.xyz, n, d);
                if (cell == ~0u) {
                    continue;
                }
                float w = 1.0 / max(dot(d, n), 0.05);
                work.v[lighting_cell_at(0u, probe, cell)] += vec4((fill ? lighting_fill_light(h) : lighting_kept_light(h)) * w, w);
                work.v[lighting_cell_at(1u, probe, cell)].x += w * (hit ? len : LIGHTING_FAR);
                // Kept rays only: the counter tells what reprojection held (lighting_frame tests).
                samples += fill ? 0u : 1u;
            }
        }
        [[dont_unroll]] for (uint k = 0u; k < rays; k++) {
            vec4 a = work.v[lighting_cell_at(0u, probe, k)];
            float t = work.v[lighting_cell_at(1u, probe, k)].x;
            work.v[lighting_cell_at(0u, probe, k)] = a.w > 0.0 ? vec4(a.rgb / a.w, t / a.w) : vec4(0.0, 0.0, 0.0, -1.0);
        }
        atomicAdd(gstats.pad0, samples);
        atomicAdd(gstats.pad1, 1u);
    }
}
