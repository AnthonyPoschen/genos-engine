#version 450
// GI v2 screen probes, pass 1: place one probe per tile on the G-buffer surface at
// the tile's centre, or the first of four inner points that shows a surface. The
// probe's place also opens this frame's stratum of its kept hits (lighting_common.glsl).
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "lighting_common.glsl"

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= lighting_probes()) {
        return;
    }
    uint tile = pc.params.y;
    uvec2 origin = uvec2(i % pc.dims.z, i / pc.dims.z) * tile;
    vec4 pos_out = vec4(0.0);
    vec4 n_out = vec4(0.0, 1.0, 0.0, 0.0);
    [[dont_unroll]] for (uint k = 0u; k < 5u; k++) {
        // World cells on (GENOS_LIGHTING_WORLD=2, lighting_cache.glsl): the first point
        // moves round the tile frame by frame (R2 sequence), so the world cells
        // average the probes over every place in the tile, still or moving, and
        // what a cell holds does not depend on where the grid fell.
        uvec2 first = uvec2(tile / 2u);
        if (lighting_world_mode() == 2u) {
            vec2 j = fract(vec2(0.5) + float(lighting_frame() % 4096u) * vec2(0.7548777, 0.5698403));
            first = min(uvec2(j * float(tile)), uvec2(tile - 1u));
        }
        uvec2 off = k == 0u ? first
            : uvec2((k & 1u) == 1u ? tile / 4u : 3u * tile / 4u, k < 3u ? tile / 4u : 3u * tile / 4u);
        uvec2 p = min(origin + off, uvec2(pc.dims.x - 1u, pc.dims.y - 1u));
        vec3 pos;
        vec3 n;
        vec3 albedo;
        bool two_sided;
        if (lighting_surface(p, pos, n, albedo, two_sided)) {
            // A two-sided card's probe faces the eye.
            if (two_sided && dot(n, scene.eye.xyz - pos) < 0.0) {
                n = -n;
            }
            pos_out = vec4(pos, 1.0);
            n_out = vec4(n, 0.0);
            break;
        }
    }
    // S78K: standing where this stratum was last traced (1 mm, same normal),
    // and not marked by a failed check: the stratum is held (w = 2).
    vec4 was = work.v[lighting_stratum_at(i, lighting_stratum())];
    vec3 wn = work.v[lighting_stratum_at(i, lighting_stratum()) + 1u].xyz;
    float until = work.v[lighting_probe_at(i) + 1u].w;
    n_out.w = until;
    if (LIGHTING_HOLD_STRATA && pos_out.w > 0.5 && was.w > 0.5 && length(was.xyz - pos_out.xyz) < 1.0e-3 && dot(wn, n_out.xyz) > 0.9999
        && !(until > 0.0 && floatBitsToUint(until) > lighting_frame())) {
        pos_out.w = 2.0;
    }
    work.v[lighting_probe_at(i)] = vec4(pos_out.xyz, min(pos_out.w, 1.0));
    work.v[lighting_probe_at(i) + 1u] = n_out;
    work.v[lighting_stratum_at(i, lighting_stratum())] = pos_out;
    work.v[lighting_stratum_at(i, lighting_stratum()) + 1u] = n_out;
}
