#version 450
// GI light cache, last ray pass: each patch relit this frame sums its rays'
// light into irradiance (uniform hemisphere: 2 pi / C times the cosine-weighted
// sum). A patch nobody has read for LIGHTING_CACHE_LIFE frames is freed. No trace.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "lighting_common.glsl"

// S78S: a texel's value write, counted by its change (lighting_chg).
void lighting_tex_put(uint slot, vec4 v) {
    if ((lighting_toggles() & LIGHTING_TOGGLE_FREEZE_CACHE) != 0u) {
        return;
    }
    if (gstats.chg[31] != 0u) {
        vec4 o = cache.v[3u * slot + 2u];
        lighting_chg(CHG_TEX_WRITE, 1u);
        lighting_chg(CHG_TEX_D0 + lighting_chg_bin(o.rgb, v.rgb), 1u);
    }
    cache.v[3u * slot + 2u] = v;
}
void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= LIGHTING_CACHE_BATCH) {
        return;
    }
    // S70A: dense (indirect) dispatch over the live entries only.
    uint j = gid;
    if (lighting_dense()) {
        j = gid < lighting_dense_count() ? lighting_dense_entry(gid) : LIGHTING_CACHE_BATCH;
    }
    if (gid == 0u) {
        gstats.live = lighting_live_count();
        // Scheduler: the next round lists the buckets from the top down until
        // they fill what the young leave of the batch; the histogram restarts.
        if (lighting_world_mode() == 3u && LIGHTING_SC_SCHED) {
            lighting_wrc_note_lamps();
            if (lighting_wrc_scout_due()) {
                atomicAdd(gstats.scouts, LIGHTING_WRC_SCOUT_ENTRIES * LIGHTING_CACHE_RAYS);
            }
            lighting_ls_note();
            uint room = lighting_sc_room() >> lighting_sc_budget_shift();
            uint base = lighting_sc_base_room() >> lighting_sc_budget_shift();
            uint young = min(lighting_young_count(), base);
            uint total = 0u;
            for (uint b = 0u; b < LIGHTING_SC_BUCKETS; b++) {
                total += ckeys.key[LIGHTING_SC_HIST_AT + b];
            }
            uint c = total > base - young ? min(ckeys.key[LIGHTING_SC_BOOST_AT] + 1u, 100000u) : 0u;
            ckeys.key[LIGHTING_SC_BOOST_AT] = c;
            bool boost = c > 0u && c <= LIGHTING_SC_BOOST_ROUNDS;
            gstats.pad3 = boost ? 1u : 0u;
            uint budget = (boost ? room : base) - young;
            uint acc = 0u;
            uint thr = 0u;
            for (int b = int(LIGHTING_SC_BUCKETS) - 1; b >= 0; b--) {
                acc += ckeys.key[LIGHTING_SC_HIST_AT + uint(b)];
                ckeys.key[LIGHTING_SC_HIST_AT + uint(b)] = 0u;
                if (acc >= budget && thr == 0u) {
                    thr = uint(b);
                }
            }
            ckeys.key[LIGHTING_SC_THR_AT] = thr;
            gstats.sched_thr = thr;
        }
    }
    if (j >= LIGHTING_CACHE_BATCH) {
        return;
    }
    if (lighting_world_mode() == 3u && j >= lighting_grad_first() && j < LIGHTING_CACHE_BATCH - LIGHTING_WRC_SCOUT_ENTRIES) {
        // S74A: 16 gradient checks, one ray each.
        uint n = lighting_grad_count();
        [[dont_unroll]] for (uint i = 0u; i < LIGHTING_CACHE_RAYS; i++) {
            uint ci = (j - lighting_grad_first()) * LIGHTING_CACHE_RAYS + i;
            if (ci >= n) {
                break;
            }
            uint gs = ckeys.key[LIGHTING_GRAD_LIST_AT + ci];
            vec4 v = work.v[lighting_rad_at(lighting_probe_rays() + ci + lighting_grad_first() * LIGHTING_CACHE_RAYS)];
            if (ckeys.key[gs] == 0u || lighting_ray_none(v)) {
                continue;
            }
            lighting_sc_grad_take(gs, dot(lighting_ray_light(v), vec3(0.2126, 0.7152, 0.0722)));
        }
        return;
    }
    uint slot = lighting_cache_batch_slot(j);
    if (slot == ~0u) {
        return;
    }
    // A texel's entries this round are consecutive; the first sums them all.
    if (j > 0u && lighting_cache_batch_slot(j - 1u) == slot) {
        return;
    }
    uint run = 1u;
    while (run < LIGHTING_SC_QUARTERS && j + run < LIGHTING_CACHE_BATCH && lighting_cache_batch_slot(j + run) == slot) {
        run++;
    }
    uint key = ckeys.key[slot];
    if (key == 0u) {
        return;
    }
    atomicAdd(gstats.rays, run * LIGHTING_CACHE_RAYS);
    uint last = floatBitsToUint(cache.v[3u * slot].w);
    uint shown = floatBitsToUint(cache.v[LIGHTING_WORLD_AT + slot].z);
    // Signed: on the async queue a frame drawn after this round was built may
    // already have read the patch (last ahead of this round's frame).
    // A held camera stops compose from restamping last-read; an on-screen texel
    // stays (lighting_sc_expired).
    if (lighting_sc_expired(last, shown)) {
        atomicAdd(gstats.freed, 1u);
        ckeys.key[slot] = 0u;
        cache.v[3u * slot + 1u] = vec4(0.0);
        cache.v[3u * slot + 2u] = vec4(0.0);
        return;
    }
    vec3 tp;
    vec3 n;
    lighting_sc_texel_world(slot, tp, n);
    uint rkey = lighting_sc_ray_key(slot, key);
    uint q0 = lighting_sc_quarter0(slot);
    bool wrc_cell = lighting_world_mode() == 3u && cache.v[3u * slot + 1u].w > 0.2;
    uint prev_updated = lighting_sc_updated(slot);
    lighting_sc_upd_override = prev_updated;
    uint first = lighting_probe_rays() + j * LIGHTING_CACHE_RAYS;
    vec3 e = vec3(0.0);
    float es = 0.0;
    float el = 0.0;
    [[dont_unroll]] for (uint k = 0u; k < run * LIGHTING_CACHE_RAYS; k++) {
        vec4 v = work.v[lighting_rad_at(first + k)];
        if (lighting_ray_none(v)) {
            return;
        }
        vec3 dir = lighting_dir(rkey, n, lighting_sc_stratum(rkey, q0 * LIGHTING_CACHE_RAYS + k, LIGHTING_CACHE_RAYS, LIGHTING_SC_SET_RAYS), LIGHTING_SC_SET_RAYS);
        float c = max(dot(dir, n), 0.0);
        vec3 lk = lighting_ray_light(v);
        // S74A: the ray a later gradient check re-traces (same seed): one of
        // the last quarter's, turning with the rounds.
        if (LIGHTING_SC_ASVGF && !wrc_cell && lighting_world_mode() == 3u && k == (run - 1u) * LIGHTING_CACHE_RAYS + lighting_round() % LIGHTING_CACHE_RAYS) {
            uint qk = (q0 + run - 1u) * LIGHTING_CACHE_RAYS + lighting_round() % LIGHTING_CACHE_RAYS;
            cache.v[LIGHTING_SC_GRAD_AT + slot].yzw = vec3(dot(lk, vec3(0.2126, 0.7152, 0.0722)), uintBitsToFloat(rkey), uintBitsToFloat(qk));
        }
        e += lk * c;
        el += dot(lk, vec3(0.2126, 0.7152, 0.0722)) * c;
        es += min(max(v.w, 0.0), dot(lk, vec3(0.2126, 0.7152, 0.0722))) * c;
    }
    float rays = float(run * LIGHTING_CACHE_RAYS);
    if (run > 1u) {
        atomicAdd(gstats.extra, 1u);
    }
    if (lighting_world_mode() == 3u) {
        cache.v[LIGHTING_SC_OBJ_AT + slot].y = uintBitsToFloat(lighting_frame());
        // Few rays a relight: the set's quarters add up; the mean takes the set
        // once its last quarter is in.
        if (LIGHTING_SC_QUARTERS > 1u && !wrc_cell) {
            uint q = q0 + run;
            if (q0 > 0u) {
                e += lighting_unpack_rgb9e5(floatBitsToUint(cache.v[LIGHTING_SC_OBJ_AT + slot].z));
                // S64B: and their sun/sky share (SUN_AT .z share, .w all, luminance).
                es += cache.v[LIGHTING_SC_SUN_AT + slot].z;
                el += cache.v[LIGHTING_SC_SUN_AT + slot].w;
            }
            if (q < LIGHTING_SC_QUARTERS) {
                cache.v[LIGHTING_SC_OBJ_AT + slot].z = uintBitsToFloat(lighting_pack_rgb9e5(e));
                cache.v[LIGHTING_SC_OBJ_AT + slot].w = uintBitsToFloat(q);
                cache.v[LIGHTING_SC_SUN_AT + slot].zw = vec2(es, el);
                atomicAdd(gstats.partial, 1u);
                return;
            }
            cache.v[LIGHTING_SC_OBJ_AT + slot].zw = vec2(0.0);
            cache.v[LIGHTING_SC_SUN_AT + slot].zw = vec2(0.0);
            atomicAdd(gstats.sets, 1u);
            rays = float(LIGHTING_SC_SET_RAYS);
        }
    }
    e *= LIGHTING_TAU / rays;
    vec4 old = cache.v[3u * slot + 2u];
    if (lighting_world_mode() == 3u) {
        // S63A: carry the history's sun/sky share to the sun and sky of now,
        // then blend this set's share into it.
        float fe = el > 1.0e-6 ? clamp(es / el, 0.0, 1.0) : 0.0;
        float fnew = fe;
        float ls = 1.0;
        if (old.w > 0.5) {
            ls = lighting_sc_sun_gain(slot);
            float fo = lighting_sc_sunfrac_now(slot);
            fnew = mix(fo, fe, max(1.0 / (floor(old.w) + 1.0), 1.0 / 16.0));
        }
        float now = lighting_ls_now();
        cache.v[LIGHTING_SC_SUN_AT + slot] = vec4(fnew, now < 0.0 ? cache.v[LIGHTING_SC_SUN_AT + slot].y : now, 0.0, 0.0);
        if (old.w > 0.5 && abs(ls - 1.0) > 1.0e-3) {
            old.rgb *= ls;
            cache.v[3u * slot + 2u].rgb = old.rgb;
            vec4 ea = cache.v[LIGHTING_SC_EST_AT + 2u * slot];
            cache.v[LIGHTING_SC_EST_AT + 2u * slot] = vec4(ea.rgb * ls, ea.w * ls * ls);
            vec3 pl = lighting_unpack_rgb9e5(floatBitsToUint(cache.v[LIGHTING_WORLD_AT + slot].y));
            cache.v[LIGHTING_WORLD_AT + slot].y = uintBitsToFloat(lighting_pack_rgb9e5(pl * ls));
        }
    }
    float lo = dot(old.rgb, vec3(0.2126, 0.7152, 0.0722));
    float ln = dot(e, vec3(0.2126, 0.7152, 0.0722));
    float change = old.w < 0.5 ? 1.0 : abs(ln - lo) / (max(lo, ln) + 0.05);
    uint millionths = uint(clamp(change, 0.0, 1.0) * 1.0e6);
    atomicMax(gstats.max_change, millionths);
    atomicAdd(gstats.relit, 1u);
    if (old.w > LIGHTING_CACHE_MATURE - 0.5) {
        atomicMax(gstats.mature_change, millionths);
        atomicAdd(gstats.mature_relit, 1u);
    }
    // Flag 131072: hit patches (25 cm and up) take each relight whole, as the
    // light cache of the other modes does (no running mean of sets).
    if (lighting_world_mode() == 3u && cache.v[3u * slot + 1u].w > 0.2) {
        // World space radiance cache (S61A): a running mean to LIGHTING_WRC_CAP sets,
        // change-aware through lighting_sc_count (short near a change, the light
        // window while the light changes); later sets weigh more (as the texels).
        // S61B: each entry is one 16-ray sample; a mover nearby or a lamp
        // that reaches it moved since its last relight drops the history to
        // LIGHTING_WRC_CHANGE_KEEP samples (S62D: no longer; an EMA floor instead).
        float t = old.w < 0.5 ? 0.0 : lighting_sc_count(slot);
        bool urgent3 = ((pc.params.z >> 5u) & 1u) != 0u;
        vec3 cp = lighting_sc_texel_pos(slot);
        // S62D (Anthony): no history drop under a change; an exponential
        // average with a responsive floor tracks it (local change faster).
        bool local3 = (urgent3 && lighting_near_change(cp)) || lighting_wrc_lamp_changed(cp, prev_updated);
        float add = float(run);
        float wa = add / (t + add);
        // S72N dark fill (Anthony: dark occluded rooms fill disproportionately
        // slowly): while a cell grows, sample k weighs k^2 (later samples read a
        // cache that has taken more bounces; a plain mean kept the first, dark
        // ones at 1 / n, and every bounce through these cells lagged again), so
        // the new samples' share is 1 - (t / (t + add))^3. Plain past half the cap.
        if (lighting_sc_dark_fill() && t < 0.5 * LIGHTING_WRC_CAP) {
            wa = 1.0 - pow(t / (t + add), 3.0);
        }
        if (local3) {
            wa = max(wa, LIGHTING_WRC_LOCAL_ALPHA * add);
        } else if (!lighting_sc_light_quiet()) {
            wa = max(wa, LIGHTING_WRC_CHANGE_ALPHA * add);
        }
        // While a lamp change settles, each round's sets carry the change one
        // bounce further and the old light leaves one bounce per round
        // (lighting_lamp_settling): a cell takes the round's set whole. An
        // average with the sets before keeps the old light at its weight, a
        // gain near 1 per round where the light has gone.
        if (lighting_lamp_settling()) {
            wa = 1.0;
        }
        vec3 mean = old.w < 0.5 ? e : old.rgb + (e - old.rgb) * min(wa, 1.0);
        lighting_tex_put(slot, vec4(mean, min(t + add, LIGHTING_WRC_CAP)));
        // S76B: a refresh is the cell's check (lighting_wrc_check_take).
        if (old.w >= 0.5) {
            lighting_wrc_check_take(slot, e, old.rgb);
        }
        return;
    }
    if (lighting_world_mode() == 3u) {
        // Surface cache: the running mean of the sets so far (a short one under
        // change); w counts them, held at the cap once there.
        float t = old.w < 0.5 ? 0.0 : lighting_sc_count(slot);
        // Set k weighs k^2 (later sets read a cache that has converged further, so
        // the first sets' darker second bounce fades as (k / n)^3, not k / n; the
        // noise is that of 0.56 n sets).
        float k = t + 1.0;
        float w = (lighting_sc_flags() & 1u) != 0u ? 6.0 * k / ((k + 1.0) * (2.0 * k + 1.0)) : 2.0 / (k + 1.0);
        float cap = lighting_sc_cap(slot);
        if (t >= cap - 0.5) {
            atomicAdd(gstats.atcap, 1u);
        }
        // Flag 1048576: GIBS's estimator (Stachowiak's multi-scale mean, as in
        // kajiya): a short-term mean and variance beside the long-term mean; the
        // long-term blend grows with how far the short-term mean has moved from it
        // in standard deviations and falls to 1/256 once they agree, so a converged
        // texel neither drifts nor freezes. The first LIGHTING_SC_EST_WARM sets are a
        // plain mean (as before); under change lighting_sc_count keeps t short.
        if ((lighting_sc_flags() & 1048576u) != 0u && old.w > 0.5) {
            const vec3 lw = vec3(0.2126, 0.7152, 0.0722);
            const float SB = 0.08;
            const float WARM = 16.0;
            vec4 a = cache.v[LIGHTING_SC_EST_AT + 2u * slot];
            vec4 b = cache.v[LIGHTING_SC_EST_AT + 2u * slot + 1u];
            bool urgent2 = ((pc.params.z >> 5u) & 1u) != 0u;
            bool mover2;
            bool stale2 = lighting_sc_local_change(slot, mover2);
            if (lighting_sc_msme()) {
                // Barré-Brisebois et al., Ray Tracing Gems ch. 25,
                // MultiscaleMeanEstimator.hlsl (one update per set, y the set):
                // https://github.com/Apress/ray-tracing-gems/blob/master/Ch_25_Hybrid_Rendering_for_Real-Time_Ray_Tracing/MultiscaleMeanEstimator.hlsl
                // short mean 0.08, variance 0.04, inconsistency 0.08,
                // catchUp = clamp(smoothstep(rho * max(0.02, iota - 0.2)), 1/256, 1) * vbbr,
                // vbbr -> clamp(dot(w, 0.5 * short / dev), 1/32, 1) at 0.1.
                // Fireflies: y -= max(0, y - (0.1 + short + sigma * dev)).
                // sigma is lighting_sc_firefly_sigma() (the listing's 8). The
                // clamp is biased. The 0.1 floor stays when sigma is 0.
                // Deviations from that listing, kept on purpose:
                // variance is one luminance scalar, not float3 (SVGF reads .w).
                // The weights are the listing's Rec. 601 (0.299, 0.587, 0.114).
                // The hold path below uses Rec. 709 (0.2126, 0.7152, 0.0722)
                // and its own clamp of 8; it does not read
                // surface_cache.firefly_sigma. A newborn starts at short = mean,
                // inconsistency 1, vbbr 1, variance (0.15 * luma)^2 (S72T; the
                // listing has no init, and variance 0 makes catch-up 1); while
                // t < 16, k is at most 1/(t+1); a mover raises k to at least
                // 0.5 and a lamp delta is capped at 0.9; A-SVGF mixes lambda
                // when that path is on.
                const vec3 msmel = vec3(0.299, 0.587, 0.114);
                if (b.x <= 0.0) {
                    a = vec4(old.rgb, pow(0.15 * dot(old.rgb, msmel), 2.0) + 1.0e-8);
                    b = vec4(1.0, 1.0, 0.0, t);
                }
                float dev0 = sqrt(max(1.0e-5, a.w));
                float sigma = lighting_sc_firefly_sigma();
                vec3 y = e - max(e - (0.1 + a.rgb + sigma * dev0), vec3(0.0));
                vec3 d1 = y - a.rgb;
                vec3 sm = mix(a.rgb, y, 0.08);
                vec3 d2 = y - sm;
                float var = mix(a.w, dot(d1 * d2, msmel), 0.04);
                float dev = sqrt(max(1.0e-5, var));
                float rho = dot(abs(old.rgb - sm), msmel) / max(1.0e-5, dev);
                float inc = mix(b.y, rho, 0.08);
                float k = clamp(smoothstep(0.0, 1.0, rho * max(0.02, inc - 0.2)), 1.0 / 256.0, 1.0) * b.x;
                float vb = mix(b.x, clamp(dot(msmel, 0.5 * sm / vec3(max(1.0e-5, dev))), 1.0 / 32.0, 1.0), 0.1);
                float hint = mover2 ? 0.5 : 0.0;
                hint = max(hint, LIGHTING_SC_LAMP_K * lighting_sc_lamp_change(slot));
                // Settling (as the cells above): the round's set whole.
                if (lighting_lamp_settling()) {
                    hint = 1.0;
                }
                // S72T: while young (under 16 sets) never faster than the plain
                // mean 1 / (n + 1), the least-noise estimate of a still signal
                // (the hint still overrides it).
                if (t < 16.0) {
                    k = min(k, 1.0 / (t + 1.0));
                }
                if (LIGHTING_SC_ASVGF) {
                    // S74A: alpha' = (1 - lambda) alpha + lambda (A-SVGF); the
                    // hints only nominate checks (lighting_compact.comp).
                    float lam = lighting_sc_lambda(slot);
                    k = (1.0 - lam) * k + lam;
                } else {
                    k = max(k, hint >= 1.0 ? 1.0 : min(hint, 0.9));
                }
                vec3 m = mix(old.rgb, y, clamp(k, 0.0, 1.0));
                cache.v[LIGHTING_SC_EST_AT + 2u * slot] = vec4(sm, var);
                cache.v[LIGHTING_SC_EST_AT + 2u * slot + 1u] = vec4(vb, inc, k, min(t + 1.0, 256.0));
                lighting_tex_put(slot, vec4(m, min(t + 1.0, cap)));
                return;
            }
            if (stale2) {
                // Light changing or a change nearby: a short plain mean (t is kept
                // short by lighting_sc_count) and the estimator starts again once quiet.
                vec3 m0 = old.rgb + (e - old.rgb) / (t + 1.0);
                cache.v[LIGHTING_SC_EST_AT + 2u * slot + 1u] = vec4(0.0);
                lighting_tex_put(slot, vec4(m0, min(t + 1.0, cap) + 0.25));
                return;
            }
            // First quiet relight after the light changed: the sets taken while it
            // changed describe light that is gone; start again from this set
            // (A-SVGF / ReLAX: history dropped where the signal changed).
            if (fract(old.w) > 0.1) {
                cache.v[LIGHTING_SC_EST_AT + 2u * slot] = vec4(e, pow(0.15 * dot(e, lw), 2.0) + 1.0e-8);
                cache.v[LIGHTING_SC_EST_AT + 2u * slot + 1u] = vec4(1.0, 1.0, 1.0, 1.0);
                lighting_tex_put(slot, vec4(e, 1.0));
                return;
            }
            if (b.x <= 0.0) {
                // First estimator step (new, or resampled from another size).
                a = vec4(old.rgb, pow(0.15 * dot(old.rgb, lw), 2.0) + 1.0e-8);
                b = vec4(1.0, 1.0, 0.0, t);
            }
            float early = 1.0 / (t + 1.0);
            vec3 y = e;
            float dev0 = sqrt(max(a.w, 1.0e-10));
            y -= max(y - (a.rgb + 0.05 + 8.0 * dev0), vec3(0.0));
            vec3 d1 = y - a.rgb;
            vec3 sm = mix(a.rgb, y, max(SB, early));
            vec3 d2 = y - sm;
            float var = mix(a.w, max(dot(d1 * d2, lw), 0.0), max(0.5 * SB, early));
            float dev = sqrt(max(var, 1.0e-10));
            float rel = dot(abs(old.rgb - sm), lw) / dev;
            float inc = mix(b.y, rel, SB);
            float vbr = clamp(0.5 * dot(sm, lw) / dev, 1.0 / 32.0, 1.0);
            float catchup = clamp(smoothstep(0.0, 1.0, rel * max(0.02, inc - 0.2)), 1.0 / 256.0, 1.0) * b.x;
            float vb = mix(b.x, vbr, 0.1);
            // Sets the long-term mean holds (b.w): a plain mean 1 / (n + 1) to 256
            // sets, never slower; the estimator only speeds it up when the short
            // mean has moved away (a change), and n drops to match.
            float n = max(b.w, t);
            float blend = t < WARM ? early : max(1.0 / (n + 1.0), catchup);
            if (!lighting_sc_light_quiet()) {
                blend = max(blend, LIGHTING_SC_CHANGE_ALPHA);
            }
            // S68D: a young texel's first sets are dark (the bounce light around
            // a reveal builds up over rounds, hits read cells not lit yet); a
            // plain mean keeps that darkness as 1 / n (turn: -4 % at frame 16,
            // -1.8 % at 60). Until LIGHTING_SC_YOUNG_SETS, an EMA floor forgets it.
            if (t >= WARM && t < LIGHTING_SC_YOUNG_SETS) {
                blend = max(blend, LIGHTING_SC_YOUNG_ALPHA);
            }
            if (t >= WARM) {
                float ri = abs(dot(y - old.rgb, lw)) / max(dev0, 0.02 * dot(old.rgb, lw) + 1.0e-4);
                blend = max(blend, clamp((ri - LIGHTING_SC_ANTILAG_SD) / (3.0 * LIGHTING_SC_ANTILAG_SD), 0.0, 1.0));
            }
            n = min(n + 1.0, min(1.0 / blend, 256.0));
            vec3 m = old.rgb + (y - old.rgb) * blend;
            if (LIGHTING_SC_NCLAMP && !lighting_sc_light_quiet() && t >= WARM) {
                m = lighting_sc_nclamp(slot, m, sm, dev);
            }
            cache.v[LIGHTING_SC_EST_AT + 2u * slot] = vec4(sm, var);
            cache.v[LIGHTING_SC_EST_AT + 2u * slot + 1u] = vec4(vb, inc, blend, n);
            lighting_tex_put(slot, vec4(m, min(t + 1.0, cap)));
            return;
        }
        // Flag 262144 (with 8192): past the cap a texel keeps a plain mean of its
        // later sets (weight 1 / (k + 1)) up to LIGHTING_SC_HOLD caps, then holds: its
        // shimmer fades as 1 / k and stops, the bounce that came in late is kept.
        bool hold = (lighting_sc_flags() & (8192u | 262144u)) == (8192u | 262144u);
        if (hold && t >= cap - 0.5) {
            w = 1.0 / (k + 1.0);
        }
        vec3 mean = old.w < 0.5 ? e : old.rgb + (e - old.rgb) * w;
        float next = min(t + 1.0, hold ? LIGHTING_SC_HOLD * cap : cap);
        // Second pass: the first time a texel reaches the cap its sets drop to a
        // quarter (value kept), so the sets taken while the cache around it was
        // still dark weigh less (world slot w marks the pass done).
        if ((lighting_sc_flags() & 2u) != 0u && next >= cap && cache.v[LIGHTING_WORLD_AT + slot].w < 0.5) {
            cache.v[LIGHTING_WORLD_AT + slot].w = 1.0;
            next = max(floor(cap * 0.25), 1.0);
        }
        // Lit under changing light or inside a change: stale (w + 0.25) until a
        // relight with everything still; pixels show the probes over it.
        bool urgent = ((pc.params.z >> 5u) & 1u) != 0u;
        bool mover3;
        bool stale = lighting_sc_local_change(slot, mover3);
        lighting_tex_put(slot, vec4(mean, next + (stale ? 0.25 : 0.0)));
        return;
    }
    lighting_tex_put(slot, vec4(e, min(max(old.w, 0.0) + 1.0, LIGHTING_CACHE_MATURE)));
}
