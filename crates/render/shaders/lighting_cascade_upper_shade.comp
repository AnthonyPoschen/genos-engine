#version 450
// Shade this band's due upper cells, uniform and lamp-cone rays weighted by
// the solid angle each stands for. Every ray is shaded: a hit is exact
// lamp light plus the bounce stored at the hit, a miss is the parent's
// bins. The cosine-weighted sum of all rays is the cell's irradiance, and
// each bin is the mean radiance of its rays. A refresh moves both part of
// the way (see CASCADE_UPPER_RATE). A non-finite estimate is refused. This compile's only trace
// site is trace_occluded.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "lighting_common.glsl"
#include "lighting_cascade.glsl"

shared vec3 sh_bins[16];
shared bool sh_ok;
shared vec3 sh_sum[64];
shared vec3 sh_rad[64];
shared float sh_w[64];
// The part of a ray's radiance that is lamp light leaving the surface it hit.
shared vec3 sh_lamp[64];
shared uint sh_bin[64];

bool lighting_cascade_hit_is_lamp(vec3 hp) {
    LampList list = lamps_at(hp);
    uint count = lamp_list_size(list);
    float r2 = LAMP_RADIUS * LAMP_RADIUS;
    [[dont_unroll]] for (uint k = 0u; k < count; k++) {
        Lamp lamp = lamp_list_get(list, k);
        if (lamp.pos.w > 0.5) {
            continue;
        }
        vec3 d = lamp.pos.xyz - hp;
        if (dot(d, d) <= r2) {
            return true;
        }
    }
    return false;
}

vec3 lighting_cascade_parent_eval(vec3 dir, vec3 n_axis) {
    if (!sh_ok) {
        return has_sky() ? scene.sky.rgb : vec3(0.0);
    }
    return sh_bins[lighting_cascade_bin_of(dir, n_axis)];
}

void lighting_cascade_parent_fetch(vec3 pos, vec3 n, float child_size) {
    vec3 bins[16];
    bool ok;
    lighting_cascade_coarser_bins(pos, n, child_size, false, bins, ok);
    for (uint b = 0u; b < CASCADE_BINS; b++) {
        sh_bins[b] = bins[b];
    }
    sh_ok = ok;
}

vec3 lighting_cascade_direct_at(vec3 origin, vec3 n) {
    if (scene_inside(origin)) {
        return vec3(0.0);
    }
    LampList list = lamps_at(origin);
    uint count = lamp_list_size(list);
    vec3 e = vec3(0.0);
    bool shadows_on = (gstats.ctrl_bits & 2u) != 0u;
    [[dont_unroll]] for (uint k = 0u; k < count; k++) {
        if (gstats.ctrl_max_lights != 0u && k >= gstats.ctrl_max_lights) {
            break;
        }
        Lamp lamp = lamp_list_get(list, k);
        vec3 target;
        vec3 light = lamp_light(lamp, origin, n, false, target);
        if (light.r + light.g + light.b <= 0.0) {
            continue;
        }
        bool lit = true;
        if (shadows_on) {
            lit = !trace_occluded(origin, target);
        }
        if (lit) {
            e += light;
        }
    }
    return e;
}

void main() {
    if (!lighting_gi_on()) {
        return;
    }
    uint due = gl_WorkGroupID.x;
    uint k = gl_LocalInvocationID.x;
    uint band = (ckeys.key[lighting_cascade_upper_head_at()] >> 16u) & 3u;
    if (due >= CASCADE_UPPER_CAP || k >= CASCADE_UPPER_RAYS_MAX) {
        return;
    }
    uint count = ckeys.key[lighting_cascade_upper_head_at() + 1u + band];
    bool live = due < min(count, CASCADE_UPPER_CAP);
    uint slot = 0u;
    vec3 pos = vec3(0.0);
    vec3 n = vec3(0.0, 1.0, 0.0);
    float size = CASCADE_GRID_BASE;
    uint rays = 16u;
    if (live) {
        slot = ckeys.key[lighting_cascade_upper_list_at(band) + due];
        live = slot < LIGHTING_CACHE_SLOTS && ckeys.key[slot] != 0u;
    }
    if (live) {
        pos = cache.v[3u * slot].xyz;
        n = cache.v[3u * slot + 1u].xyz;
        size = cache.v[3u * slot + 1u].w;
        rays = lighting_cascade_refresh_rays(size);
    }
    if (k == 0u && live) {
        lighting_cascade_parent_fetch(pos, n, size);
    }
    barrier();
    memoryBarrierShared();
    vec3 li = vec3(0.0);
    vec3 lamp_part = vec3(0.0);
    float nd = 0.0;
    float w = 0.0;
    uint bin = 0u;
    if (live && k < rays + CASCADE_CONE_UPPER) {
        uint key = ckeys.key[slot];
        vec3 axis;
        float cos_a;
        bool has_cone = lighting_cascade_cone(pos + n * 0.02, n, axis, cos_a);
        bool is_cone = k >= rays;
        vec3 dir = lighting_cascade_upper_ray(key, n, k, rays, lighting_cascade_bin_seed(slot), axis, cos_a);
        w = lighting_cascade_ray_weight(is_cone, has_cone, dir, axis, cos_a, rays, CASCADE_CONE_UPPER);
        nd = max(dot(dir, n), 0.0);
        if (!(nd > 0.0)) {
            w = 0.0;
        }
        bin = is_cone ? lighting_cascade_bin_of(dir, n) : k % CASCADE_BINS;
        if (w > 0.0) {
            uint at = lighting_cascade_upper_hit_at(due, k);
            float t = uintBitsToFloat(ckeys.key[at]);
            vec3 hp = pos + n * 0.02 + dir * t;
            if (t < 0.0 || lighting_cascade_hit_is_lamp(hp)) {
                li = lighting_cascade_parent_eval(dir, n);
            } else {
                vec3 hn = lighting_unpack_normal(ckeys.key[at + 1u]);
                vec3 reflectance = unpackUnorm4x8(ckeys.key[at + 2u]).rgb * (1.0 / LIGHTING_PI);
                vec3 bounce = lighting_cascade_bounce(hp, hn);
                vec3 e = lighting_cascade_direct_at(hp + hn * 0.02, hn);
                li = reflectance * (e + bounce);
                lamp_part = reflectance * e;
            }
        }
    }
    sh_w[k] = w;
    sh_lamp[k] = lamp_part * nd * w;
    sh_bin[k] = bin;
    sh_sum[k] = li * nd * w;
    sh_rad[k] = li;
    barrier();
    memoryBarrierShared();
    if (!live || k != 0u) {
        return;
    }
    uint traced = rays + CASCADE_CONE_UPPER;
    vec3 s0 = vec3(0.0);
    [[dont_unroll]] for (uint i = 0u; i < traced; i++) {
        s0 += sh_sum[i];
    }
    // Irradiance: Σ w L cosθ, w the solid angle each ray stands for
    // (lighting_cascade_ray_weight). Without a cone this is 2π / N Σ L cosθ.
    vec3 cur = max(s0, vec3(0.0));
    vec3 bin_sum[16];
    float bin_n[16];
    for (uint b = 0u; b < CASCADE_BINS; b++) {
        bin_sum[b] = vec3(0.0);
        bin_n[b] = 0.0;
    }
    // A bin is the solid-angle-weighted mean of its rays, cone rays included.
    [[dont_unroll]] for (uint i = 0u; i < traced; i++) {
        uint b = sh_bin[i];
        bin_sum[b] += sh_rad[i] * sh_w[i];
        bin_n[b] += sh_w[i];
    }
    if ((lighting_toggles() & LIGHTING_TOGGLE_FREEZE_CACHE) == 0u
        && lighting_cascade_finite3(cur)
        && !scene_inside(pos + n * 0.02)) {
        // A refresh moves a shaded cell CASCADE_UPPER_RATE of the way to the
        // new estimate, and its rays take new directions each refresh, so the
        // bins average many refreshes. One to four rays a bin, replaced
        // outright, kept a still scene popping: cells feed each other's
        // bounce and each refresh moved the wall by a visible step. A cell the
        // scene changed under takes more of the refresh (CASCADE_UPPER_CHANGE_RATE).
        vec4 had = cache.v[3u * slot + 2u];
        // .w is the refresh count, up to CASCADE_UPPER_LONG (1 is the first),
        // with the cell's lamp share in its fraction
        // (lighting_cascade_lamp_share). The first refreshes take the new
        // estimate whole: a cold start builds its bounce through the chain of
        // parents, and damping each link slowed a cut to full brightness. They
        // trace fixed directions (lighting_cascade_bin_seed), so taking them
        // whole does not shimmer.
        float count = floor(had.w);
        bool warm = count > CASCADE_UPPER_WARM - 0.5;
        // The scene changed under this cell since its last refresh.
        // A lamp that reaches the cell changed within the window. One fast
        // refresh is not enough: it is one noisy estimate, and the light the
        // cell's rays read from other cells is still arriving.
        uint lamp_at = lighting_lamp_move_stamp(pos);
        bool changed = (lamp_at != 0u && int(lighting_frame() - lamp_at) <= int(CASCADE_CHANGE_FRAMES))
            || lighting_reach_noting()
            || lighting_lit_changed();
        // Those signals are wide: a lamp's range sphere has no walls in it,
        // and the other two are scene-wide. In a scene whose lamps move every
        // frame they held every cell at the fast rate, and a room no lamp
        // lights showed each refresh's ray noise. The lamp share says how much
        // of the cell's light a lamp change reaches at once: the share that
        // is lamp light leaving the surfaces its rays hit. The rest is light
        // from other cells, which changes only as fast as they do. A cell
        // takes the fast rate by its lamp share and the drift rate otherwise.
        // The share is the mean of the refreshes before this one. A rate that
        // read this refresh's own rays took the bright refreshes more than
        // the dim ones (or the reverse) and moved the cell's mean.
        float share = lighting_cascade_lamp_share(had.w);
        float l_old = dot(had.xyz, vec3(0.2126, 0.7152, 0.0722));
        float l_new = dot(cur, vec3(0.2126, 0.7152, 0.0722));
        bool big = abs(l_new - l_old) > CASCADE_UPPER_JUMP * max(max(l_new, l_old), CASCADE_EPS);
        float fast = smoothstep(CASCADE_UPPER_LAMP_SHARE_LOW, CASCADE_UPPER_LAMP_SHARE_HIGH, share);
        float slow = min(CASCADE_UPPER_RATE, 1.0 / max(count, 1.0));
        // The drift rate lasts as long as the lamp ring remembers the change
        // (LIGHTING_WRC_CHANGE_FRAMES): the light from other cells is still
        // arriving after the fast window has closed.
        bool settling = changed || lamp_at != 0u;
        float drift = max(slow, CASCADE_UPPER_DRIFT_RATE);
        float rate = !warm ? 1.0
            : changed ? mix(drift, big ? 1.0 : CASCADE_UPPER_CHANGE_RATE, fast)
            : settling ? drift : slow;
        // The refresh count: up to the warm count, then on to the long mean
        // while nothing changes. A change starts the long mean again, at the
        // count that matches the rate the cell took.
        float age = count > 0.5 ? min(count + 1.0, CASCADE_UPPER_LONG) : 1.0;
        if (warm && settling) {
            age = min(age, max(CASCADE_UPPER_WARM, floor(1.0 / rate)));
        }
        vec3 lamp_sum = vec3(0.0);
        [[dont_unroll]] for (uint i = 0u; i < traced; i++) {
            lamp_sum += sh_lamp[i];
        }
        float share_now = l_new > CASCADE_EPS
            ? clamp(dot(lamp_sum, vec3(0.2126, 0.7152, 0.0722)) / l_new, 0.0, 1.0)
            : 0.0;
        share = count > 0.5 ? mix(share, share_now, CASCADE_UPPER_LAMP_SHARE_RATE) : share_now;
        age = lighting_cascade_count_pack(age, share);
        for (uint b = 0u; b < CASCADE_BINS; b++) {
            // A bin left with no weight (its rays all in the cone, no cone
            // ray in it) keeps its value.
            if (bin_n[b] > 0.0) {
                vec3 nb = bin_sum[b] / bin_n[b];
                lighting_cascade_bin_put(slot, b, mix(lighting_cascade_bin_get(slot, b), nb, rate));
            }
        }
        cache.v[3u * slot + 2u] = vec4(mix(had.xyz, cur, rate), age);
        cache.v[3u * slot].w = uintBitsToFloat(lighting_frame());
    }
}
