#version 450
// Spawn only. The xorshift jump stays out of the integrate shader so that
// pass does not carry these matrices in its registers.
layout(local_size_x = 64) in;

struct Slot {
    vec4 position_age;
    vec4 velocity_life;
};

layout(std430, set = 0, binding = 0) readonly buffer Params {
    vec4 origin_rate;
    vec4 motion;
    vec4 albedo_dt;
    uvec4 seed_budget_count_flags;
    uvec4 generation_depth;
    vec4 soft_pad;
    mat4 view_proj;
} params;

layout(std430, set = 0, binding = 1) buffer State {
    uint words[];
} state;

layout(std430, set = 0, binding = 2) buffer SlotBuf {
    Slot slots[];
} slots;

layout(std430, set = 0, binding = 3) buffer DeadBuf {
    uint indices[];
} dead;

layout(push_constant) uniform SimPush {
    uint mode;
    uint groups;
    uint scan_count;
    uint src_base;
    uint dst_base;
    uint sum_base;
    uint parent_base;
    uint scan_flags;
} sim_push;

const uint MODE_EMIT_PREP = 5u;
const uint MODE_EMIT_BODY = 6u;
const uint FREEZE = 1u;
const uint DEFAULT_SEED = 0xA341316Cu;
const float UNIT_SCALE = 16777216.0;
const float HALF = 0.5;
const float TAU = 6.283185307179586;

uint xorshift(uint x) {
    x ^= x << 13u;
    x ^= x >> 17u;
    x ^= x << 5u;
    if (x == 0u) {
        x = DEFAULT_SEED;
    }
    return x;
}

uint xs_pure(uint x) {
    x ^= x << 13u;
    x ^= x >> 17u;
    x ^= x << 5u;
    return x;
}

uint parity(uint bits) {
    return uint(bitCount(bits)) & 1u;
}

void mat_mul(uint a[32], uint b[32], out uint c[32]) {
    for (int i = 0; i < 32; i++) {
        uint row = 0u;
        uint mask = a[i];
        for (int j = 0; j < 32; j++) {
            if ((mask & (1u << uint(j))) != 0u) {
                row ^= b[j];
            }
        }
        c[i] = row;
    }
}

uint xs_jump(uint x, uint n) {
    if (n == 0u) {
        return x;
    }
    if (x == 0u) {
        x = DEFAULT_SEED;
        n -= 1u;
    }
    uint step[32];
    for (int i = 0; i < 32; i++) {
        step[i] = 0u;
    }
    for (uint b = 0u; b < 32u; b++) {
        uint outb = xs_pure(1u << b);
        for (int i = 0; i < 32; i++) {
            if ((outb & (1u << uint(i))) != 0u) {
                step[i] |= 1u << b;
            }
        }
    }
    uint result[32];
    for (int i = 0; i < 32; i++) {
        result[i] = 1u << uint(i);
    }
    uint left = n;
    while (left != 0u) {
        if ((left & 1u) != 0u) {
            uint next[32];
            mat_mul(result, step, next);
            for (int i = 0; i < 32; i++) {
                result[i] = next[i];
            }
        }
        uint squared[32];
        mat_mul(step, step, squared);
        for (int i = 0; i < 32; i++) {
            step[i] = squared[i];
        }
        left >>= 1u;
    }
    uint y = 0u;
    for (int i = 0; i < 32; i++) {
        y |= parity(result[i] & x) << uint(i);
    }
    return y;
}

float unit_of(inout uint rng) {
    rng = xorshift(rng);
    return float(rng >> 8u) / UNIT_SCALE;
}

void main() {
    uint budget = params.seed_budget_count_flags.y;
    uint cap = params.seed_budget_count_flags.z;
    uint flags = params.seed_budget_count_flags.w;
    uint id = gl_GlobalInvocationID.x;
    uint mode = sim_push.mode;
    if (budget == 0u) {
        return;
    }
    if (cap > budget) {
        cap = budget;
    }
    float dt = params.albedo_dt.w;
    bool moving = !isnan(dt) && !isinf(dt) && dt > 0.0 && (flags & FREEZE) == 0u;
    if (mode == MODE_EMIT_PREP) {
        if (id != 0u) {
            return;
        }
        state.words[7] = 0u;
        state.words[13] = 0u;
        if (!moving) {
            return;
        }
        float life = max(params.motion.y, 0.0);
        float clock = uintBitsToFloat(state.words[8]) + dt;
        float rate = params.origin_rate.w;
        float interval = rate > 0.0 ? 1.0 / rate : 1e9;
        if (!(life > 0.0)) {
            uint guard = 0u;
            while (clock >= interval && state.words[4] < cap && state.words[3] > 0u && guard < cap) {
                guard += 1u;
                clock -= interval;
                uint head = state.words[2] % budget;
                uint index = dead.indices[head];
                state.words[2] = (state.words[2] + 1u) % budget;
                state.words[3] -= 1u;
                uint rng = state.words[1];
                float u = unit_of(rng);
                float v = unit_of(rng);
                float dx = unit_of(rng);
                float dz = unit_of(rng);
                state.words[1] = rng;
                float angle = u * TAU;
                float radius = sqrt(v) * params.motion.z;
                vec3 origin = params.origin_rate.xyz;
                float spread = params.motion.z;
                vec3 position = vec3(
                    origin.x + cos(angle) * radius,
                    origin.y,
                    origin.z + sin(angle) * radius);
                vec3 velocity = vec3((dx - HALF) * spread, params.motion.x, (dz - HALF) * spread);
                slots.slots[index].position_age = vec4(position, 0.0);
                slots.slots[index].velocity_life = vec4(velocity, life);
                state.words[2] = (head + 1u) % budget;
                uint tail = (state.words[2] + state.words[3]) % budget;
                dead.indices[tail] = index;
                state.words[3] += 1u;
            }
            state.words[8] = floatBitsToUint(clock);
            return;
        }
        uint n = 0u;
        while (clock >= interval && state.words[4] + n < cap && state.words[3] > n && n < cap) {
            n += 1u;
            clock -= interval;
        }
        uint rng = state.words[1];
        state.words[11] = rng;
        state.words[12] = state.words[2];
        state.words[13] = n;
        state.words[1] = xs_jump(rng, n * 4u);
        state.words[2] = (state.words[2] + n) % budget;
        state.words[3] -= n;
        state.words[4] += n;
        state.words[5] += n;
        state.words[7] = n;
        state.words[8] = floatBitsToUint(clock);
        return;
    }
    if (mode == MODE_EMIT_BODY) {
        uint n = state.words[13];
        if (id >= n || id >= budget) {
            return;
        }
        uint rng = xs_jump(state.words[11], id * 4u);
        float u = unit_of(rng);
        float v = unit_of(rng);
        float dx = unit_of(rng);
        float dz = unit_of(rng);
        uint head = state.words[12];
        uint index = dead.indices[(head + id) % budget];
        float angle = u * TAU;
        float radius = sqrt(v) * params.motion.z;
        vec3 origin = params.origin_rate.xyz;
        float spread = params.motion.z;
        float life = max(params.motion.y, 0.0);
        vec3 position = vec3(
            origin.x + cos(angle) * radius,
            origin.y,
            origin.z + sin(angle) * radius);
        vec3 velocity = vec3((dx - HALF) * spread, params.motion.x, (dz - HALF) * spread);
        slots.slots[index].position_age = vec4(position, 0.0);
        slots.slots[index].velocity_life = vec4(velocity, life);
    }
}
