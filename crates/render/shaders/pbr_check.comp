#version 450
// GPU parity fixture for pbr_brdf.glsl. build.rs compiles this.
// tests/pbr_parity.rs dispatches it and compares with genos_math::brdf.
// Push constant `broken` 0 is the real shade. Non-zero drops the (1 - F)
// diffuse weight, which the parity gate must catch.
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 1) in;

layout(std430, set = 0, binding = 0) buffer Out {
    float values[];
} result;

layout(push_constant) uniform Push {
    uint broken;
} pc;

#include "pbr_brdf.glsl"

// Grid. Same literals as tests/pbr_parity.rs.
const float COSINES[5] = float[5](0.05, 0.25, 0.5, 0.75, 1.0);
const float ROUGHNESS[5] = float[5](0.1, 0.3, 0.5, 0.75, 1.0);
const float METALLIC[3] = float[3](0.0, 0.5, 1.0);
const vec3 ALBEDO[3] = vec3[3](vec3(1.0), vec3(0.5, 0.25, 0.1), vec3(0.04, 0.8, 0.3));
const uint STRIDE = 6u;

void main() {
    uint row = 0u;
    for (uint il = 0u; il < 5u; il++) {
        for (uint iv = 0u; iv < 5u; iv++) {
            float nl = COSINES[il];
            float nv = COSINES[iv];
            // Light and view in the xz plane on opposite sides of n = +z.
            vec3 l = vec3(sqrt(max(0.0, 1.0 - nl * nl)), 0.0, nl);
            vec3 v = vec3(-sqrt(max(0.0, 1.0 - nv * nv)), 0.0, nv);
            vec3 h = normalize(l + v);
            float nh = h.z;
            // |n x h|^2 for n = +z; see pbr_d_ggx.
            float nxh2 = h.x * h.x + h.y * h.y;
            float vh = dot(v, h);
            for (uint ir = 0u; ir < 5u; ir++) {
                for (uint im = 0u; im < 3u; im++) {
                    for (uint ia = 0u; ia < 3u; ia++) {
                        float rough = ROUGHNESS[ir];
                        float metal = METALLIC[im];
                        vec3 base = ALBEDO[ia];
                        float alpha = pbr_alpha(rough);
                        vec3 f = pbr_eval(base, metal, rough, nl, nv, nh, nxh2, vh);
                        if (pc.broken != 0u) {
                            float fd = pbr_fresnel_schlick(PBR_DIELECTRIC_F0, vh);
                            f += (1.0 - metal) * fd * (base / PBR_PI);
                        }
                        uint b = row * STRIDE;
                        result.values[b + 0u] = pbr_d_ggx(nh, nxh2, alpha);
                        result.values[b + 1u] = pbr_v_smith_ggx_correlated(nl, nv, alpha);
                        result.values[b + 2u] = pbr_fresnel_schlick(PBR_DIELECTRIC_F0, vh);
                        result.values[b + 3u] = f.r;
                        result.values[b + 4u] = f.g;
                        result.values[b + 5u] = f.b;
                        row++;
                    }
                }
            }
        }
    }
}
