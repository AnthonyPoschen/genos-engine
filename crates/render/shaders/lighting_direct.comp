#version 450
#define GENOS_SUN_SHADER 1
// GI direct light: every lamp at a surface point, each with a shadow ray through
// the tracer. The points are the picture's pixels (G-buffer) followed by every kept
// hit of the screen probes (all strata, so a kept hit always carries this frame's
// light: no light history), the light cache's ray hits and the probes' fills, so all share this loop
// and its one trace site. A pixel keeps its irradiance; a hit adds the light cache's bounced
// irradiance and turns the sum into the light it sends back along the ray, plus
// any light the surface emits. A pixel's emitted light (G-buffer w from the
// raster) moves to the output buffer for the final pass.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "lighting_common.glsl"
#include "lighting_lamp_pick.glsl"
#include "pbr_brdf.glsl"
#ifdef GENOS_RESTIR_DI
layout(std430, set = 0, binding = 19) buffer RestirWords {
    uint restir_words[];
};
// Near point lamps actually added on a ReSTIR pixel. Header word, same slot
// the history counts use. Compact keeps gstats.diag[13] for an on-screen
// surface-cache entry when LIGHTING_DIAG is on.
const uint RESTIR_DIAG_POINT_ADD = 45u;
#endif

// A stored depth of 0 is a miss. Exact and ReSTIR records stay positive.
const float LAMP_PICK_DEPTH_FLOOR = 1.0e-4;
const float DIRECT_DIR_EPS = 1.0e-6;
void main() {
    lighting_sun_mark();
    uint idx = gl_GlobalInvocationID.x;
    uint pixels = pc.dims.x * pc.dims.y;
    uint mode = lighting_mode();
    uint kept = lighting_kept_hits();
    uint cache_rays = LIGHTING_CACHE_BATCH * LIGHTING_CACHE_RAYS;
    // Pixel-only (GI off, or a coarser direct grid): leave before any work or
    // cache read. Mode 0's point count includes cache-ray slots, and the tail
    // of the last group would index the dummy buffers.
    if (gstats.ctrl_pixel_only != 0u) {
        uint scale = max(gstats.ctrl_scale, 1u);
        uint lw = (pc.dims.x + scale - 1u) / scale;
        uint lh = (pc.dims.y + scale - 1u) / scale;
        if (idx >= lw * lh) {
            return;
        }
        uint sx = (idx % lw) * scale;
        uint sy = (idx / lw) * scale;
        idx = sy * pc.dims.x + sx;
    } else if (lighting_ray_fill_on() && lighting_dense()) {
        // The cache-ray dispatch only. The picture dispatch is not dense, and
        // taking this branch there would shade cache rays instead of pixels.
        if (idx >= lighting_fill_u(0)) {
            return;
        }
        idx = pixels + kept + idx;
    } else if (lighting_dense()) {
        // S70A: this round's light cache rays only, live entries only.
        // Bias is a pixel skip for the kept-hit dispatch. Applying it here
        // pushes every dense thread past the live-entry count, so cache rays
        // never get lit and compose shows whatever was left in the buffers.
        if (idx >= lighting_dense_count() * LIGHTING_CACHE_RAYS) {
            return;
        }
        idx = pixels + kept + lighting_dense_entry(idx / LIGHTING_CACHE_RAYS) * LIGHTING_CACHE_RAYS + idx % LIGHTING_CACHE_RAYS;
    } else {
        if (gstats.ctrl_bias != 0u) {
            idx += gstats.ctrl_bias;
        }
        if (mode == 2u) {
            idx += pixels + kept;
        }
    }
    // Then (not on the async queue) one point per fill slot.
    uint fills = pixels + kept + (mode == 1u ? 0u : cache_rays);
    if (gstats.ctrl_pixel_only == 0u) {
        uint points = fills + (mode == 2u ? 0u : kept);
        if (idx >= points) {
            return;
        }
    }
    // Cache rays only. A probe index of 0 would alias this region.
    uint ray = 0u;
    if (idx >= pixels + kept) {
        ray = lighting_probe_rays() + (idx - pixels - kept);
    }
    vec3 pos;
    vec3 n;
    float hit_t = 1.0e9;
    vec3 reflectance = vec3(1.0);
    bool two_sided = false;
    vec3 glow = vec3(0.0);
    if (idx < pixels) {
        vec3 albedo;
        if (!lighting_surface(uvec2(idx % pc.dims.x, idx / pc.dims.x), pos, n, albedo, two_sided)) {
            return;
        }
    } else {
        vec4 rec;
        vec3 origin;
        vec3 dir;
        vec3 from_n;
        bool live;
        rec = work.v[lighting_hit_at(ray)];
        live = lighting_ray(ray, origin, dir, from_n);
        if (rec.x < 0.0 || !live) {
            return;
        }
        pos = origin + dir * rec.x;
        hit_t = rec.x;
        n = lighting_unpack_normal(floatBitsToUint(rec.y));
        reflectance = unpackUnorm4x8(floatBitsToUint(rec.z)).rgb * (1.0 / LIGHTING_PI);
        glow = lighting_unpack_rgb9e5(floatBitsToUint(rec.w));
    }
    vec3 origin = pos + n * 0.02;
    LampList list = lamps_at(origin);
    uint count = lamp_list_size(list);
    // S78J: a pixel whose point and lamps match last frame's, in a quiet frame.
    uint pix_sig = 0u;
    if (lighting_pix_reuse_on() && idx < pixels) {
        pix_sig = lighting_pix_sig(pos, n, two_sided, list);
        // The lobe depends on the view. A still camera keeps the hold; a turn does not.
        if ((gstats.ctrl_bits & 2097152u) != 0u) {
            pix_sig ^= lighting_pack_normal(scene.eye.xyz - pos);
        }
        // A one-lamp view must not reuse a held full sum.
        if ((scene.grid_at.w & 255u) == 6u) {
            pix_sig ^= lighting_hash(((scene.grid_at.w >> 8u) & 0xFFFFu) + 1u);
        }
        vec4 pv = work.v[lighting_pix_at() + idx / 2u];
        uint c = (idx & 1u) * 2u;
        // A small sun step still traces. Reusing last frame's direct would
        // leave the sun and its shadow a frame behind.
        if (pix_sig != 0u && floatBitsToUint(pv[c]) == pix_sig && lighting_pix_quiet() && !lighting_sun_small()) {
            // Bit 21 with bits 18-20 clear is the production reservoir, including
            // mode off and mode hits. A quiet view must not return last frame's
            // colour and skip that sample. The signature hold is the success
            // path for a non-exact mode: bit 19 is clear on a frame whose
            // prepare bound the reservoir, so the clear below does not run.
            // Bit 19 is a failed prepare, or restir off on a mode that used to
            // sample. It clears the signature hold, so mode hits shades the sum
            // instead of the previous reservoir colour. Mode 4 retraces.
            bool restir_product = ((pc.lamp.y >> 21u) & 1u) != 0u
                && ((pc.lamp.y >> 18u) & 7u) == 0u;
            // Mode 4 retraces every quiet frame. A 32-frame exact hold returned
            // last frame's colour and froze the grain. ReSTIR (bit 21, bits
            // 18-20 clear) never takes this signature hold.
            bool hold = !restir_product && pc.lamp.x != 4u;
            // Bit 19 is a failed prepare, or restir off on a mode that used to
            // sample. It clears the signature hold. Mode 4 does not hold.
            if (hold && pc.lamp.x != 4u && ((pc.lamp.y >> 19u) & 1u) != 0u) {
                hold = false;
            }
            if (hold) {
                uint emitted = gbuf_word(idx, 3u);
                uint glow = emitted == ~0u || (gstats.ctrl_bits & 512u) == 0u ? 0u : emitted;
                uint prev = outc.px[pixels + idx];
                // Emitted stays out of the picture buffer; compose reads it here.
                outc.px[pixels + idx] = glow;
                gbuf.words[idx * 5u + 3u] = floatBitsToUint(pv[c + 1u]);
                if (glow != prev) {
                    lighting_compose_mark_px(idx);
                }
                return;
            }
        }
    }
    // S75 Lumen surface-cache direct lighting for hits (lighting_cache.glsl).
    uint tdl = ~0u;
    uint tdl_sig = 0u;
    vec3 n_hit = n;
    if (LIGHTING_TDL && idx >= pixels && lighting_world_mode() == 3u && !lighting_grad_check_ray(ray)) {
        uint ts = lighting_cache_find_sized(pos, n, false, LIGHTING_SC_TEXEL, pos);
        // A hit off screen has no pixel texel, only the hit patch its bounce
        // lookup claimed (lighting_cache_irradiance). Its direct light is held
        // there too; without it each such hit walked every lamp in range every
        // relight (~80 % of the GI-on direct pass's lamp work, gi-on-direct-fix.md).
        if (ts == ~0u) {
            ts = lighting_cache_find_sized(pos, n, false, lighting_hit_size_n(pos, n), pos);
        }
        vec3 tp;
        vec3 tn;
        if (ts != ~0u && lighting_sc_texel_world(ts, tp, tn)) {
            LampList tl = lamps_at(tp + tn * 0.02);
            tdl_sig = lighting_tdl_sig(ts, tl);
            vec4 d = cache.v[LIGHTING_TDL_AT + ts];
            if (tdl_sig != 0u && floatBitsToUint(d.z) == tdl_sig && lighting_frame() - floatBitsToUint(d.w) < LIGHTING_TDL_STALE) {
                count = 0u;
                tdl = ts | 0x80000000u;
                lighting_dg(36u, 1u);
            } else if (LIGHTING_TDL_CHECK && tdl_sig != 0u && floatBitsToUint(d.z) != 0u) {
                // S78E / S76C as above. Amortise checks over 4 frames (hash on
                // texel ^ frame); overflow keeps the held value. Catch-up after
                // a lamp stops skips the amort so linger stays (gi-on-direct).
                if (!lighting_catch_up() && (lighting_hash(ts) ^ lighting_frame()) % 4u != 0u) {
                    count = 0u;
                    tdl = ts | 0x80000000u;
                    lighting_dg(36u, 1u);
                } else {
                    lighting_dg(47u, 1u);
                    tdl = ts | 0x40000000u;
                    origin = tp + tn * 0.02;
                    n = tn;
                    list = tl;
                    count = lamp_list_size(list);
                }
            } else if (tdl_sig != 0u && atomicAdd(ckeys.key[LIGHTING_TDL_COUNT_AT], 1u) < LIGHTING_TDL_BUDGET) {
                lighting_dg(37u, 1u);
                tdl = ts;
                origin = tp + tn * 0.02;
                n = tn;
                list = tl;
                count = lamp_list_size(list);
            }
        }
    }
    // Diag: lamp-list entries a pixel walks. Cache rays are not that count.
    if (lamp_pick_diag() && idx < pixels) {
        atomicAdd(gstats.diag[38u], count);
    }
    // Light cache rays (params.z bit 11): at most LIGHTING_CACHE_PICKS shadow rays,
    // lamps picked systematically in proportion to their unshadowed light, each
    // weighted by how often it is expected to be picked (unbiased, as
    // lamps_light_only). The pick offset hangs on the patch and the ray, so a
    // still scene relights to the same value.
    bool cache_pick = idx >= pixels + kept && ((pc.params.z >> 11u) & 1u) != 0u;
    bool tdl_check = tdl != ~0u && (tdl & 0x40000000u) != 0u;
    // TDL-new used to shade every lamp (exact). With hitsize, new is the remaining
    // GI-on excess alongside check; seed it with CACHE_PICKS like check (stable u).
    bool tdl_new = tdl != ~0u && (tdl & 0xC0000000u) == 0u;
    bool pick = (cache_pick && tdl == ~0u) || tdl_check || tdl_new;
    // Weighted point-lamp picking shares this loop's one trace. The sun stays
    // exact. A texel-direct check keeps the legacy estimator. Mode 0 leaves
    // `pick` as it was, so today's shade is unchanged.
    uint lamp_mode = pc.lamp.x;
    bool lamp_pix = idx < pixels && lamp_mode >= 2u && lamp_mode <= 4u;
    bool lamp_hit = idx >= pixels && (lamp_mode == 1u || lamp_mode == 3u || lamp_mode == 4u);
    bool lamp_new = (lamp_pix || lamp_hit) && tdl == ~0u;
#ifdef GENOS_RESTIR_DI
    // Product pixels only. The labelled exact sum, the random path, and the
    // broken picker stay on the shade below. lamp_new off skips both.
    bool restir_pix = ((pc.lamp.y >> 21u) & 1u) != 0u
        && ((pc.lamp.y >> 18u) & 7u) == 0u
        && idx < pixels;
    if (restir_pix) {
        lamp_new = false;
    }
#endif
    if (lamp_new) {
        pick = false;
    }
    float total = 0.0;
    uint lit = 0u;
    float u = 0.0;
    if (pick) {
        uint fill_r = ray >= lighting_probe_rays() ? ray - lighting_probe_rays() : ~0u;
        uint fill_checks = lighting_ray_fill_on() ? ckeys.key[lighting_fill_header_at() + 2u] : 0u;
        if (fill_r < fill_checks) {
            // Same lamp sample every frame. A texel-direct check must not mix the frame in.
            u = lighting_fill_check_u(ckeys.key[LIGHTING_FILL_PICK_AT + fill_r]);
        } else if (cache_pick) {
            uint r = ray - lighting_probe_rays();
            uint ent = r / LIGHTING_CACHE_RAYS;
            if (lighting_world_mode() == 3u && ent >= lighting_grad_first() && ent < LIGHTING_CACHE_BATCH - LIGHTING_WRC_SCOUT_ENTRIES) {
                // S74A gradient check: the stored ray's lamp pick (same seed).
                uint gs = ckeys.key[LIGHTING_GRAD_LIST_AT + r - lighting_grad_first() * LIGHTING_CACHE_RAYS];
                u = lighting_unit(ckeys.key[gs] ^ (floatBitsToUint(cache.v[LIGHTING_SC_GRAD_AT + gs].w) * 0x85ebca6bu + 0x5bd1e995u));
            } else {
            uint slot = lighting_cache_batch_slot(ent);
            uint key = slot == ~0u ? 0u : ckeys.key[slot];
            uint q = slot == ~0u ? 0u : lighting_cache_entry_quarter(ent, slot);
            u = lighting_unit(key ^ ((q * LIGHTING_CACHE_RAYS + r % LIGHTING_CACHE_RAYS) * 0x85ebca6bu + 0x5bd1e995u));
            }
        } else if (tdl_check) {
            u = lighting_unit(lighting_hash((tdl & 0x3FFFFFFFu) ^ lighting_frame() * 0x9e3779b9u));
        } else if (tdl_new) {
            u = lighting_unit(lighting_hash((tdl & 0x3FFFFFFFu) * 0x85ebca6bu + 0x27d4eb2fu));
        }
        [[dont_unroll]] for (uint k = 0u; k < count; k++) {
            if (gstats.ctrl_max_lights != 0u && k >= gstats.ctrl_max_lights) {
                break;
            }
            vec3 target;
            vec3 light = lamp_light(lamp_list_get(list, k), origin, n, two_sided, target);
            float w = light.r + light.g + light.b;
            total += w;
            lit += w > 0.0 ? 1u : 0u;
        }
    }
    // Hits outside this frame's slice keep the committed sun. Pixels use the live sun.
    bool sun_hold = false;
    bool sun_slice = false;
    if (lighting_sun_small() && idx >= pixels) {
        uint ent = (ray - lighting_probe_rays()) / LIGHTING_CACHE_RAYS;
        uint slot = lighting_cache_batch_slot(ent);
        sun_slice = slot != ~0u && lighting_sun_slot_slice(slot);
        sun_hold = slot != ~0u && !sun_slice;
    }
    // Chosen point lamps for this point. The shade loop below is still the
    // only trace. Suns are not entries: they are traced on their own.
    // shade_exact walks every point lamp at scale 1 (the labelled sum).
    // Otherwise chosen_* is one visibility sample for a hit or for the
    // noise gate. Production pixels do not reach this: ReSTIR clears lamp_new.
    uint view_only = LAMP_ALL;
    if ((scene.grid_at.w & 255u) == 6u) {
        view_only = (scene.grid_at.w >> 8u) & 0xFFFFu;
    }
#ifdef GENOS_RESTIR_DI
    // light:I shades that one scene lamp. The reservoir is not that view.
    if (view_only != LAMP_ALL) {
        restir_pix = false;
        lamp_new = (lamp_pix || lamp_hit) && tdl == ~0u;
    }
#endif
    uint chosen_k[4] = uint[4](0u, 0u, 0u, 0u);
    float chosen_s[4] = float[4](0.0, 0.0, 0.0, 0.0);
    uint chosen_n = 0u;
    bool shade_exact = false;
    // Samples folded into the displayed colour while the exact-sum hold is off.
    uint mean_count = 0u;
    if (lamp_new) {
        float point_total = 0.0;
        uint point_lit = 0u;
        lamp_pick_point_sum(list, count, origin, n, two_sided, point_total, point_lit);
        bool reuse_pix = lamp_pix && lamp_mode == 4u;
        if (lamp_pix && lamp_pick_force_exact()) {
            shade_exact = true;
        }
        if (reuse_pix && view_only != LAMP_ALL) {
            shade_exact = true;
        }
        if (reuse_pix && !shade_exact && point_lit > 0u) {
            bool quiet_held = lighting_pix_quiet() && lighting_view_held() && !lamp_pick_hold_off();
            if (quiet_held || point_lit <= LAMP_PICK_EXACT_LIT) {
                // The labelled sum, and the noise gate's few-lamp row.
                // A quiet held view writes it once and the next frame holds.
                shade_exact = true;
            } else if (lamp_pick_broken()) {
                // Uniform, then the raw light. A MIS weight would hide the fault.
                uint mixf = lamp_pick_frame_mix();
                float ub = lighting_unit(lighting_hash(idx ^ (mixf * 0x9e3779b9u) ^ 0x51u));
                uint k = lamp_pick_uniform(list, count, origin, n, two_sided, point_lit, ub);
                uint slot = lamp_res_slot_now();
                if (k == ~0u) {
                    lamp_res_store(idx, slot, lamp_res_empty());
                    lamp_geo_store(idx, slot, uvec4(0u));
                } else {
                    LampReservoir cur;
                    cur.lamp = lamp_list_index(list, k);
                    cur.m = 1u;
                    cur.w_sum = 1.0;
                    cur.target = 1.0;
                    lamp_res_store(idx, slot, cur);
                    if (chosen_n < 4u) {
                        chosen_k[chosen_n] = k;
                        chosen_s[chosen_n] = 1.0;
                        chosen_n += 1u;
                    }
                }
            } else if (lamp_pick_hold_off()) {
                // The gate's running mean is an average of fresh samples.
                // A temporal merge would lock one lamp. Production does not
                // set the hold-off bit: those pixels are the ReSTIR sample.
                uint mixf = lamp_pick_frame_mix();
                uint cand = lamp_pick_candidates();
                float w_ris = 0.0;
                uint win_k = ~0u;
                float win_phat = 0.0;
                [[dont_unroll]] for (uint c = 0u; c < cand; c++) {
                    float uc = lighting_unit(lighting_hash(idx ^ lighting_hash(mixf ^ lighting_hash(2u * c))));
                    float sample_phat = 0.0;
                    uint sample_k = lamp_pick_one(list, count, origin, n, two_sided, point_total, point_lit, uc, sample_phat);
                    float ris = point_total;
                    w_ris += ris;
                    float u_chao = lighting_unit(lighting_hash(idx ^ lighting_hash(mixf ^ lighting_hash(2u * c + 1u))));
                    if (sample_k != ~0u && w_ris > 0.0 && u_chao < ris / w_ris) {
                        win_k = sample_k;
                        win_phat = sample_phat;
                    }
                }
                uint slot = lamp_res_slot_now();
                if (win_k == ~0u || win_phat <= 0.0) {
                    lamp_res_store(idx, slot, lamp_res_empty());
                    lamp_geo_store(idx, slot, uvec4(0u));
                } else {
                    LampReservoir canonical;
                    canonical.lamp = lamp_list_index(list, win_k);
                    canonical.m = cand;
                    canonical.w_sum = point_total * float(cand);
                    canonical.target = win_phat;
                    lamp_res_store(idx, slot, canonical);
                    if (canonical.target > 0.0 && chosen_n < 4u) {
                        chosen_k[chosen_n] = win_k;
                        float shade_w = point_total / canonical.target;
                        if (lamp_pick_unbiased()) {
                            shade_w = lamp_res_w(canonical);
                        }
                        chosen_s[chosen_n] = shade_w;
                        chosen_n += 1u;
                    }
                }
            } else {
                // The pairwise sample is not a product fallback.
                shade_exact = true;
            }
        } else if (reuse_pix && !shade_exact) {
            lamp_res_store(idx, lamp_res_slot_now(), lamp_res_empty());
            lamp_geo_store(idx, lamp_res_slot_now(), uvec4(0u));
        }
        if (!shade_exact && chosen_n == 0u && point_lit > 0u) {
            uint use_rays = lamp_pick_rays();
            float pick_u = lamp_pick_u(idx, pixels, kept, false, reuse_pix, ray, 0u, pos, n);
            bool exact_pt = point_lit <= use_rays;
            float step_pt = point_total / float(use_rays);
            float run_pt = 0.0;
            [[dont_unroll]] for (uint k = 0u; k < count; k++) {
                if (gstats.ctrl_max_lights != 0u && k >= gstats.ctrl_max_lights) {
                    break;
                }
                if (k < list.suns.y) {
                    continue;
                }
                vec3 target_pt;
                vec3 light_pt = lamp_light(lamp_list_get(list, k), origin, n, two_sided, target_pt);
                float w_pt = light_pt.r + light_pt.g + light_pt.b;
                if (w_pt <= 0.0) {
                    continue;
                }
                float times_pt = 1.0;
                if (!exact_pt) {
                    float before_pt = ceil(run_pt / step_pt - pick_u);
                    run_pt += w_pt;
                    times_pt = ceil(run_pt / step_pt - pick_u) - before_pt;
                }
                if (times_pt > 0.0 && chosen_n < 4u) {
                    chosen_k[chosen_n] = k;
                    chosen_s[chosen_n] = exact_pt ? 1.0 : times_pt * step_pt / w_pt;
                    chosen_n += 1u;
                }
            }
        }
    }
#ifdef GENOS_RESTIR_DI
    uint restir_scene = 0xffffffffu;
    uint restir_lamp = 0xffffffffu;
    float restir_w = 0.0;
    if (restir_pix) {
        // One reservoir may cover a block of screen pixels (header 7 and 8
        // are the reservoir grid; pc.dims is the screen). Scale 1 keeps the
        // screen index. Each screen pixel still traces its own shadow ray.
        uint rpix = idx;
        uint rw = restir_words[7u];
        uint rh = restir_words[8u];
        if (rw != 0u && rh != 0u && (rw != pc.dims.x || rh != pc.dims.y)) {
            uint sx = pc.dims.x / rw;
            uint sy = pc.dims.y / rh;
            if (sx == 0u) {
                sx = 1u;
            }
            if (sy == 0u) {
                sy = 1u;
            }
            uint rx = (idx % pc.dims.x) / sx;
            uint ry = (idx / pc.dims.x) / sy;
            if (rx >= rw) {
                rx = rw - 1u;
            }
            if (ry >= rh) {
                ry = rh - 1u;
            }
            rpix = ry * rw + rx;
        }
        uint at = restir_words[6u] + rpix * 4u;
        restir_lamp = restir_words[at];
        float restir_sum = uintBitsToFloat(restir_words[at + 1u]);
        uint restir_m = restir_words[at + 2u];
        float restir_target = uintBitsToFloat(restir_words[at + 3u]);
        float restir_mf = float(restir_m >> 16u) * float(65536u) + float(restir_m & 0xffffu);
        if (restir_m != 0u && restir_lamp != 0xffffffffu && restir_target > 0.0 && restir_sum > 0.0 && restir_mf > 0.0) {
            restir_w = restir_sum / (restir_mf * restir_target);
            restir_scene = restir_words[restir_words[1u] + restir_lamp * 8u + 7u];
        }
    }
#endif
    bool exact = !pick || lit <= LIGHTING_CACHE_PICKS;
    float step = total / float(LIGHTING_CACHE_PICKS);
    float run = 0.0;
    bool lobe = (gstats.ctrl_bits & 2097152u) != 0u && idx < pixels;
    vec3 e = vec3(0.0);
    vec3 e_sun = vec3(0.0);
    vec3 spec = vec3(0.0);
    vec3 view = vec3(0.0, 1.0, 0.0);
    vec3 ns = n;
    vec3 base = vec3(1.0);
    float rough = 1.0;
    float metal = 0.0;
    if (lobe) {
        view = scene.eye.xyz - origin;
        float vlen = length(view);
        view = vlen > DIRECT_DIR_EPS ? view / vlen : vec3(0.0, 1.0, 0.0);
        ns = n;
        if (two_sided && dot(ns, view) < 0.0) {
            ns = -ns;
        }
        gbuf_material(idx, base, rough, metal);
    }
    [[dont_unroll]] for (uint k = 0u; k < count; k++) {
#ifdef GENOS_RESTIR_DI
        // The reservoir replaces near point lamps. Skip the load. The sun
        // (k < suns) and the flame (k == suns + near) stay in this loop.
        if (restir_pix && k >= list.suns.y && k < list.suns.y + list.near.y) {
            continue;
        }
#endif
        // The reservoir samples every point lamp. The cap stays on the labelled
        // exact walk and the hit picker, which do not set restir_pix.
        bool cap_lamps = true;
#ifdef GENOS_RESTIR_DI
        cap_lamps = !restir_pix;
#endif
        if (cap_lamps && gstats.ctrl_max_lights != 0u && k >= gstats.ctrl_max_lights) {
            break;
        }
        Lamp sun_lamp_l = lamp_list_get(list, k);
        bool sun_lamp = sun_lamp_l.pos.w > 0.5;
        // light:I shades that one scene lamp. The index is bits 8-23 of grid_at.w.
        if (view_only != LAMP_ALL && lamp_list_index(list, k) != view_only) {
            continue;
        }
        if (lamp_new && !shade_exact && !sun_lamp && chosen_n > 0u) {
            bool chosen = false;
            [[dont_unroll]] for (uint s = 0u; s < chosen_n; s++) {
                chosen = chosen || chosen_k[s] == k;
            }
            if (!chosen) {
                continue;
            }
        }
        if (sun_hold && sun_lamp) {
            vec3 d = lighting_sun_committed_dir();
            float d2 = dot(d, d);
            if (d2 > 0.5) {
                sun_lamp_l.pos.xyz = d * inversesqrt(d2);
            }
        }
        vec3 target;
        vec3 light = lamp_light(sun_lamp_l, origin, n, two_sided, target);
        float w = light.r + light.g + light.b;
        if (w <= 0.0) {
            continue;
        }
        float times = 1.0;
        float scale = 1.0;
        bool take = true;
        if (lamp_new && shade_exact) {
            times = 1.0;
            scale = 1.0;
            take = true;
        } else if (lamp_new) {
            if (sun_lamp) {
                times = 1.0;
                scale = 1.0;
                take = true;
            } else {
                take = false;
                scale = 0.0;
                times = 0.0;
                [[dont_unroll]] for (uint s = 0u; s < chosen_n; s++) {
                    if (chosen_k[s] == k) {
                        take = true;
                        scale = chosen_s[s];
                        times = 1.0;
                    }
                }
            }
        } else if (!exact) {
            float before = ceil(run / step - u);
            run += w;
            times = ceil(run / step - u) - before;
            take = times > 0.0;
            scale = times * step / w;
        }
        // S74A: hits (not pixels) reuse a static lamp's shadow (lighting_cache.glsl).
        // Shadows off skips the trace and the cell. Hard traces every time.
        bool shadow_lit = false;
        bool shadows_on = (gstats.ctrl_bits & 2u) != 0u;
        if (!shadows_on) {
            shadow_lit = take;
        } else if (take) {
            uint li = idx >= pixels ? lamp_list_index(list, k) : LAMP_ALL;
            // Probe-only keeps the real cache buffer, so the cell still applies.
            // No probes and no world cache is a dummy: do not index it.
            // High is mode 3, the same branch as before this gate.
            bool probes_on = (gstats.ctrl_bits & 16u) != 0u;
            bool cache_on = (gstats.ctrl_bits & 32u) != 0u;
            bool cell_stored = lighting_world_mode() == 3u || (!cache_on && probes_on);
            bool cell = (gstats.ctrl_bits & 2048u) == 0u && lighting_gi_on() && cell_stored && li < LAMP_ALL - 1u;
            // The slice retraces the live sun and does not write that bit
            // over the committed epoch. Flag off: the cell is the old path.
            float sc = cell ? lighting_shadow_get(origin, n, li) : -1.0;
            if (sun_slice && sun_lamp) {
                sc = -1.0;
            }
            if (sc >= 0.0) {
                shadow_lit = sc > 0.5;
            } else {
                shadow_lit = !trace_occluded(origin, target);
                // Counts a real shadow ray. A shadow-cell hit does not. Off
                // unless GENOS_LIGHTING_LAMP_PICK_DIAG set the push bit.
                if (lamp_pick_diag()) {
                    atomicAdd(gstats.diag[idx >= pixels ? 51u : 48u], 1u);
                }
                if (cell && !(lighting_sun_small() && sun_lamp)) {
                    lighting_shadow_put(origin, n, li, shadow_lit);
                }
            }
        }
        if (shadow_lit) {
            vec3 add = (!lamp_new && exact) ? light : light * scale;
            e += add;
#ifdef GENOS_RESTIR_DI
            // Near point lamp actually added on a ReSTIR pixel. The skip at the
            // top of this loop keeps the count at 0. Sun and flame stay out of
            // this word.
            if (restir_pix && !sun_lamp && k < list.suns.y + list.near.y && lamp_pick_diag()) {
                atomicAdd(restir_words[RESTIR_DIAG_POINT_ADD], 1u);
            }
#endif
            if (lobe) {
                vec3 ldir = target - origin;
                float llen = length(ldir);
                ldir = llen > LAMP_PICK_DEPTH_FLOOR ? ldir / llen : ns;
                if (two_sided && dot(ns, ldir) < 0.0) {
                    ldir = -ldir;
                }
                float ndl = max(dot(ns, ldir), 0.0);
                float ndv = max(dot(ns, view), 0.0);
                vec3 halfv = ldir + view;
                float hlen = length(halfv);
                halfv = hlen > DIRECT_DIR_EPS ? halfv / hlen : ns;
                float ndh = dot(ns, halfv);
                vec3 cx = cross(ns, halfv);
                float ncross = dot(cx, cx);
                float vdh = dot(view, halfv);
                // add already includes n·l. pbr_eval is f without that factor:
                // (1 − F) · base · (1 − metallic) / π + F · D · V, mixed by metallic.
                spec += pbr_eval(base, metal, rough, ndl, ndv, ndh, ncross, vdh) * add;
            }
            if (k < list.suns.y) {
                e_sun += add;
            }
        }
    }
#ifdef GENOS_RESTIR_DI
    // One reservoir sample: p(y) * V(y) * W, W = w_sum / (M * p_hat).
    // The graded colour is the mean of the unbiased sample. The raw sample
    // is one frame of that mean. Bitterli shows the current sample; a still
    // surface keeps the mean so the picture can converge. A lamp change, a
    // failed reprojection, or a change in this sample's visibility or
    // unshadowed target drops it. The sun and the flame stay in e.
    vec3 e_restir = vec3(0.0);
    vec3 spec_restir = vec3(0.0);
    bool restir_sampled = false;
    float restir_luma = 0.0;
    bool restir_vis = false;
    if (restir_pix && restir_w > 0.0 && (view_only == LAMP_ALL || view_only == restir_scene)
        && restir_lamp < restir_words[0u]) {
        restir_sampled = true;
        if (lamp_pick_diag()) {
            atomicAdd(gstats.diag[59u], 1u);
        }
        uint la = restir_words[1u] + restir_lamp * 8u;
        Lamp rl;
        rl.pos = vec4(uintBitsToFloat(restir_words[la]), uintBitsToFloat(restir_words[la + 1u]), uintBitsToFloat(restir_words[la + 2u]), 0.0);
        rl.color = vec4(uintBitsToFloat(restir_words[la + 4u]), uintBitsToFloat(restir_words[la + 5u]), uintBitsToFloat(restir_words[la + 6u]), uintBitsToFloat(restir_words[la + 3u]));
        vec3 rt;
        vec3 rlight = lamp_light(rl, origin, n, two_sided, rt);
        if (rlight.r + rlight.g + rlight.b > 0.0) {
            // Same pixel-ray probe as the shade loop (diag 48). A shadows-off
            // frame does not trace and does not count. The unshadowed luma
            // stays even when the ray is blocked: the mean compares that
            // target, and the visibility bit, with the stored sample.
            bool shadows_on = (gstats.ctrl_bits & 2u) != 0u;
            bool rvis = true;
            restir_luma = rlight.r + rlight.g + rlight.b;
            if (shadows_on) {
                rvis = !trace_occluded(origin, rt);
                if (lamp_pick_diag()) {
                    atomicAdd(gstats.diag[48u], 1u);
                }
            }
            restir_vis = rvis;
            if (rvis) {
                e_restir = rlight * restir_w;
                e += e_restir;
                // The lobe picture is `spec`. The raw sample is irradiance, so
                // the same Appendix B mix as the shade loop has to land in spec
                // or a specular product frame drops the reservoir.
                if (lobe) {
                    vec3 ldir = rt - origin;
                    float llen = length(ldir);
                    ldir = llen > LAMP_PICK_DEPTH_FLOOR ? ldir / llen : ns;
                    if (two_sided && dot(ns, ldir) < 0.0) {
                        ldir = -ldir;
                    }
                    float ndl = max(dot(ns, ldir), 0.0);
                    float ndv = max(dot(ns, view), 0.0);
                    vec3 halfv = ldir + view;
                    float hlen = length(halfv);
                    halfv = hlen > DIRECT_DIR_EPS ? halfv / hlen : ns;
                    float ndh = dot(ns, halfv);
                    vec3 cx = cross(ns, halfv);
                    float ncross = dot(cx, cx);
                    float vdh = dot(view, halfv);
                    spec_restir = pbr_eval(base, metal, rough, ndl, ndv, ndh, ncross, vdh) * e_restir;
                    spec += spec_restir;
                }
            }
        }
    }
#endif
    n = n_hit;
    if ((lighting_toggles() & LIGHTING_TOGGLE_BOUNCE_ONLY) != 0u) {
        e = vec3(0.0);
        e_sun = vec3(0.0);
        spec = vec3(0.0);
    }
    if (tdl != ~0u && (lighting_toggles() & LIGHTING_TOGGLE_BOUNCE_ONLY) == 0u) {
        uint ts = tdl & 0x3FFFFFFFu;
        if (tdl_check) {
            // Confirm: within LIGHTING_TDL_TOL of the cached value -> keep it,
            // nudged towards the check (an unbiased estimate, so drift is
            // tracked), under the new signature. Else escalate: the entry is
            // dropped and the next use recomputes it exactly (budget); this
            // hit takes the check's estimate.
            vec4 d = cache.v[LIGHTING_TDL_AT + ts];
            vec3 c = lighting_unpack_rgb9e5(floatBitsToUint(d.x));
            float lc = dot(c, vec3(0.2126, 0.7152, 0.0722));
            float le = dot(e, vec3(0.2126, 0.7152, 0.0722));
            if (abs(le - lc) <= LIGHTING_TDL_TOL * max(max(le, lc), 1.0e-3)) {
                lighting_dg(48u, 1u);
                vec3 m = mix(c, e, 0.25);
                cache.v[LIGHTING_TDL_AT + ts] = vec4(uintBitsToFloat(lighting_pack_rgb9e5(m)), d.y, uintBitsToFloat(tdl_sig), uintBitsToFloat(lighting_frame()));
                e = m;
                e_sun = m * d.y;
            } else {
                lighting_dg(49u, 1u);
                cache.v[LIGHTING_TDL_AT + ts].z = 0.0;
            }
        } else if ((tdl & 0x80000000u) != 0u) {
            vec4 d = cache.v[LIGHTING_TDL_AT + ts];
            e = lighting_unpack_rgb9e5(floatBitsToUint(d.x));
            e_sun = e * d.y;
        } else {
            float le = dot(e, vec3(0.2126, 0.7152, 0.0722));
            float fs = le > 0.0 ? clamp(dot(e_sun, vec3(0.2126, 0.7152, 0.0722)) / le, 0.0, 1.0) : 0.0;
            cache.v[LIGHTING_TDL_AT + ts] = vec4(uintBitsToFloat(lighting_pack_rgb9e5(e)), fs, uintBitsToFloat(tdl_sig), uintBitsToFloat(lighting_frame()));
        }
    }
#ifdef GENOS_RESTIR_DI
    // Cumulative mean of the unbiased reservoir sample, visibility included.
    // The three floats are the slot this shade already wrote. No second
    // buffer. The shadow ray above re-traces the stored sample when the
    // reservoir kept that lamp. A different lamp traces the stored one once.
    // History uses lamp_pick_reproject (0.02 / 0.05 m / 0.9), one pixel, and
    // drops when the reservoir resets (word 15), any lamp changed (word 39),
    // or the re-traced sample's visibility or unshadowed target changed.
    // That check runs before the cap, so a frozen mean still drops. At
    // RESTIR_MEAN_CAP the colour otherwise stays, so a still surface stops
    // moving. The mean of one fixed integrand stays unbiased: temporal
    // correlation changes the variance. Mixing two visibilities was the bias.
    // The lobe off, the sample is irradiance. The lobe on, it is this frame's
    // Appendix B outgoing radiance. Averaging irradiance and then showing this
    // frame's lobe leaves the picture on one lamp. The noise gate has its own
    // mean and does not read this one. A bounce-only frame does not write it
    // into the picture and does not fold a zero into the stored mean.
    if (restir_pix && lamp_pix) {
        uint mean_px = 0u;
        float z_ignore = 0.0;
        uint mean_prev = 0u;
        vec3 drawn = lobe ? spec_restir : e_restir;
        vec3 mean_e = drawn;
        uint prev_pack = RESTIR_MEAN_NO_LAMP;
        // One slot is read and written in this dispatch. History is this
        // pixel only, and the geo load stops before a neighbour. Two slots
        // leave the previous frame alone, so a reprojected neighbour is safe.
        uint mean_only = lamp_res_one_slot() ? idx : ~0u;
        if (restir_words[15u] == 0u && restir_words[39u] == 0u && lamp_pick_reproject_at(pos, n, mean_only, mean_px, z_ignore)) {
            uvec4 hg = lamp_geo_load(mean_px, lamp_res_slot_prev());
            if (hg.z == LAMP_GEO_RESTIR_MEAN) {
                LampReservoir pr = lamp_res_load(mean_px, lamp_res_slot_prev());
                mean_prev = pr.m;
                mean_e = vec3(pr.w_sum, pr.target, uintBitsToFloat(hg.w));
                prev_pack = pr.lamp;
            }
        }
        // Re-trace the stored sample before the cap. A moving occluder passes
        // reprojection and changes no lamp, and a frozen mean would keep the
        // old shadow. The shade ray is reused when the lamp matches.
        bool mean_dropped = false;
        if (mean_prev > 0u) {
            uint old_lamp = prev_pack & 0xffffu;
            bool old_vis = (prev_pack & 0x10000u) != 0u;
            uint old_q = prev_pack >> 17u;
            if (old_lamp != RESTIR_MEAN_NO_LAMP && old_lamp < restir_words[0u]) {
                float luma_now = 0.0;
                bool vis_now = false;
                if (restir_sampled && restir_lamp == old_lamp) {
                    luma_now = restir_luma;
                    vis_now = restir_vis;
                } else {
                    // A different lamp from the one stored. One shadow ray,
                    // and only when that lamp still reaches this point.
                    uint la = restir_words[1u] + old_lamp * 8u;
                    Lamp old_l;
                    old_l.pos = vec4(uintBitsToFloat(restir_words[la]), uintBitsToFloat(restir_words[la + 1u]), uintBitsToFloat(restir_words[la + 2u]), 0.0);
                    old_l.color = vec4(uintBitsToFloat(restir_words[la + 4u]), uintBitsToFloat(restir_words[la + 5u]), uintBitsToFloat(restir_words[la + 6u]), uintBitsToFloat(restir_words[la + 3u]));
                    vec3 old_target;
                    vec3 old_light = lamp_light(old_l, origin, n, two_sided, old_target);
                    luma_now = old_light.r + old_light.g + old_light.b;
                    if (luma_now > 0.0) {
                        if ((gstats.ctrl_bits & 2u) == 0u) {
                            vis_now = true;
                        } else {
                            vis_now = !trace_occluded(origin, old_target);
                            if (lamp_pick_diag()) {
                                atomicAdd(gstats.diag[48u], 1u);
                            }
                        }
                    }
                }
                if (vis_now != old_vis || restir_mean_target_moved(old_q, luma_now)) {
                    mean_dropped = true;
                    mean_prev = 0u;
                    mean_e = drawn;
                }
            }
        }
        vec3 e_mean = drawn;
        uint mean_n = 1u;
        if (mean_prev >= RESTIR_MEAN_CAP) {
            e_mean = mean_e;
            mean_n = RESTIR_MEAN_CAP;
        } else if (!restir_sampled && mean_prev > 0u) {
            e_mean = mean_e;
            mean_n = mean_prev;
        } else if (mean_prev > 0u) {
            mean_n = mean_prev + 1u;
            e_mean = mean_e + (drawn - mean_e) / float(mean_n);
        } else if (mean_dropped && !restir_sampled) {
            // The stored sample changed and this frame drew none. Count 1
            // of black would be a sample that was not taken.
            e_mean = vec3(0.0);
            mean_n = 0u;
        }
        LampReservoir mr;
        if (restir_sampled) {
            mr.lamp = restir_mean_pack(restir_lamp, restir_vis, restir_luma);
        } else if (mean_prev > 0u) {
            mr.lamp = prev_pack;
        } else {
            mr.lamp = RESTIR_MEAN_NO_LAMP;
        }
        mr.m = mean_n;
        mr.w_sum = e_mean.r;
        mr.target = e_mean.g;
        uint mslot = lamp_res_slot_now();
        lamp_res_store(idx, mslot, mr);
        lamp_geo_store(idx, mslot, uvec4(floatBitsToUint(max(lamp_pick_depth(pos), LAMP_PICK_DEPTH_FLOOR)), lighting_pack_normal(n), LAMP_GEO_RESTIR_MEAN, floatBitsToUint(e_mean.b)));
        bool bounce_only = (lighting_toggles() & LIGHTING_TOGGLE_BOUNCE_ONLY) != 0u;
        if (!bounce_only && !lamp_pick_hold_off() && (restir_sampled || mean_prev > 0u)) {
            if (lobe) {
                spec = spec - spec_restir + e_mean;
            } else {
                e = e - e_restir + e_mean;
            }
        }
    }
#endif
    // Hold off: the displayed colour is the running mean of the unbiased sample.
    // The lobe off, that sample is irradiance (`light * W * visibility`) and
    // compose applies the Lambert weight. The lobe on, it is this frame's
    // Appendix B outgoing radiance (`pbr_eval` times that irradiance). Bitterli
    // shows the current sample. This mean is only while the noise gate has the
    // exact-sum hold off, so a still picture can be graded. Past
    // LAMP_PICK_MEAN_CAP the colour stays and the pixel keeps tracing.
    // Production does not set the bit. Averaging irradiance and then showing
    // this frame's lobe leaves the picture on one lamp.
    if (idx < pixels && lamp_pix && lamp_pick_hold_off() && !shade_exact && chosen_n > 0u) {
        uint hist_px = 0u;
        float z_ignore = 0.0;
        uint prev_count = 0u;
        vec3 shaded = lobe ? spec : e;
        vec3 prev = shaded;
        if (lamp_pick_reproject(pos, n, hist_px, z_ignore)) {
            uvec4 hg = lamp_geo_load(hist_px, lamp_res_slot_prev());
            if (hg.z == LAMP_GEO_RESTIR) {
                LampReservoir prev_res = lamp_res_load(hist_px, lamp_res_slot_prev());
                // The hold-off path stores the mean length in the low 24 bits.
                // The high 8 bits only count to 255, which froze a short mean.
                // Hold-off stores the mean as three floats, not rgb9e5.
                prev_count = lamp_res_samples(prev_res);
                if (prev_count > 0u) {
                    prev = vec3(prev_res.w_sum, prev_res.target, uintBitsToFloat(hg.w));
                }
            }
        }
        if (prev_count == 0u) {
            mean_count = 1u;
        } else if (prev_count >= LAMP_PICK_MEAN_CAP) {
            shaded = prev;
            mean_count = LAMP_PICK_MEAN_CAP;
        } else {
            mean_count = prev_count + 1u;
            shaded = prev + (shaded - prev) / float(mean_count);
        }
        if (lobe) {
            spec = shaded;
        } else {
            e = shaded;
        }
    }
    if (idx < pixels && pc.lamp.x == 4u && lamp_pix) {
        // The exact sum is the integral. A quiet pixel retraces it. Stamping a
        // hold count in the high byte of m used to skip the next frames.
        uint slot = lamp_res_slot_now();
        if (shade_exact) {
            LampReservoir cur;
            cur.lamp = 0u;
            cur.w_sum = uintBitsToFloat(pix_sig);
            cur.m = 1u;
            cur.target = 0.0;
            uvec4 geo = uvec4(floatBitsToUint(max(lamp_pick_depth(pos), LAMP_PICK_DEPTH_FLOOR)), lighting_pack_normal(n), LAMP_GEO_EXACT, lighting_pack_rgb9e5(e));
            lamp_res_store(idx, slot, cur);
            lamp_geo_store(idx, slot, geo);
            if (lamp_pick_diag()) {
                atomicAdd(gstats.diag[58u], 1u);
            }
        } else if (chosen_n > 0u) {
            LampReservoir cur = lamp_res_load(idx, slot);
            if (cur.lamp != LAMP_ALL) {
                uint color_word = lighting_pack_rgb9e5(e);
                if (lamp_pick_hold_off()) {
                    // Full-precision mean of the displayed sample. The lobe
                    // stores outgoing radiance; off stores irradiance. w_sum
                    // and target are free: this path does not merge, and the
                    // picture quantizes once below.
                    vec3 mean_rgb = lobe ? spec : e;
                    cur.m = mean_count;
                    cur.w_sum = mean_rgb.r;
                    cur.target = mean_rgb.g;
                    color_word = floatBitsToUint(mean_rgb.b);
                } else {
                    cur.m = lamp_res_samples(cur);
                }
                lamp_res_store(idx, slot, cur);
                lamp_geo_store(idx, slot, uvec4(floatBitsToUint(max(lamp_pick_depth(pos), LAMP_PICK_DEPTH_FLOOR)), lighting_pack_normal(n), LAMP_GEO_RESTIR, color_word));
                if (lamp_pick_diag()) {
                    atomicAdd(gstats.diag[59u], 1u);
                }
            }
        }
    }
    if (idx < pixels) {
        uint emitted = gbuf_word(idx, 3u);
        uint glow = emitted == ~0u || (gstats.ctrl_bits & 512u) == 0u ? 0u : emitted;
        uint prev_e = outc.px[pixels + idx];
        // Off: irradiance, and compose applies the Lambert weight.
        // On: Appendix B outgoing radiance (pbr_eval already folded n·l into add).
        vec3 shown = e;
        if (lobe) {
            shown = spec;
        }
        uint packed = lighting_pack_rgb9e5(shown);
        uint prev_d = 0u;
        uint prev_sig = 0u;
        bool tracked = lighting_pix_reuse_on();
        if (tracked) {
            uint c = (idx & 1u) * 2u;
            prev_sig = floatBitsToUint(work.v[lighting_pix_at() + idx / 2u][c]);
            prev_d = floatBitsToUint(work.v[lighting_pix_at() + idx / 2u][c + 1u]);
        }
        outc.px[pixels + idx] = glow;
        gbuf.words[idx * 5u + 3u] = packed;
        if (tracked) {
            uint c = (idx & 1u) * 2u;
            work.v[lighting_pix_at() + idx / 2u][c] = uintBitsToFloat(pix_sig);
            work.v[lighting_pix_at() + idx / 2u][c + 1u] = uintBitsToFloat(packed);
            // Packed direct moved because the sun did. The sun compose writes
            // this frame's direct on every pixel. The block is not a GI dirty.
            // Flag off: same mark.
            bool sun_only = lighting_sun_small() && glow == prev_e && pix_sig == prev_sig;
            if (!sun_only && (glow != prev_e || packed != prev_d || pix_sig != prev_sig)) {
                lighting_compose_mark_px(idx);
            }
        }
        if (gstats.ctrl_history != 0u) {
            outc.px[pixels * 2u + idx] = packed;
        }
    } else {
        lighting_hit_sunfrac = 0.0;
        lighting_bounce_path = 2u;
        lighting_hit_kind = 1u;
        if ((gstats.ctrl_bits & 512u) == 0u) {
            glow = vec3(0.0);
        }
        lighting_gather_strict = lighting_lamp_settling();
        vec3 bounce = lighting_gi_on() ? lighting_cache_irradiance_at(pos, n, hit_t) : vec3(0.0);
        lighting_gather_strict = false;
        e += bounce;
        e_sun += lighting_hit_sunfrac * bounce;
        // w: its sun/sky share as luminance (S63A).
        work.v[lighting_rad_at(ray)] = vec4(reflectance * e + glow, dot(reflectance * e_sun, vec3(0.2126, 0.7152, 0.0722)));
    }
}
