#version 450
#define GENOS_SUN_SHADER 1
// GI v2 direct light: every lamp at a surface point, each with a shadow ray through
// the tracer. The points are the picture's pixels (G-buffer) followed by every kept
// hit of the screen probes (all strata, so a kept hit always carries this frame's
// light: no light history), the light cache's ray hits and the probes' fills, so all share this loop
// and its one trace site. A pixel keeps its irradiance; a hit adds the light cache's bounced
// irradiance and turns the sum into the light it sends back along the ray, plus
// any light the surface emits. A pixel's emitted light (G-buffer w from the
// raster) moves to the output buffer for the final pass.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "lighting_common.glsl"

const bool LIGHTING_KEPT_SHOULD = true;
// S78Q: a kept light that changed marks its probe's gather (lighting_gdirty).
const bool LIGHTING_KEPT_HYST = false; // S78T: off pending re-test (S78S)
const float LIGHTING_KEPT_TOL = 0.02;
void lighting_put_kept_light_d(uint h, vec3 light, uint src) {
    uint v = lighting_pack_rgb9e5(light);
    uint at = lighting_kept_light_at() + h / 4u;
    uint ov = floatBitsToUint(work.v[at][h % 4u]);
    if ((lighting_toggles() & LIGHTING_TOGGLE_FREEZE_PROBES) != 0u) {
        return;
    }
    lighting_chg(CHG_KEPT_WRITE, 1u);
    lighting_chg(CHG_KB_FINE + lighting_bounce_path, 1u);
    // S78T: a kept light within LIGHTING_KEPT_TOL of the stored one keeps the
    // stored value (hysteresis): sub-noise moves of the cache texels under the
    // hits (still scene: ~740 texel writes a frame, each read by ~9 hits) no
    // longer change the probes' inputs, so their gathers hold (S78R). The stored
    // value moves once the light is LIGHTING_KEPT_TOL away from it, so no drift.
    if (LIGHTING_KEPT_HYST && ov != v) {
        vec3 o = lighting_unpack_rgb9e5(ov);
        float lo = dot(o, vec3(0.2126, 0.7152, 0.0722));
        float ln = dot(light, vec3(0.2126, 0.7152, 0.0722));
        if (abs(ln - lo) <= LIGHTING_KEPT_TOL * max(max(lo, ln), 1.0e-3)) {
            lighting_chg(CHG_KEPT_HELD, 1u);
            return;
        }
    }
    if (ov != v) {
        lighting_chg(CHG_KC_FINE + lighting_bounce_path, 1u);
        lighting_chg(CHG_KEPT_CHANGED, 1u);
        lighting_chg(CHG_KEPT_D0 + lighting_chg_bin(lighting_unpack_rgb9e5(ov), light), 1u);
        lighting_chg(CHG_KEPT_TDL_REUSE + src, 1u);
        if (LIGHTING_GATHER_HOLD) {
            lighting_gdirty_mark(h / lighting_rays() / LIGHTING_STRATA);
        }
    }
    work.v[at][h % 4u] = uintBitsToFloat(v);
}
// S78U (root cause from S78S: 100 % of still-scene kept-light changes were
// the held probe's check ray, relit fresh while its other held hits kept their
// last light, so the converging surface cache read as a change every frame).
// The check ray of a held probe whose hit did not move is a test, not a
// rewrite: its relit light replaces the stored one only when it differs by
// more than LIGHTING_CHECK_K standard errors of the hit texel's mean (the
// MSME estimator's per-set variance / sets, lighting_sc_noise), scaled by the
// hit's reflectance, plus a quantisation floor. Drift of the shared field
// within its own noise no longer changes a probe (Anthony: probes do not wake
// from shared-cache convergence). Unknown noise (estimator not running: new
// texel or light changing) writes as before.
const bool LIGHTING_CHECK_NOISE = true;
const float LIGHTING_CHECK_K = 3.0;
const float LIGHTING_CHECK_FLOOR = 0.01;
bool lighting_check_within_noise(uint h, vec3 pos, vec3 n, vec3 refl, vec3 light) {
    if (!LIGHTING_CHECK_NOISE || lighting_world_mode() != 3u) {
        return false;
    }
    uint rays = lighting_rays();
    uint pk = h / rays / LIGHTING_STRATA;
    uint s = (h / rays) % LIGHTING_STRATA;
    if (s != lighting_stratum() || !lighting_stratum_held(pk) || h % rays != lighting_hold_check_k(pk)) {
        return false;
    }
    // The trace's check failed (hit moved): a real change.
    if (floatBitsToUint(work.v[lighting_probe_at(pk) + 1u].w) == lighting_frame() + LIGHTING_STRATA) {
        return false;
    }
    uint ts = lighting_cache_find_sized(pos, n, false, LIGHTING_SC_TEXEL, pos);
    if (ts == ~0u) {
        return false;
    }
    vec2 nz = lighting_sc_noise(ts);
    if (nz.x < 0.0) {
        return false;
    }
    vec3 lw = vec3(0.2126, 0.7152, 0.0722);
    uint at = lighting_kept_light_at() + h / 4u;
    float lo = dot(lighting_unpack_rgb9e5(floatBitsToUint(work.v[at][h % 4u])), lw);
    float ln = dot(light, lw);
    float bound = LIGHTING_CHECK_K * nz.y * dot(refl, lw) + LIGHTING_CHECK_FLOOR * max(lo, ln);
    return abs(ln - lo) <= bound;
}
void main() {
    lighting_sun_mark();
    uint idx = gl_GlobalInvocationID.x;
    uint pixels = pc.dims.x * pc.dims.y;
    uint mode = lighting_mode();
    uint kept = lighting_kept_hits();
    uint cache_rays = LIGHTING_CACHE_BATCH * LIGHTING_CACHE_RAYS;
    // Verification stride: thread i shades the check hit of that probe. The
    // kept-hit span of the grid is not launched.
    if (mode == 3u) {
        uint budget = gstats.wake_budget;
        uint nprobes = lighting_probes();
        uint period = max(nprobes / max(budget, 1u), 1u);
        uint probe = (pc.params.w % period) + idx * period;
        if (budget == 0u || probe >= nprobes) {
            return;
        }
        uint rays = lighting_rays();
        uint h = (probe * LIGHTING_STRATA + lighting_stratum()) * rays + lighting_hold_check_k(probe);
        idx = pixels + h;
    }
    // Pixel-only (GI off, or a coarser direct grid): leave before any work or
    // cache read. Mode 0's point count includes cache-ray slots, and the tail
    // of the last group would index the dummy buffers.
    if (gstats.ctrl_pixel_only != 0u) {
        uint scale = max(gstats.ctrl_scale, 1u);
        uint lw = (pc.dims.x + scale - 1u) / scale;
        uint lh = (pc.dims.y + scale - 1u) / scale;
        if (idx >= lw * lh) {
            return;
        }
        uint sx = (idx % lw) * scale;
        uint sy = (idx / lw) * scale;
        idx = sy * pc.dims.x + sx;
    } else if (lighting_dense()) {
        // S70A: this round's light cache rays only, live entries only.
        // Bias is a pixel skip for the kept-hit dispatch. Applying it here
        // pushes every dense thread past the live-entry count, so cache rays
        // never get lit and compose shows whatever was left in the buffers.
        if (idx >= lighting_dense_count() * LIGHTING_CACHE_RAYS) {
            return;
        }
        idx = pixels + kept + lighting_dense_entry(idx / LIGHTING_CACHE_RAYS) * LIGHTING_CACHE_RAYS + idx % LIGHTING_CACHE_RAYS;
    } else {
        if (gstats.ctrl_bias != 0u) {
            idx += gstats.ctrl_bias;
        }
        if (mode == 2u) {
            idx += pixels + kept;
        }
    }
    // Then (not on the async queue) one point per fill slot (lighting_fill_ray).
    uint fills = pixels + kept + (mode == 1u ? 0u : cache_rays);
    if (gstats.ctrl_pixel_only == 0u) {
        uint points = fills + (mode == 2u ? 0u : kept);
        if (idx >= points) {
            return;
        }
    }
    // A kept probe hit (index h), a light cache ray (ray) or a fill (index h).
    bool fill_hit = idx >= fills;
    bool probe_hit = (idx >= pixels && idx < pixels + kept) || fill_hit;
    uint h = fill_hit ? idx - fills : idx - pixels;
    uint ray = idx < pixels + kept || fill_hit ? 0u : lighting_probe_rays() + (idx - pixels - kept);
    vec3 pos;
    vec3 n;
    float hit_t = 1.0e9;
    vec3 reflectance = vec3(1.0);
    bool two_sided = false;
    vec3 glow = vec3(0.0);
    if (idx < pixels) {
        vec3 albedo;
        if (!lighting_surface(uvec2(idx % pc.dims.x, idx / pc.dims.x), pos, n, albedo, two_sided)) {
            return;
        }
    } else {
        vec4 rec;
        vec3 origin;
        vec3 dir;
        vec3 from_n;
        bool live;
        if (probe_hit) {
            uint rays = lighting_rays();
            uint ps = h / rays;
            if (fill_hit) {
                live = lighting_fill_ray(ps / LIGHTING_STRATA, ps % LIGHTING_STRATA, h % rays, origin, dir, from_n);
                if (!live) {
                    return;
                }
                rec = work.v[lighting_fill_at(h)];
                if (rec.x < -0.75) {
                    lighting_put_fill_light(h, has_sky() ? scene.sky.rgb : vec3(0.0));
                    return;
                }
            } else {
                rec = work.v[lighting_kept_at(h)];
                live = lighting_stratum_ray(ps / LIGHTING_STRATA, ps % LIGHTING_STRATA, h % rays, origin, dir, from_n);
                if (live && rec.x < -0.75) {
                    if (!lighting_sun_hold_kept(h)) {
                        vec3 sky_light = has_sky() ? scene.sky.rgb : vec3(0.0);
                        lighting_put_kept_light_d(h, sky_light, 2u);
                        lighting_wake_store_direct(h, sky_light);
                    }
                    return;
                }
            }
        } else {
            rec = work.v[lighting_hit_at(ray)];
            live = lighting_ray(ray, origin, dir, from_n);
        }
        if (rec.x < 0.0 || !live) {
            return;
        }
        pos = origin + dir * rec.x;
        hit_t = rec.x;
        n = lighting_unpack_normal(floatBitsToUint(rec.y));
        reflectance = unpackUnorm4x8(floatBitsToUint(rec.z)).rgb * (1.0 / LIGHTING_PI);
        glow = lighting_unpack_rgb9e5(floatBitsToUint(rec.w));
    }
    // S69C (Anthony: build-up starved; GENOS_GPU_TIMES, default stress scene at
    // 1920x1080: this pass was 70 % of the frame and the kept hits of all
    // LIGHTING_STRATA strata, relit every frame, ~10 ms of it). A kept hit is relit
    // the frame its stratum is traced and once more halfway round
    // (LIGHTING_KEPT_RELIGHT), so its light is at most LIGHTING_STRATA / 2 frames old;
    // near a change (a mover, re-traced kept rays) every frame as before.
    if (LIGHTING_KEPT_RELIGHT && probe_hit && !fill_hit) {
        uint s = (h / lighting_rays()) % LIGHTING_STRATA;
        uint cur = lighting_stratum();
        bool urgent = ((pc.params.z >> 5u) & 1u) != 0u;
        if (s != cur && s != (cur + LIGHTING_STRATA / 2u) % LIGHTING_STRATA && !(urgent && lighting_near_change(pos))) {
            return;
        }
        // S78D: the halfway relight only where the light should have moved: a
        // lamp that moved reaches the hit since its trace, or the sun / sky
        // changed by more than 1 % (a change near a mover is relit above).
        // S78K: a held probe's current stratum: only the rays re-traced this
        // frame (its check, change crossings) are new hits; the rest are lit
        // as the halfway relight below.
        uint pk = h / lighting_rays() / LIGHTING_STRATA;
        bool held_old = s == cur && lighting_stratum_held(pk);
        if (held_old) {
            vec3 ho;
            vec3 hd;
            vec3 hnn;
            lighting_stratum_ray(pk, s, h % lighting_rays(), ho, hd, hnn);
            held_old = !lighting_held_traced(pk, h % lighting_rays(), ho, hd, hit_t);
            // S78U: the check ray whose trace confirmed its hit is relit like
            // the other held hits (only when a lamp / the sun moved): a drift
            // of the shared surface cache is no reason to change the probe.
            if (!held_old && LIGHTING_CHECK_NOISE && h % lighting_rays() == lighting_hold_check_k(pk)
                && floatBitsToUint(work.v[lighting_probe_at(pk) + 1u].w) != lighting_frame() + LIGHTING_STRATA
                && !lighting_held_crosses(ho, hd, hit_t)) {
                held_old = true;
            }
            // A ring test, a verification sample, or a full wake has to shade.
            // The legacy noise skip would hide the lamp change the ring is scoring.
            if (lighting_wake_relight(h)) {
                held_old = false;
            }
        }
        // After a point lamp stops, a few frames shade every kept stratum so the
        // corner is not waiting on the halfway relight. The word is 0 otherwise,
        // and this is the S69C skip.
        if (!lighting_catch_up() && LIGHTING_KEPT_SHOULD && (s != cur || held_old) && lighting_pix_cache_ok() && !(urgent && lighting_near_change(pos))) {
            uint traced = lighting_frame() - LIGHTING_STRATA / 2u;
            // A live ring does not reshade a kept hit only because a lamp
            // moved. That shade was the direct pass. A woken probe and its
            // check ray still shade; the probe filter spreads them. With no
            // event queued, rings uses the same lamp-range test as legacy, so
            // a still scene's probes match before the idle freezes them.
            // The sun ratio stays, so a day change still tracks.
            bool sparse = gstats.wake_mode != 0u && gstats.wake_events != 0u && !lighting_wake_relight(h);
            if (sparse) {
                if (abs(lighting_ls_ratio(traced) - 1.0) <= 0.01) {
                    return;
                }
            } else if (!lighting_wrc_lamp_changed(pos, traced) && abs(lighting_ls_ratio(traced) - 1.0) <= 0.01) {
                return;
            }
        }
    }
    if (probe_hit && !fill_hit && lighting_sun_hold_kept(h)) {
        return;
    }
    if (fill_hit && lighting_sun_hold_fill(h)) {
        return;
    }
    vec3 origin = pos + n * 0.02;
    LampList list = lamps_at(origin);
    uint count = lamp_list_size(list);
    // S78J: a pixel whose point and lamps match last frame's, in a quiet frame.
    uint pix_sig = 0u;
    if (lighting_pix_reuse_on() && idx < pixels) {
        pix_sig = lighting_pix_sig(pos, n, two_sided, list);
        vec4 pv = work.v[lighting_pix_at() + idx / 2u];
        uint c = (idx & 1u) * 2u;
        // A small sun step still traces. Reusing last frame's direct would
        // leave the sun and its shadow a frame behind.
        if (pix_sig != 0u && floatBitsToUint(pv[c]) == pix_sig && lighting_pix_quiet() && !lighting_sun_small()) {
            uint emitted = gbuf.px[idx].w;
            uint glow = emitted == ~0u || (gstats.ctrl_bits & 512u) == 0u ? 0u : emitted;
            uint prev = outc.px[pixels + idx];
            // Emitted stays out of the picture buffer; compose reads it here.
            outc.px[pixels + idx] = glow;
            gbuf.px[idx].w = floatBitsToUint(pv[c + 1u]);
            if (glow != prev) {
                lighting_compose_mark_px(idx);
            }
            return;
        }
    }
    // S75 Lumen surface-cache direct lighting for hits (lighting_cache.glsl).
    // A still verification check is shaded only so the vote can run. It must
    // not take a cache budget slot or write the texel: legacy does not shade
    // this hit, and those writes moved the still picture.
    bool vote_only = gstats.wake_mode != 0u && gstats.wake_events == 0u && lighting_wake_relight(h);
    uint tdl = ~0u;
    uint tdl_sig = 0u;
    vec3 n_hit = n;
    if (LIGHTING_TDL && idx >= pixels && lighting_world_mode() == 3u) {
        uint ts = lighting_cache_find_sized(pos, n, false, LIGHTING_SC_TEXEL, pos);
        vec3 tp;
        vec3 tn;
        if (ts != ~0u && lighting_sc_texel_world(ts, tp, tn)) {
            LampList tl = lamps_at(tp + tn * 0.02);
            tdl_sig = lighting_tdl_sig(ts, tl);
            vec4 d = cache.v[LIGHTING_TDL_AT + ts];
            if (tdl_sig != 0u && floatBitsToUint(d.z) == tdl_sig && lighting_frame() - floatBitsToUint(d.w) < LIGHTING_TDL_STALE) {
                count = 0u;
                tdl = ts | 0x80000000u;
                lighting_dg(40u, 1u);
            } else if (LIGHTING_TDL_CHECK && tdl_sig != 0u && floatBitsToUint(d.z) != 0u) {
                // S78E: an entry past LIGHTING_TDL_STALE (same signature) is checked
                // like a changed one, not recomputed: age alone is no reason.
                // S76C: a lamp in range changed (the signature moved): a check,
                // the texel's light with picked lamps (LIGHTING_CACHE_PICKS shadow
                // rays) at its centre, against the cached value.
                lighting_dg(47u, 1u);
                tdl = ts | 0x40000000u;
                origin = tp + tn * 0.02;
                n = tn;
                list = tl;
                count = lamp_list_size(list);
            } else if (!vote_only && tdl_sig != 0u && atomicAdd(ckeys.key[LIGHTING_TDL_COUNT_AT], 1u) < LIGHTING_TDL_BUDGET) {
                lighting_dg(41u, 1u);
                tdl = ts;
                origin = tp + tn * 0.02;
                n = tn;
                list = tl;
                count = lamp_list_size(list);
            }
        }
    }
    // Light cache rays (params.z bit 11): at most LIGHTING_CACHE_PICKS shadow rays,
    // lamps picked systematically in proportion to their unshadowed light, each
    // weighted by how often it is expected to be picked (unbiased, as
    // lamps_light_only). The pick offset hangs on the patch and the ray, so a
    // still scene relights to the same value.
    // S60: the screen probes' hits (kept strata and fills) pick lamps the same way
    // (LIGHTING_PROBE_PICKS): every kept hit of all LIGHTING_STRATA strata is relit every
    // frame, so with every lamp shadow-traced the light pass was ~65 % of the
    // frame (GENOS_GPU_TIMES). Lumen's final gather never shadow-traces lamps at
    // probe hits (it reads the surface cache's lit cards); stochastic lamp
    // selection in proportion to unshadowed light (as MegaLights / ReSTIR DI) is
    // the step that keeps our per-hit direct light.
    bool cache_pick = idx >= pixels + kept && !fill_hit && ((pc.params.z >> 11u) & 1u) != 0u;
    bool probe_pick = LIGHTING_PROBE_PICKS && probe_hit && ((pc.params.z >> 11u) & 1u) != 0u;
    bool tdl_check = tdl != ~0u && (tdl & 0x40000000u) != 0u;
    bool pick = ((cache_pick || probe_pick) && tdl == ~0u) || tdl_check;
    float total = 0.0;
    uint lit = 0u;
    float u = 0.0;
    if (pick) {
        if (cache_pick) {
            uint r = ray - lighting_probe_rays();
            uint ent = r / LIGHTING_CACHE_RAYS;
            if (lighting_world_mode() == 3u && ent >= lighting_grad_first() && ent < LIGHTING_CACHE_BATCH - LIGHTING_WRC_SCOUT_ENTRIES) {
                // S74A gradient check: the stored ray's lamp pick (same seed).
                uint gs = ckeys.key[LIGHTING_GRAD_LIST_AT + r - lighting_grad_first() * LIGHTING_CACHE_RAYS];
                u = lighting_unit(ckeys.key[gs] ^ (floatBitsToUint(cache.v[LIGHTING_SC_GRAD_AT + gs].w) * 0x85ebca6bu + 0x5bd1e995u));
            } else {
            uint slot = lighting_cache_batch_slot(ent);
            uint key = slot == ~0u ? 0u : ckeys.key[slot];
            uint q = slot == ~0u ? 0u : lighting_cache_entry_quarter(ent, slot);
            u = lighting_unit(key ^ ((q * LIGHTING_CACHE_RAYS + r % LIGHTING_CACHE_RAYS) * 0x85ebca6bu + 0x5bd1e995u));
            }
        } else if (tdl_check) {
            u = lighting_unit(lighting_hash((tdl & 0x3FFFFFFFu) ^ lighting_frame() * 0x9e3779b9u));
        } else {
            // A probe hit: the offset hangs on the hit's 25 cm cell and its index,
            // so a still hit relights to the same value (no crawl).
            u = lighting_unit(lighting_cell_hash(pos, n) ^ (h * 0x85ebca6bu + 0x27d4eb2fu));
        }
        [[dont_unroll]] for (uint k = 0u; k < count; k++) {
            if (gstats.ctrl_max_lights != 0u && k >= gstats.ctrl_max_lights) {
                break;
            }
            vec3 target;
            vec3 light = lamp_light(lamp_list_get(list, k), origin, n, two_sided, target);
            float w = light.r + light.g + light.b;
            total += w;
            lit += w > 0.0 ? 1u : 0u;
        }
    }
    // Hits outside this frame's slice keep the committed sun. Pixels use the live sun.
    bool sun_hold = false;
    bool sun_slice = false;
    if (lighting_sun_small() && idx >= pixels) {
        if (probe_hit) {
            uint pk = h / lighting_rays() / LIGHTING_STRATA;
            sun_slice = lighting_sun_probe_slice(pk);
            sun_hold = !sun_slice;
        } else {
            uint ent = (ray - lighting_probe_rays()) / LIGHTING_CACHE_RAYS;
            uint slot = lighting_cache_batch_slot(ent);
            sun_slice = slot != ~0u && lighting_sun_slot_slice(slot);
            sun_hold = slot != ~0u && !sun_slice;
        }
    }
    bool exact = !pick || lit <= LIGHTING_CACHE_PICKS;
    float step = total / float(LIGHTING_CACHE_PICKS);
    float run = 0.0;
    vec3 e = vec3(0.0);
    vec3 e_sun = vec3(0.0);
    [[dont_unroll]] for (uint k = 0u; k < count; k++) {
        if (gstats.ctrl_max_lights != 0u && k >= gstats.ctrl_max_lights) {
            break;
        }
        Lamp sun_lamp_l = lamp_list_get(list, k);
        bool sun_lamp = sun_lamp_l.pos.w > 0.5;
        if (sun_hold && sun_lamp) {
            vec3 d = lighting_sun_committed_dir();
            float d2 = dot(d, d);
            if (d2 > 0.5) {
                sun_lamp_l.pos.xyz = d * inversesqrt(d2);
            }
        }
        vec3 target;
        vec3 light = lamp_light(sun_lamp_l, origin, n, two_sided, target);
        float w = light.r + light.g + light.b;
        if (w <= 0.0) {
            continue;
        }
        float times = 1.0;
        if (!exact) {
            float before = ceil(run / step - u);
            run += w;
            times = ceil(run / step - u) - before;
        }
        // S74A: hits (not pixels) reuse a static lamp's shadow (lighting_cache.glsl).
        // Shadows off skips the trace and the cell. Hard traces every time.
        bool shadow_lit = false;
        bool shadows_on = (gstats.ctrl_bits & 2u) != 0u;
        if (!shadows_on) {
            shadow_lit = times > 0.0;
        } else if (times > 0.0) {
            uint li = idx >= pixels ? lamp_list_index(list, k) : LAMP_ALL;
            // Probe-only keeps the real cache buffer, so the cell still applies.
            // No probes and no world cache is a dummy: do not index it.
            // High is mode 3, the same branch as before this gate.
            bool probes_on = (gstats.ctrl_bits & 16u) != 0u;
            bool cache_on = (gstats.ctrl_bits & 32u) != 0u;
            bool cell_stored = lighting_world_mode() == 3u || (!cache_on && probes_on);
            bool cell = (gstats.ctrl_bits & 2048u) == 0u && lighting_gi_on() && cell_stored && li < LAMP_ALL - 1u;
            // The slice retraces the live sun and does not write that bit
            // over the committed epoch. Flag off: the cell is the old path.
            float sc = cell ? lighting_shadow_get(origin, n, li) : -1.0;
            if (sun_slice && sun_lamp) {
                sc = -1.0;
            }
            if (sc >= 0.0) {
                shadow_lit = sc > 0.5;
            } else {
                shadow_lit = !trace_occluded(origin, target);
                if (cell && !vote_only && !(lighting_sun_small() && sun_lamp)) {
                    lighting_shadow_put(origin, n, li, shadow_lit);
                }
            }
        }
        if (shadow_lit) {
            vec3 add = exact ? light : light * (times * step / w);
            e += add;
            if (k < list.suns.y) {
                e_sun += add;
            }
        }
    }
    n = n_hit;
    if ((lighting_toggles() & LIGHTING_TOGGLE_BOUNCE_ONLY) != 0u) {
        e = vec3(0.0);
        e_sun = vec3(0.0);
    }
    if (tdl != ~0u && (lighting_toggles() & LIGHTING_TOGGLE_BOUNCE_ONLY) == 0u) {
        uint ts = tdl & 0x3FFFFFFFu;
        if (tdl_check) {
            // Confirm: within LIGHTING_TDL_TOL of the cached value -> keep it,
            // nudged towards the check (an unbiased estimate, so drift is
            // tracked), under the new signature. Else escalate: the entry is
            // dropped and the next use recomputes it exactly (budget); this
            // hit takes the check's estimate. A still verification check reads
            // the same value and does not write it.
            vec4 d = cache.v[LIGHTING_TDL_AT + ts];
            vec3 c = lighting_unpack_rgb9e5(floatBitsToUint(d.x));
            float lc = dot(c, vec3(0.2126, 0.7152, 0.0722));
            float le = dot(e, vec3(0.2126, 0.7152, 0.0722));
            if (abs(le - lc) <= LIGHTING_TDL_TOL * max(max(le, lc), 1.0e-3)) {
                lighting_dg(48u, 1u);
                vec3 m = mix(c, e, 0.25);
                if (!vote_only) {
                    cache.v[LIGHTING_TDL_AT + ts] = vec4(uintBitsToFloat(lighting_pack_rgb9e5(m)), d.y, uintBitsToFloat(tdl_sig), uintBitsToFloat(lighting_frame()));
                }
                e = m;
                e_sun = m * d.y;
            } else if (!vote_only) {
                lighting_dg(49u, 1u);
                cache.v[LIGHTING_TDL_AT + ts].z = 0.0;
            }
        } else if ((tdl & 0x80000000u) != 0u) {
            vec4 d = cache.v[LIGHTING_TDL_AT + ts];
            e = lighting_unpack_rgb9e5(floatBitsToUint(d.x));
            e_sun = e * d.y;
        } else if (!vote_only) {
            float le = dot(e, vec3(0.2126, 0.7152, 0.0722));
            float fs = le > 0.0 ? clamp(dot(e_sun, vec3(0.2126, 0.7152, 0.0722)) / le, 0.0, 1.0) : 0.0;
            cache.v[LIGHTING_TDL_AT + ts] = vec4(uintBitsToFloat(lighting_pack_rgb9e5(e)), fs, uintBitsToFloat(tdl_sig), uintBitsToFloat(lighting_frame()));
        }
    }
    if (idx < pixels) {
        uint emitted = gbuf.px[idx].w;
        uint glow = emitted == ~0u || (gstats.ctrl_bits & 512u) == 0u ? 0u : emitted;
        uint prev_e = outc.px[pixels + idx];
        uint packed = lighting_pack_rgb9e5(e);
        uint prev_d = 0u;
        uint prev_sig = 0u;
        bool tracked = lighting_pix_reuse_on();
        if (tracked) {
            uint c = (idx & 1u) * 2u;
            prev_sig = floatBitsToUint(work.v[lighting_pix_at() + idx / 2u][c]);
            prev_d = floatBitsToUint(work.v[lighting_pix_at() + idx / 2u][c + 1u]);
        }
        outc.px[pixels + idx] = glow;
        gbuf.px[idx].w = packed;
        if (tracked) {
            uint c = (idx & 1u) * 2u;
            work.v[lighting_pix_at() + idx / 2u][c] = uintBitsToFloat(pix_sig);
            work.v[lighting_pix_at() + idx / 2u][c + 1u] = uintBitsToFloat(packed);
            // Packed direct moved because the sun did. The sun compose writes
            // this frame's direct on every pixel. The block is not a GI dirty.
            // Flag off: same mark.
            bool sun_only = lighting_sun_small() && glow == prev_e && pix_sig == prev_sig;
            if (!sun_only && (glow != prev_e || packed != prev_d || pix_sig != prev_sig)) {
                lighting_compose_mark_px(idx);
            }
        }
        if (gstats.ctrl_history != 0u) {
            outc.px[pixels * 2u + idx] = packed;
        }
    } else {
        lighting_hit_sunfrac = 0.0;
        lighting_bounce_path = 2u;
        lighting_hit_kind = probe_hit ? 2u : 1u;
        if ((gstats.ctrl_bits & 512u) == 0u) {
            glow = vec3(0.0);
        }
        // Direct only. Bounce is added below for the picture; the wake vote
        // must not see it (a still scene's surface cache keeps moving).
        vec3 direct_shed = reflectance * e + glow;
        vec3 bounce = lighting_gi_on() ? lighting_cache_irradiance_at(pos, n, hit_t) : vec3(0.0);
        e += bounce;
        e_sun += lighting_hit_sunfrac * bounce;
        vec3 shed = reflectance * e + glow;
        // Fills are a first trace of a missing stratum. The vote compares a
        // kept hit's direct light to the direct light stored for that same
        // direction.
        if (probe_hit && !fill_hit) {
            lighting_wake_observe(h, direct_shed);
        }
        // No queued event: keep the legacy noise hold, including a verification
        // check that was shaded so the vote could run. The direct baseline is
        // still stored. A live ring writes the shade it forced.
        bool legacy_hold = gstats.wake_events == 0u || !lighting_wake_relight(h);
        if (fill_hit) {
            lighting_put_fill_light(h, shed);
        } else if (probe_hit && gstats.wake_events == 0u && lighting_wake_relight(h)) {
            // Legacy skipped this hit. The vote ran; the kept light stays.
            lighting_wake_store_direct(h, direct_shed);
        } else if (probe_hit && legacy_hold && lighting_check_within_noise(h, pos, n, reflectance, shed)) {
            lighting_chg(CHG_KEPT_HELD, 1u);
            lighting_wake_store_direct(h, direct_shed);
        } else if (probe_hit) {
            lighting_put_kept_light_d(h, shed, tdl == ~0u ? 2u : ((tdl & 0x80000000u) != 0u ? 0u : 1u));
            lighting_wake_store_direct(h, direct_shed);
        } else {
            // w: its sun/sky share as luminance (S63A).
            work.v[lighting_rad_at(ray)] = vec4(shed, dot(reflectance * e_sun, vec3(0.2126, 0.7152, 0.0722)));
        }
    }
}
