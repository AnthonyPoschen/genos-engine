#version 450
// Cone-traced cascades, pass 7c: the fill. The resolve pass
// (cone_resolve.comp) lists each pixel that no gathered pixel about it
// matched (a thin edge, a leaf, a pixel beside the sky); here one thread a
// listed pixel gathers its own probe light (cone_gather.glsl) and adds its
// albedo's share of it to the pixel's light.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "lighting_common.glsl"
#include "cone_common.glsl"
#include "cone_gather.glsl"

void main() {
    uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    if (i >= min(cwork.w[CONE_FILL_COUNT], pc.dims.x * pc.dims.y)) {
        return;
    }
    uint pixel = cwork.w[cone_fill_at() + i];
    uvec2 p = uvec2(pixel % pc.dims.x, pixel / pc.dims.x);
    vec3 pos;
    vec3 n;
    vec3 albedo;
    bool two_sided;
    if (!lighting_surface(p, pos, n, albedo, two_sided)) {
        return;
    }
    vec3 irradiance = cone_pixel_gather(pixel, pos, n, false);
    // Its lamps, as the resolve lights them.
    vec3 from = pos + n * CONE_SURFACE_LIFT;
    for (uint k = 0u; k < CONE_PIXEL_LAMPS && ((pc.lamp.x >> CONE_VIEW_SHIFT) & 3u) == 0u; k++) {
        if (gather_lamp[k] == 0u) {
            break;
        }
        irradiance += cone_lamp_on(gather_lamp[k] - 1u, from, n, two_sided, cone_lamp_share(gather_seen[k]));
    }
    vec3 lit = lighting_unpack_rgb9e5(gbuf_word(pixel, 3u));
    gbuf.words[pixel * GBUF_STRIDE + 3u] = lighting_pack_rgb9e5(lit + albedo * SCENE_LAMBERT * irradiance);
}
