#version 450
// Cone-traced cascades, pass 3: a probe of cascade params.x (1 or more) starts
// its cones on the start of its child nearest its seat, so the stretch before
// its interval was marched by the finer probes on that chain.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "lighting_common.glsl"
#include "cone_common.glsl"

void main() {
    int c = int(pc.params.x);
    uint i = gl_GlobalInvocationID.x;
    if (c < 1 || i >= min(cwork.w[CONE_COUNTS + uint(c)], cone_cap(c))) {
        return;
    }
    uint r = cone_probe(c, i);
    int lod = int(cwork.w[r + 1u]);
    ivec3 cell = ivec3(int(cwork.w[r + 4u]), int(cwork.w[r + 5u]), int(cwork.w[r + 6u]));
    vec3 seat = cone_word3(r + 8u);
    float best = CONE_FAR;
    uint pick = CONE_NO_BRICK;
    for (int k = 0; k < 8; k++) {
        ivec3 child = cell * 2 + ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1);
        uint j = cone_find(c - 1, cone_key(lod, child, c - 1));
        if (j == CONE_NO_BRICK) {
            continue;
        }
        vec3 d = cone_word3(cone_probe(c - 1, j) + 12u) - seat;
        if (dot(d, d) < best) {
            best = dot(d, d);
            pick = j;
        }
    }
    if (pick == CONE_NO_BRICK) {
        return;
    }
    uint q = cone_probe(c - 1, pick);
    cwork.w[r + 2u] = pick;
    cwork.w[r + 3u] = cwork.w[q + 3u];
    cone_put3(r + 12u, cone_word3(q + 12u));
    cone_put3(r + 16u, cone_word3(q + 16u));
}
