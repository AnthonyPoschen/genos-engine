#version 450
// Cone-traced cascades, pass 8, after the shade: the sun on the pixels of
// shadow edges. The shade pass (cone_shade.comp) lists each pixel whose
// voxels see part of the sun and leaves its sun out; here one thread a
// listed pixel marches its own thin ray through the field's finest levels
// for a crisp edge (Anthony, 25 Nov 2026) and adds the sun to the pixel's
// light. The list keeps the marching pixels side by side: left in the shade
// pass, each held the threads beside it for the length of its march.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "lighting_common.glsl"
#include "cone_common.glsl"

void main() {
    uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    if (i >= min(cwork.w[CONE_SUN_COUNT], pc.dims.x * pc.dims.y)) {
        return;
    }
    uint pixel = cwork.w[cone_sun_at() + i];
    uvec2 p = uvec2(pixel % pc.dims.x, pixel / pc.dims.x);
    vec3 pos;
    vec3 n;
    vec3 albedo;
    bool two_sided;
    if (!lighting_surface(p, pos, n, albedo, two_sided)) {
        return;
    }
    bool edge;
    vec3 sun = cone_sun(pos, n, two_sided, true, edge);
    vec3 lit = lighting_unpack_rgb9e5(gbuf_word(pixel, 3u));
    gbuf.words[pixel * GBUF_STRIDE + 3u] = lighting_pack_rgb9e5(lit + albedo * (1.0 / CONE_PI) * sun);
}
