#version 450
layout(local_size_x = 64) in;

#extension GL_GOOGLE_include_directive : require
#include "scene_data.glsl"

layout(std430, set = 0, binding = 1) readonly buffer RayBlock {
    vec4 listener;
    uint source_count;
    uint pad0;
    uint pad1;
    uint pad2;
    vec4 sources[256];
} rays;

layout(std430, set = 0, binding = 2) buffer GainBlock {
    float values[];
} gains;

float segment_thickness(vec3 from, vec3 to, vec3 box_min, vec3 box_max) {
    vec3 delta = to - from;
    float dist = length(delta);
    if (dist < 1e-5) {
        return 0.0;
    }
    vec3 lo = min(box_min, box_max);
    vec3 hi = max(box_min, box_max);
    float t_enter = 0.0;
    float t_exit = 1.0;
    for (int axis = 0; axis < 3; axis++) {
        float step = delta[axis];
        if (abs(step) < 1e-8) {
            if (from[axis] < lo[axis] || from[axis] > hi[axis]) {
                return 0.0;
            }
            continue;
        }
        float inv = 1.0 / step;
        float t1 = (lo[axis] - from[axis]) * inv;
        float t2 = (hi[axis] - from[axis]) * inv;
        t_enter = max(t_enter, min(t1, t2));
        t_exit = min(t_exit, max(t1, t2));
        if (t_exit < t_enter) {
            return 0.0;
        }
    }
    float start = max(t_enter, 0.0);
    float end = min(t_exit, 1.0);
    if (end <= start) {
        return 0.0;
    }
    return (end - start) * dist;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= rays.source_count || index >= 256u) {
        return;
    }
    vec3 source = rays.sources[index].xyz;
    vec3 listener = rays.listener.xyz;
    float gain = 1.0;
    // Audio tests every occluder: a few hundred sources against the list is cheap,
    // and the walk would need the light passes' cell helpers.
    for (uint i = 0u; i < scene.occ_count; i++) {
        Occ occ = scene_occ(i);
        vec3 half_ext = vec3(occ.extent.x, occ.extent.y * 0.5, occ.extent.z);
        vec3 box_min = occ.center_shape.xyz - half_ext;
        vec3 box_max = occ.center_shape.xyz + half_ext;
        float thickness = segment_thickness(source, listener, box_min, box_max);
        float absorption = max(occ.albedo.a, 0.0);
        if (thickness > 0.0 && absorption > 0.0) {
            gain *= exp(-absorption * thickness);
        }
    }
    gains.values[index] = gain;
}
