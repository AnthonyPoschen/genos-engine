#version 450
// GI v2 screen probes, pass 4: each probe's kept rays projected to SH (bands 0-2)
// and convolved with the cosine lobe: the probe's irradiance for any normal.
//
// A probe keeps the hits of its last GI2_STRATA strata (gi2_common.glsl), and the
// light pass has shaded every one of them this frame, so the probe sees up to
// GI2_STRATA x R rays with no light carried over from a past frame: a lamp that
// moves, dims or goes off shows in full on the next frame and never needs a reset.
// Only visibility is kept, and only while it still holds:
// - each kept stratum comes from whichever of last frame's probes in the 5 x 5
//   tiles around this place's old screen tile (reprojected through last frame's
//   camera) traced it nearest this place, on the same surface: facing the same
//   way (25 degrees), on its plane, within GI2_REACH probe spacings along it. A
//   still probe takes its own; one that slid across its surface (the camera
//   moved) or was just uncovered (an object moved off it) takes its neighbours'.
//   Its hits are then seen from the probe's place (parallax), and a hit that
//   falls behind the probe is not used;
// - a kept ray whose path crosses the bounds of an object that moved, came or went
//   since the last frame is dropped for good (the changes block, gi2_gpu.rs);
// - every kept stratum is dropped when the traced world changes as a whole.
// Each of the R cells of the stratified pattern is the mean of its rays' SH
// projections (this frame's ray always among them), so a dropped ray thins a cell,
// never darkens it. Each ray is projected along its own direction: the strata of a
// moving probe were traced from different world cells, so their turns differ and a
// cell's rays point all over the ring; projecting the cell's mean light along its
// mean direction (as before 2026-10-10) bent that light toward the normal and drew
// moving probes 5-30 % too bright, in blotches.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "gi2_common.glsl"

// Distance from segment a-b to point c, squared.
float gi2_seg_dist2(vec3 a, vec3 b, vec3 c) {
    vec3 ab = b - a;
    float t = clamp(dot(c - a, ab) / max(dot(ab, ab), 1.0e-12), 0.0, 1.0);
    vec3 d = a + ab * t - c;
    return dot(d, d);
}

void main() {
    uint probe = gl_GlobalInvocationID.x;
    if (probe >= gi2_probes()) {
        return;
    }
    vec4 pp = work.v[gi2_probe_at(probe)];
    vec3 n = work.v[gi2_probe_at(probe) + 1u].xyz;
    float c[27];
    [[dont_unroll]] for (uint f = 0u; f < 27u; f++) {
        c[f] = 0.0;
    }
    uint rays = gi2_rays();
    uint now = gi2_stratum();
    vec4 head = work.v[gi2_change_at()];
    uint changes = min(uint(head.x + 0.5), GI2_CHANGES);
    bool drop_all = head.y > 0.5;
    uint last = uint(head.z + 0.5) & 1u;
    uint next = 1u - last;
    uint src[GI2_STRATA];
    [[dont_unroll]] for (uint s = 0u; s < GI2_STRATA; s++) {
        src[s] = 0u;
    }
    if (pp.w > 0.5) {
        src[now] = probe + 1u;
        // Where this place stood on last frame's screen: its tile there.
        vec4 eye = work.v[gi2_change_at() + 1u];
        ivec2 t = ivec2(-1000);
        if (!drop_all && eye.w > 0.5) {
            vec4 right = work.v[gi2_change_at() + 2u];
            vec3 up = work.v[gi2_change_at() + 3u].xyz;
            vec4 fwd = work.v[gi2_change_at() + 4u];
            vec3 rel = pp.xyz - eye.xyz;
            float z = dot(rel, fwd.xyz);
            if (z > 1.0e-3) {
                vec2 ndc = vec2(dot(rel, right.xyz) / (z * right.w * fwd.w), dot(rel, up) / (z * right.w));
                vec2 px = vec2((ndc.x + 1.0) * 0.5 * float(pc.dims.x), (1.0 - ndc.y) * 0.5 * float(pc.dims.y));
                t = ivec2(floor(px / float(pc.params.y)));
            }
        }
        // Each kept stratum comes from whichever of last frame's probes around
        // that tile traced it nearest this place on the same surface: the probe's
        // own (it stays put while the camera does), a neighbour's when the probe
        // slid across its surface (the camera moved) or was just uncovered (an
        // object moved off it). Its hits are then seen from here (parallax).
        float dist = length(pp.xyz - scene.eye.xyz);
        float plane = 0.05 + 0.02 * dist;
        // A probe's spacing on its surface at its distance (the tile across the
        // view, stretched where the surface is seen at a slant).
        float facing = max(abs(dot(n, normalize(scene.eye.xyz - pp.xyz))), 0.2);
        float spacing = float(pc.params.y) * 2.0 * scene.view_right.w * dist / float(pc.dims.y) / facing;
        float reach = GI2_REACH * spacing + 0.02;
        float best[GI2_STRATA];
        [[dont_unroll]] for (uint s = 0u; s < GI2_STRATA; s++) {
            best[s] = 1.0e9;
        }
        [[dont_unroll]] for (int dy = -2; dy <= 2; dy++) {
            [[dont_unroll]] for (int dx = -2; dx <= 2; dx++) {
                ivec2 q = t + ivec2(dx, dy);
                if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, ivec2(pc.dims.zw)))) {
                    continue;
                }
                uint from_probe = uint(q.y) * pc.dims.z + uint(q.x);
                uvec4 v0 = floatBitsToUint(work.v[gi2_view_at(last, from_probe)]);
                uvec4 v1 = floatBitsToUint(work.v[gi2_view_at(last, from_probe) + 1u]);
                uint was[8] = uint[8](v0.x, v0.y, v0.z, v0.w, v1.x, v1.y, v1.z, v1.w);
                [[dont_unroll]] for (uint s = 0u; s < GI2_STRATA; s++) {
                    if (s == now || was[s] == 0u) {
                        continue;
                    }
                    vec4 sp = work.v[gi2_stratum_at(was[s] - 1u, s)];
                    vec3 sn = work.v[gi2_stratum_at(was[s] - 1u, s) + 1u].xyz;
                    vec3 d = pp.xyz - sp.xyz;
                    float off = abs(dot(d, n));
                    float side = length(d - n * dot(d, n));
                    float score = side + 4.0 * off;
                    if (sp.w > 0.5 && dot(sn, n) > 0.9 && off < plane && side < reach && score < best[s]) {
                        best[s] = score;
                        src[s] = was[s];
                    }
                }
            }
        }
    }
    work.v[gi2_view_at(next, probe)] = uintBitsToFloat(uvec4(src[0], src[1], src[2], src[3]));
    work.v[gi2_view_at(next, probe) + 1u] = uintBitsToFloat(uvec4(src[4], src[5], src[6], src[7]));
    if (pp.w > 0.5) {
        vec3 from = pp.xyz + n * 0.02;
        uint samples = 0u;
        [[dont_unroll]] for (uint k = 0u; k < rays; k++) {
            vec3 sum_ly[9];
            [[dont_unroll]] for (uint j = 0u; j < 9u; j++) {
                sum_ly[j] = vec3(0.0);
            }
            float m = 0.0;
            [[dont_unroll]] for (uint s = 0u; s < GI2_STRATA; s++) {
                if (src[s] == 0u) {
                    continue;
                }
                uint h = ((src[s] - 1u) * GI2_STRATA + s) * rays + k;
                vec4 rec = work.v[gi2_kept_at(h)];
                if (rec.x < 0.0 && rec.x > -0.75) {
                    continue;
                }
                vec3 origin;
                vec3 dir;
                vec3 sn;
                gi2_stratum_ray(src[s] - 1u, s, k, origin, dir, sn);
                bool hit = rec.x >= 0.0;
                vec3 end = origin + dir * (hit ? rec.x : 200.0);
                if (s != now && changes > 0u) {
                    bool crossed = false;
                    [[dont_unroll]] for (uint j = 0u; j < changes; j++) {
                        vec4 b = work.v[gi2_change_at() + GI2_CHANGE_HEAD + j];
                        if (gi2_seg_dist2(origin, end, b.xyz) < b.w * b.w) {
                            crossed = true;
                            break;
                        }
                    }
                    if (crossed) {
                        work.v[gi2_kept_at(h)] = GI2_NO_RAY;
                        continue;
                    }
                }
                // Seen from where the probe stands now: a hit point from its new
                // place, a miss (at infinity) along its own direction.
                vec3 d = hit ? end - from : dir;
                float len = length(d);
                if (len < 1.0e-4 || dot(d, n) <= 0.0) {
                    continue;
                }
                vec3 l = gi2_kept_light(h);
                float y[9];
                gi2_sh9(d / len, y);
                [[dont_unroll]] for (uint j = 0u; j < 9u; j++) {
                    sum_ly[j] += l * y[j];
                }
                m += 1.0;
            }
            if (m > 0.0) {
                samples += uint(m);
                [[dont_unroll]] for (uint j = 0u; j < 9u; j++) {
                    vec3 v = sum_ly[j] / m;
                    c[3u * j] += v.r;
                    c[3u * j + 1u] += v.g;
                    c[3u * j + 2u] += v.b;
                }
            }
        }
        atomicAdd(gstats.pad0, samples);
        atomicAdd(gstats.pad1, 1u);
    }
    // Uniform hemisphere: each cell stands for 2 pi / R steradians. Cosine lobe per
    // band: pi, 2 pi / 3, pi / 4.
    float scale = GI2_TAU / float(max(rays, 1u));
    [[dont_unroll]] for (uint f = 0u; f < 27u; f++) {
        uint band = f < 3u ? 0u : (f < 12u ? 1u : 2u);
        float a = band == 0u ? GI2_PI : (band == 1u ? GI2_TAU / 3.0 : GI2_PI / 4.0);
        c[f] *= scale * a;
    }
    uint base = gi2_sh_at(probe);
    [[dont_unroll]] for (uint q = 0u; q < 7u; q++) {
        work.v[base + q] = vec4(c[4u * q], c[4u * q + 1u], c[4u * q + 2u], q == 6u ? 0.0 : c[4u * q + 3u]);
    }
}
