#version 450
// Same-frame bloom pyramid. Karis on the first downsample, the 13-tap on the
// rest, then the 3x3 tent back up. The chain matches bloom_pyramid: bloom only,
// not scene + bloom. Each mip is RGB16F, two texels in 12 bytes. Alpha is not stored.
layout(local_size_x = 64, local_size_y = 1) in;

layout(push_constant) uniform Push {
    uvec4 dims;
    uvec4 params;
    uvec4 lamp;
} pc;

layout(std430, set = 0, binding = 13) restrict readonly buffer SceneReferred {
    uint words[];
} scene_lin;

layout(std430, set = 0, binding = 16) buffer BloomChain {
    uint words[];
} bloom;

vec3 load_scene(uint i) {
    vec2 rg = unpackHalf2x16(scene_lin.words[i * 2u]);
    vec2 ba = unpackHalf2x16(scene_lin.words[i * 2u + 1u]);
    return vec3(rg, ba.x);
}

const float HALF_MAX = 65504.0;

vec2 finite_half2(vec2 v) {
    return clamp(v, vec2(-HALF_MAX), vec2(HALF_MAX));
}

// `word` is the mip's first uint. Two RGB16F texels occupy the next three uints.
vec3 load_bloom(uint word, uint local) {
    uint pair = local >> 1u;
    uint w = word + pair * 3u;
    vec2 a_rg = unpackHalf2x16(bloom.words[w]);
    vec2 mid = unpackHalf2x16(bloom.words[w + 1u]);
    vec2 b_gb = unpackHalf2x16(bloom.words[w + 2u]);
    if ((local & 1u) == 0u) {
        return vec3(a_rg, mid.x);
    }
    return vec3(mid.y, b_gb);
}

void store_pair(uint word, uint local0, vec3 c0, vec3 c1) {
    uint pair = local0 >> 1u;
    uint w = word + pair * 3u;
    bloom.words[w] = packHalf2x16(finite_half2(c0.rg));
    bloom.words[w + 1u] = packHalf2x16(finite_half2(vec2(c0.b, c1.r)));
    bloom.words[w + 2u] = packHalf2x16(finite_half2(c1.gb));
}

const float REC709_R = 0.2126;
const float REC709_G = 0.7152;
const float REC709_B = 0.0722;
const float BOX_SCALE = 0.25;
const float KARIS_INNER = 0.5;
const float KARIS_OUTER = 0.125;
const float TEXEL_CENTER = 0.5;
const float TAP_CENTRE = 0.125;
const float TAP_EDGE = 0.0625;
const float TAP_CORNER = 0.03125;
const float TENT_CENTRE = 0.25;
const float TENT_EDGE = 0.125;
const float TENT_CORNER = 0.0625;

float rec709(vec3 c) {
    return dot(c, vec3(REC709_R, REC709_G, REC709_B));
}

vec3 at_scene(uint w, uint h, uint x, uint y) {
    if (x >= w || y >= h) {
        return vec3(0.0);
    }
    return load_scene(y * w + x);
}

vec3 box2_scene(uint w, uint h, uint x, uint y) {
    vec3 acc = vec3(0.0);
    acc += at_scene(w, h, x, y);
    acc += at_scene(w, h, x + 1u, y);
    acc += at_scene(w, h, x, y + 1u);
    acc += at_scene(w, h, x + 1u, y + 1u);
    return acc * BOX_SCALE;
}

vec3 karis_at(uint src_w, uint src_h, uvec2 p) {
    uint ox = p.x * 2u;
    uint oy = p.y * 2u;
    uint ox_l = ox >= 2u ? ox - 2u : 0u;
    uint oy_d = oy >= 2u ? oy - 2u : 0u;
    vec3 acc = vec3(0.0);
    float sum_w = 0.0;
    vec3 samples[5] = vec3[5](
        box2_scene(src_w, src_h, ox, oy),
        box2_scene(src_w, src_h, ox + 2u, oy),
        box2_scene(src_w, src_h, ox_l, oy),
        box2_scene(src_w, src_h, ox, oy + 2u),
        box2_scene(src_w, src_h, ox, oy_d)
    );
    float base_w[5] = float[5](KARIS_INNER, KARIS_OUTER, KARIS_OUTER, KARIS_OUTER, KARIS_OUTER);
    for (int i = 0; i < 5; i++) {
        float weight = base_w[i] * (1.0 / (1.0 + max(rec709(samples[i]), 0.0)));
        sum_w += weight;
        acc += samples[i] * weight;
    }
    if (sum_w > 0.0) {
        acc /= sum_w;
    }
    return acc;
}

vec3 at_bloom(uint base, uint w, uint h, int x, int y) {
    if (x < 0 || y < 0) {
        return vec3(0.0);
    }
    if (uint(x) >= w || uint(y) >= h) {
        return vec3(0.0);
    }
    return load_bloom(base, uint(y) * w + uint(x));
}

vec3 bilinear(uint base, uint w, uint h, float u, float v) {
    if (w == 0u || h == 0u) {
        return vec3(0.0);
    }
    float px = u * float(w) - TEXEL_CENTER;
    float py = v * float(h) - TEXEL_CENTER;
    int x0 = int(floor(px));
    int y0 = int(floor(py));
    float tx = px - float(x0);
    float ty = py - float(y0);
    vec3 s00 = at_bloom(base, w, h, x0, y0);
    vec3 s10 = at_bloom(base, w, h, x0 + 1, y0);
    vec3 s01 = at_bloom(base, w, h, x0, y0 + 1);
    vec3 s11 = at_bloom(base, w, h, x0 + 1, y0 + 1);
    return s00 * (1.0 - tx) * (1.0 - ty) + s10 * tx * (1.0 - ty)
        + s01 * (1.0 - tx) * ty + s11 * tx * ty;
}

vec3 downsample13(uint base, uint src_w, uint src_h, uvec2 p, uint dst_w, uint dst_h) {
    float u = (float(p.x) + TEXEL_CENTER) / float(dst_w);
    float v = (float(p.y) + TEXEL_CENTER) / float(dst_h);
    ivec2 tap_d[13] = ivec2[13](
        ivec2(0, 0), ivec2(-1, 1), ivec2(1, 1), ivec2(-1, -1), ivec2(1, -1),
        ivec2(0, 2), ivec2(0, -2), ivec2(-2, 0), ivec2(2, 0),
        ivec2(-2, 2), ivec2(2, 2), ivec2(-2, -2), ivec2(2, -2)
    );
    float tap_w[13] = float[13](
        TAP_CENTRE, TAP_CENTRE, TAP_CENTRE, TAP_CENTRE, TAP_CENTRE,
        TAP_EDGE, TAP_EDGE, TAP_EDGE, TAP_EDGE,
        TAP_CORNER, TAP_CORNER, TAP_CORNER, TAP_CORNER
    );
    vec3 acc = vec3(0.0);
    for (int i = 0; i < 13; i++) {
        float su = u + float(tap_d[i].x) / float(src_w);
        float sv = v + float(tap_d[i].y) / float(src_h);
        acc += tap_w[i] * bilinear(base, src_w, src_h, su, sv);
    }
    return acc;
}

// Quarter-resolution first step. Four half-resolution Karis samples, averaged.
vec3 karis4(uint src_w, uint src_h, uvec2 p) {
    vec3 acc = karis_at(src_w, src_h, p * 2u);
    acc += karis_at(src_w, src_h, p * 2u + uvec2(1u, 0u));
    acc += karis_at(src_w, src_h, p * 2u + uvec2(0u, 1u));
    acc += karis_at(src_w, src_h, p * 2u + uvec2(1u, 1u));
    return acc * BOX_SCALE;
}

float tent(int dx, int dy) {
    if (dx == 0 && dy == 0) {
        return TENT_CENTRE;
    }
    if (dx == 0 || dy == 0) {
        return TENT_EDGE;
    }
    return TENT_CORNER;
}

vec3 upsample3(uint base, uint src_w, uint src_h, uvec2 p, uint dst_w, uint dst_h) {
    float u = (float(p.x) + TEXEL_CENTER) / float(max(dst_w, 1u));
    float v = (float(p.y) + TEXEL_CENTER) / float(max(dst_h, 1u));
    vec3 acc = vec3(0.0);
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            float su = u + float(dx) / float(max(src_w, 1u));
            float sv = v + float(dy) / float(max(src_h, 1u));
            acc += tent(dx, dy) * bilinear(base, src_w, src_h, su, sv);
        }
    }
    return acc;
}

vec3 shade(uvec2 p, uint dst_w, uint dst_h, uint src_w, uint src_h, uint src, uint mode) {
    if (mode == 0u) {
        return karis_at(src_w, src_h, p);
    }
    if (mode == 4u) {
        return karis4(src_w, src_h, p);
    }
    if (mode == 1u) {
        return downsample13(src, src_w, src_h, p, dst_w, dst_h);
    }
    return upsample3(src, src_w, src_h, p, dst_w, dst_h);
}

void main() {
    uint dst_w = pc.dims.x;
    uint dst_h = pc.dims.y;
    uint count = dst_w * dst_h;
    uint pairs = (count + 1u) / 2u;
    uint pair = gl_GlobalInvocationID.x;
    if (dst_w == 0u || pair >= pairs) {
        return;
    }
    uint src_w = pc.dims.z;
    uint src_h = pc.dims.w;
    uint src = pc.params.x;
    uint dst = pc.params.y;
    uint mode = pc.params.z;
    uint local0 = pair * 2u;
    uvec2 p0 = uvec2(local0 % dst_w, local0 / dst_w);
    vec3 c0 = shade(p0, dst_w, dst_h, src_w, src_h, src, mode);
    vec3 c1 = vec3(0.0);
    uint local1 = local0 + 1u;
    if (local1 < count) {
        uvec2 p1 = uvec2(local1 % dst_w, local1 / dst_w);
        c1 = shade(p1, dst_w, dst_h, src_w, src_h, src, mode);
    }
    if (mode == 2u) {
        c0 += load_bloom(pc.params.w, local0);
        if (local1 < count) {
            c1 += load_bloom(pc.params.w, local1);
        }
    }
    store_pair(dst, local0, c0, c1);
}
