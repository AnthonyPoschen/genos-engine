#version 450
// One group. Marks any tile whose direct shade stepped, and any tile a world
// cell's bounce noted. It runs after direct and the cache in the same frame,
// so those notes are in the mask the wavelet and compose read. The change-list
// disc is gone: a mover is a level-0 sample, not a reach mark.
// A clipped, off-screen, or screen-filling mover footprint is not marked as
// local: the host unholds the picture. A hot cell whose bounds are behind
// the camera, on it, or half the picture sets the same unhold from the last
// change word. A lamp is not in this list. The cell note is
// lighting_reach_note_cell. This pass reads the count and clears it, so a
// tile drops once the step stops.
// pc.dims.z == 0xffffffff clears the slot stamps only, after the cache pass.
// pc.dims.z == 0xfffffffe sets the field bit from the mask, after the screen
// pass. A later block mark in that pass would clear a bit set earlier.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "lighting_common.glsl"

shared uint reach_hot_count;
shared uint reach_wide_cell;

uint reach_tw() {
    return (pc.dims.x + 31u) / 32u;
}

void reach_mark_tile(uint tx, uint ty) {
    uint tw = reach_tw();
    uint th = (pc.dims.y + 31u) / 32u;
    if (tx >= tw || ty >= th) {
        return;
    }
    lighting_reach_or_tile(ty * tw + tx);
    uint bw = (pc.dims.x + 7u) / 8u;
    for (uint by = 0u; by < 4u; by++) {
        for (uint bx = 0u; bx < 4u; bx++) {
            uvec2 p = uvec2(tx * 32u + bx * 8u, ty * 32u + by * 8u);
            if (p.x < pc.dims.x && p.y < pc.dims.y) {
                // The field bit is the signal compose already tests. A new
                // bitset read in that shader does not fit under 248_000.
                lighting_compose_mark_block_reason((p.y >> 3u) * bw + (p.x >> 3u), true);
            }
        }
    }
}

void main() {
    uint id = gl_LocalInvocationIndex;
    // After the cache pass. Last frame's stamps stay visible to the SH write.
    if (pc.dims.z == 0xffffffffu) {
        uint slot_at = lighting_reach_base() + LIGHTING_REACH_MASK_WORDS + LIGHTING_REACH_CHANGE_WORDS;
        uint slot_words = LIGHTING_CACHE_SLOTS / 32u;
        for (uint i = id; i < slot_words; i += 64u) {
            ckeys.key[slot_at + i] = 0u;
        }
        return;
    }
    if (pc.dims.z == 0xfffffffeu) {
        uint base = lighting_reach_base();
        uint tw = reach_tw();
        uint th = (pc.dims.y + 31u) / 32u;
        uint tiles = tw * th;
        for (uint tile = id; tile < tiles && tile < LIGHTING_REACH_CHANGE_WORDS; tile += 64u) {
            uint word = ckeys.key[base + (tile >> 5u)];
            if ((word & (1u << (tile & 31u))) != 0u) {
                reach_mark_tile(tile % tw, tile / tw);
            }
        }
        return;
    }
    if (id == 0u) {
        reach_hot_count = 0u;
    }
    uint base = lighting_reach_base();
    for (uint i = id; i < LIGHTING_REACH_MASK_WORDS; i += 64u) {
        ckeys.key[base + i] = 0u;
    }
    barrier();
    uint tw = reach_tw();
    uint th = (pc.dims.y + 31u) / 32u;
    uint tiles = tw * th;
    uint hot = 0u;
    uint change_at = base + LIGHTING_REACH_MASK_WORDS;
    if (id == 0u) {
        reach_wide_cell = ckeys.key[change_at + LIGHTING_REACH_CHANGE_WORDS - 1u];
    }
    barrier();
    if (reach_wide_cell != 0u && tw > 0u) {
        for (uint tile = id; tile < tiles && tile < LIGHTING_REACH_CHANGE_WORDS - 1u; tile += 64u) {
            reach_mark_tile(tile % tw, tile / tw);
        }
        if (id == 0u) {
            vec4 head = work.v[lighting_change_at()];
            if (fract(head.x) < LIGHTING_SCENE_CHANGED_MARK) {
                head.x = floor(head.x) + LIGHTING_SCENE_CHANGED_MARK;
                work.v[lighting_change_at()] = head;
            }
        }
    }
    if (tw > 0u) {
        for (uint tile = id; tile < tiles && tile < LIGHTING_REACH_CHANGE_WORDS; tile += 64u) {
            // The one-percent dirty test fires in almost every tile. A tile
            // joins when REACH_DIRECT_PIXELS pixels stepped by REACH_SHADOW.
            if (ckeys.key[change_at + tile] >= REACH_DIRECT_PIXELS) {
                reach_mark_tile(tile % tw, tile / tw);
                hot++;
            }
        }
    }
    atomicAdd(reach_hot_count, hot);
    // A mover is a new level-0 sample. The change-list disc is not a mark.
    barrier();
    for (uint i = id; i < LIGHTING_REACH_CHANGE_WORDS; i += 64u) {
        ckeys.key[change_at + i] = 0u;
    }
    barrier();
    if (id == 0u) {
        uint marked = 0u;
        uint words = (tiles + 31u) >> 5u;
        for (uint i = 0u; i < words && i < LIGHTING_REACH_MASK_WORDS; i++) {
            marked += bitCount(ckeys.key[base + i]);
        }
        uint corners = 0u;
        if (tw > 0u && th > 0u) {
            uvec2 c = uvec2(0u, tw - 1u);
            uvec2 r = uvec2(0u, th - 1u);
            for (uint k = 0u; k < 4u; k++) {
                uint tx = c[k & 1u];
                uint ty = r[k >> 1u];
                uint tile = ty * tw + tx;
                uint bit = ckeys.key[base + (tile >> 5u)] & (1u << (tile & 31u));
                if (bit != 0u) {
                    corners |= 1u << k;
                }
            }
        }
        uint hot_pack = min(reach_hot_count, 4095u);
        gstats.diag[LIGHTING_DIAG_REACH] = (marked & 65535u) | (hot_pack << 16u) | (corners << 28u);
    }
}
