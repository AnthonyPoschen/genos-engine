#version 450
// GI v2 rays, pass 2: the screen probes' rays, then the rays of the light cache
// patches relit this frame. A hit stores its distance and surface for the light
// pass; a miss takes the sky. One trace site.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "gi2_common.glsl"

void main() {
    uint ray = gl_GlobalInvocationID.x;
    if (ray >= gi2_all_rays()) {
        return;
    }
    uint at = gi2_hit_at(ray);
    vec3 origin;
    vec3 dir;
    vec3 n;
    if (!gi2_ray(ray, origin, dir, n)) {
        work.v[at] = vec4(-2.0, 0.0, 0.0, 0.0);
        work.v[gi2_rad_at(ray)] = vec4(0.0);
        return;
    }
    SceneHit hit;
    if (!trace_ray(origin, dir, 1.0e-4, 200.0, hit)) {
        work.v[at] = vec4(-1.0, 0.0, 0.0, 0.0);
        work.v[gi2_rad_at(ray)] = vec4(has_sky() ? scene.sky.rgb : vec3(0.0), 0.0);
        return;
    }
    vec3 hn = dot(hit.normal, dir) > 0.0 ? -hit.normal : hit.normal;
    vec3 tint = mix(vec3(1.0), hit.albedo, hit.color_mix);
    work.v[at] = vec4(hit.t, uintBitsToFloat(gi2_pack_normal(hn)),
                      uintBitsToFloat(packUnorm4x8(vec4(tint * hit.reflect * GI2_PI, 0.0))), 0.0);
}
