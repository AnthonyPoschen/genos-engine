#version 450
// Screen launch of the hash wavelet (S80).
//
// One 8x8 group per picture block. The kernel is lighting_svgf_variance,
// lighting_svgf_iter, and lighting_svgf_push: the same stages the hash-slot
// pipeline runs, including its variance, its luminance weight, and the dirty
// hold. A screen-sized B3 of the bilinear gather is not that kernel. The
// luminance weight is nonlinear, so it does not commute with the bilinear,
// and this path has no hold (ADR 0012). The hash blurs a texel while its
// spatial estimate is still wide and then holds that blur. Rebuilding from
// the settled mean leaves the 12.5 cm grid, and a wider phi spreads energy
// the hold never spread. That was the ceiling, wall, and floor blotch.
//
// The launch is the picture, not the million-slot table. Stage 0 stores the
// fine slot under each pixel. Stage 1 picks one pixel per visible cell: the
// visible hit closest to the cell centre. The pixel the centre projects to
// is the wrong one once the surface is edge-on, because that ray hits a
// nearer cell and the texel then has no thread. The raw mean shows through
// as grain. Stages after that are the hash iterations and the push, on that
// one pixel. Compose bilerps the pushed field. Slice 1 stays empty so
// lighting_screen_field does not replace the bilinear.
//
// A fine texel the hash pipeline would still filter (shown in the last 30
// frames, or the camera held) but that no pixel of this frame can see is
// not visited. A still view visits the same set. 25 cm cells stay on the
// running mean the hash push reads when this launch has not filtered them.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
#include "lighting_common.glsl"

shared uint screen_red[64];

uint screen_wg_sum(uint bit) {
    uint lid = gl_LocalInvocationIndex;
    screen_red[lid] = bit;
    barrier();
    if (lid < 32u) screen_red[lid] += screen_red[lid + 32u];
    barrier();
    if (lid < 16u) screen_red[lid] += screen_red[lid + 16u];
    barrier();
    if (lid < 8u) screen_red[lid] += screen_red[lid + 8u];
    barrier();
    if (lid < 4u) screen_red[lid] += screen_red[lid + 4u];
    barrier();
    if (lid < 2u) screen_red[lid] += screen_red[lid + 2u];
    barrier();
    if (lid == 0u) screen_red[0] += screen_red[1];
    barrier();
    return screen_red[0];
}

uint screen_pixels() {
    return pc.dims.x * pc.dims.y;
}

uint screen_at(uint slice, uint index) {
    uint hist = gstats.ctrl_history != 0u ? 1u : 0u;
    return ((3u + hist) + slice * 4u) * screen_pixels() + index * 4u;
}

void screen_store(uint slice, uint index, vec3 rgb, float var, float mask, uint slot) {
    uint at = screen_at(slice, index);
    outc.px[at] = lighting_pack_rgb9e5(max(rgb, vec3(0.0)));
    outc.px[at + 1u] = floatBitsToUint(var);
    outc.px[at + 2u] = floatBitsToUint(mask);
    outc.px[at + 3u] = slot;
}

bool screen_live(uint slot) {
    return slot != ~0u && slot < LIGHTING_CACHE_SLOTS && ckeys.key[slot] != 0u && cache.v[3u * slot + 1u].w > 0.0;
}

// Hash stage: 0 variance, 1..5 an iteration, anything else the push.
void screen_run(uint slot, uint step) {
    if (slot >= LIGHTING_CACHE_SLOTS) {
        return;
    }
    if (ckeys.key[slot] == 0u) {
        return;
    }
    if (!(cache.v[3u * slot + 1u].w > 0.0)) {
        return;
    }
    lighting_obj_salt = cache.v[LIGHTING_SC_OBJ_AT + slot].x > 0.5 ? cache.v[LIGHTING_SC_OBJ_AT + slot].x : 0.0;
    if (!lighting_svgf_active(slot)) {
        if (step == 0u) {
            lighting_svgf_inactive(slot);
        }
        lighting_obj_salt = 0.0;
        return;
    }
    if (step == 0u) {
        lighting_svgf_variance(slot);
    } else if (step <= 5u) {
        lighting_svgf_iter(slot, step - 1u);
    } else {
        lighting_svgf_push(slot);
    }
    lighting_obj_salt = 0.0;
}

float screen_plane(vec3 pos, vec3 centre, vec3 key_n) {
    vec3 delta = pos - centre;
    return length(delta - key_n * dot(delta, key_n));
}

// Stage 0. One hash find per pixel. The slot is kept for the owner test.
uvec3 screen_gather(uvec2 p) {
    uint index = p.y * pc.dims.x + p.x;
    uint at = screen_at(0u, index);
    outc.px[at] = 0u;
    outc.px[at + 1u] = 0u;
    outc.px[at + 2u] = 0u;
    outc.px[at + 3u] = ~0u;
    vec3 pos;
    vec3 n;
    vec3 albedo;
    bool two_sided;
    if (!lighting_sc_svgf() || !lighting_surface(p, pos, n, albedo, two_sided)) {
        return uvec3(0u);
    }
    vec3 key_n = lighting_axis_vec(lighting_geo_axis(p));
    uint slot = lighting_cache_find_sized(pos, key_n, false, LIGHTING_SC_TEXEL, pos);
    // Nested, not `||`: a miss is ~0u, and the other side would index the cache
    // with it. glslc does not leave that read out.
    if (slot >= LIGHTING_CACHE_SLOTS) {
        return uvec3(0u);
    }
    if (ckeys.key[slot] == 0u || !(cache.v[3u * slot + 1u].w > 0.0) || cache.v[3u * slot + 1u].w > 0.2) {
        return uvec3(0u);
    }
    outc.px[at + 3u] = slot;
    return uvec3(lighting_svgf_active(slot) ? 1u : 0u, 0u, 0u);
}

// Stage 1. The visible hit closest to the cell centre owns the kernel.
// Two of those minima happen when a nearer surface splits the cell. The
// exchange keeps one thread; the kernel reads the slot, not the pixel.
bool screen_owner(uvec2 p, uint slot) {
    vec3 pos;
    vec3 n;
    vec3 albedo;
    bool two_sided;
    if (!lighting_surface(p, pos, n, albedo, two_sided)) {
        return false;
    }
    vec3 key_n = lighting_axis_vec(lighting_geo_axis(p));
    vec3 centre = lighting_sc_centre(pos, key_n, LIGHTING_SC_TEXEL);
    float dist = screen_plane(pos, centre, key_n);
    uint index = p.y * pc.dims.x + p.x;
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            if (i == 0 && j == 0) {
                continue;
            }
            ivec2 q = ivec2(p) + ivec2(i, j);
            if (q.x < 0 || q.y < 0 || q.x >= int(pc.dims.x) || q.y >= int(pc.dims.y)) {
                continue;
            }
            uint qs = outc.px[screen_at(0u, uint(q.y) * pc.dims.x + uint(q.x)) + 3u];
            if (qs != slot) {
                continue;
            }
            vec3 qp;
            vec3 qn;
            vec3 qa;
            bool qtwo;
            if (!lighting_surface(uvec2(q), qp, qn, qa, qtwo)) {
                continue;
            }
            float qd = screen_plane(qp, centre, key_n);
            uint qi = uint(q.y) * pc.dims.x + uint(q.x);
            if (qd < dist || (qd == dist && qi < index)) {
                return false;
            }
        }
    }
    return true;
}

void screen_publish() {
    uint fine = gstats.diag[62];
    uint changed = gstats.diag[61];
    uint frac = 0u;
    if (fine > 0u) {
        frac = uint(min(1000000.0, 1000000.0 * float(changed) / float(fine)));
    }
    gstats.atrous_frac = frac;
    gstats.atrous_mode = 3u;
    gstats.atrous_ppm = screen_pixels();
    gstats.atrous_active = fine;
}

void main() {
    uint stage = lighting_atrous_stage();
    uvec2 p = gl_GlobalInvocationID.xy;
    bool inside = p.x < pc.dims.x && p.y < pc.dims.y;
    if (stage == 0u) {
        uvec3 bits = uvec3(0u);
        if (inside) {
            bits = screen_gather(p);
        }
        uint fine = screen_wg_sum(bits.x);
        uint coarse = screen_wg_sum(bits.y);
        uint changed = screen_wg_sum(bits.z);
        if (gl_LocalInvocationIndex == 0u) {
            if (fine != 0u) {
                atomicAdd(gstats.diag[62], fine);
            }
            if (coarse != 0u) {
                atomicAdd(gstats.diag[63], coarse);
            }
            if (changed != 0u) {
                atomicAdd(gstats.diag[61], changed);
            }
        }
        return;
    }
    if (!inside) {
        return;
    }
    uint index = p.y * pc.dims.x + p.x;
    uint at = screen_at(0u, index);
    uint slot = outc.px[at + 3u];
    uint iters = lighting_denoise_iters();
    if (stage == 1u) {
        // Nested: a miss is ~0u, and glslc will still index the cache on the
        // other side of `&&`.
        if (slot < LIGHTING_CACHE_SLOTS) {
            if (cache.v[3u * slot + 1u].w <= 0.2 && screen_owner(p, slot)) {
                uint stamp = lighting_frame() + 1u;
                if (atomicExchange(ckeys.key[LIGHTING_SCREEN_OWNER_AT + slot], stamp) != stamp) {
                    outc.px[at + 2u] = 1u;
                    // The spatial stamp (slot 22.z) makes a young texel redo its
                    // 7x7 while a neighbour moved. On the full hash launch that
                    // redo stays within the held blur. Here the neighbours this
                    // frame cannot see stay at an empty level, so the redo is the
                    // settled mean and the 12.5 cm grid comes back. A texel whose
                    // own input held keeps the blur it stored while the estimate
                    // was wide.
                    cache.v[LIGHTING_SC_DIRTY_AT + LIGHTING_CACHE_SLOTS + slot][2] = 0.0;
                    screen_run(slot, 0u);
                }
            }
        }
        return;
    }
    if (outc.px[at + 2u] == 0u || !screen_live(slot)) {
        if (stage == 2u + iters) {
            screen_store(1u, index, vec3(0.0), 0.0, 0.0, ~0u);
            if (p.x == 0u && p.y == 0u) {
                screen_publish();
            }
        }
        return;
    }
    if (stage == 2u + iters) {
        if (p.x == 0u && p.y == 0u) {
            screen_publish();
        }
        screen_run(slot, 6u);
        screen_store(1u, index, vec3(0.0), 0.0, 0.0, ~0u);
        return;
    }
    if (stage >= 2u && stage < 2u + iters) {
        screen_run(slot, stage - 1u);
    }
}
