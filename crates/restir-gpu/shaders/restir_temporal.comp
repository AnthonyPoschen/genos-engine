#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Temporal ReSTIR DI (Bitterli et al., TOG 2020), balance weight
// (Bitterli et al., SIGGRAPH 2022, GRIS equation 22).
// One invocation keeps the PCG stream of crates/restir-ref/src/restir.rs:
//   for each frame:
//     for each receiver, for each candidate: proposal draw, then stream pick
//     for each receiver: one f32, then the temporal merge (the draw still
//       happens when history is empty)
// History is the post-temporal reservoir. Spatial draws are not in this shader.
// M is not clamped unless pc.m_cap is non-zero (fault injection).
// A reset_after frame clears history the way Session::reset_temporal does.
//
// Dot products are `0 + ax*bx + ay*by + az*bz`, the same order as
// genos_math::Vec3::dot. p̂ is unshadowed Rec. 709 luminance.

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer Words {
    uint words[];
};

layout(push_constant) uniform Push {
    uint seed_lo;
    uint seed_hi;
    uint receiver_count;
    uint lamp_count;
    uint candidates;
    uint proposal;
    uint lamp_base;
    uint recv_base;
    uint out_base;
    uint frames;
    uint reset_after;
    uint m_cap;
} pc;

const uint LAMP_EMPTY = 0xffffffffu;
const uint NO_RESET = 0xffffffffu;
const uint PROPOSAL_TARGET = 1u;
const uint MAX_RECV = 256u;
float pi() {
    return uintBitsToFloat(0x40490fdbu);
}
const float LUMA_X = 0.2126;
const float LUMA_Y = 0.7152;
const float LUMA_Z = 0.0722;
const float DIST2_EPS = 1.0e-8;
const float UNIT_SCALE = 1.0 / 65536.0;
const float M_HI = 65536.0;

uint64_t g_state;
uint64_t g_inc;

uint64_t pcg_step() {
    uint64_t old = g_state;
    g_state = old * 6364136223846793005ul + g_inc;
    return old;
}

uint rot_r(uint bits, uint rot) {
    uint r = rot & 31u;
    if (r == 0u) {
        return bits;
    }
    return (bits >> r) | (bits << (32u - r));
}

uint next_u32() {
    uint64_t old = pcg_step();
    uint64_t mixed = ((old >> 18ul) ^ old) >> 27ul;
    uint bits = uint(mixed & 0xfffffffful);
    uint rot = uint(old >> 59ul);
    return rot_r(bits, rot);
}

float next_f32() {
    uint bits = next_u32() >> 8u;
    return float(bits & 0xffffu) * UNIT_SCALE;
}

void rng_init() {
    uint64_t seed = uint64_t(pc.seed_lo) | (uint64_t(pc.seed_hi) << 32ul);
    g_inc = (seed << 1ul) | 1ul;
    g_state = 0ul;
    g_state = pcg_step() + seed;
    next_u32();
}

float load_f(uint index) {
    return uintBitsToFloat(words[index]);
}

float dot3(float ax, float ay, float az, float bx, float by, float bz) {
    return 0.0 + ax * bx + ay * by + az * bz;
}

float m_as_f(uint value) {
    float hi = float(value >> 16u);
    float lo = float(value & 0xffffu);
    return hi * M_HI + lo;
}

float target_at(uint recv, uint lamp) {
    uint r = pc.recv_base + recv * 9u;
    uint l = pc.lamp_base + lamp * 6u;
    float dx = load_f(l) - load_f(r);
    float dy = load_f(l + 1u) - load_f(r + 1u);
    float dz = load_f(l + 2u) - load_f(r + 2u);
    float dist2 = dot3(dx, dy, dz, dx, dy, dz);
    if (dist2 <= DIST2_EPS) {
        return 0.0;
    }
    float dist = sqrt(dist2);
    float cos_theta = dot3(
        load_f(r + 3u), load_f(r + 4u), load_f(r + 5u),
        dx / dist, dy / dist, dz / dist);
    if (cos_theta <= 0.0) {
        return 0.0;
    }
    float scale = cos_theta / (dist2 * pi());
    float red = load_f(l + 3u) * load_f(r + 6u) * scale;
    float green = load_f(l + 4u) * load_f(r + 7u) * scale;
    float blue = load_f(l + 5u) * load_f(r + 8u) * scale;
    return dot3(red, green, blue, LUMA_X, LUMA_Y, LUMA_Z);
}

uint uniform_index(uint n) {
    if (n <= 1u) {
        return 0u;
    }
    uint limit = 0xffffffffu - (0xffffffffu % n);
    while (true) {
        uint draw = next_u32();
        if (draw < limit) {
            return draw % n;
        }
    }
}

void sample_cdf(const float weights[64], uint n, out uint index, out float pdf, out bool hit) {
    float sum = 0.0;
    for (uint i = 0u; i < n; i++) {
        sum += weights[i];
    }
    if (sum <= 0.0) {
        next_f32();
        hit = false;
        index = 0u;
        pdf = 0.0;
        return;
    }
    float mark = next_f32() * sum;
    float acc = 0.0;
    for (uint i = 0u; i < n; i++) {
        if (weights[i] <= 0.0) {
            continue;
        }
        acc += weights[i];
        if (mark < acc) {
            index = i;
            pdf = weights[i] / sum;
            hit = true;
            return;
        }
    }
    for (uint k = n; k > 0u; k--) {
        uint i = k - 1u;
        if (weights[i] > 0.0) {
            index = i;
            pdf = weights[i] / sum;
            hit = true;
            return;
        }
    }
    hit = false;
    index = 0u;
    pdf = 0.0;
}

void stream_update(inout uint lamp, inout float w_sum, inout uint m, uint next_lamp, float stream) {
    float unit = next_f32();
    m += 1u;
    if (stream > 0.0) {
        w_sum += stream;
        if (unit * w_sum < stream) {
            lamp = next_lamp;
        }
    }
}

bool is_empty(uint lamp, uint m) {
    return m == 0u || lamp == LAMP_EMPTY;
}

float reservoir_w(uint lamp, float w_sum, uint m, float target) {
    if (is_empty(lamp, m) || target <= 0.0) {
        return 0.0;
    }
    return w_sum / (m_as_f(m) * target);
}

void store_empty(out uint lamp, out float w_sum, out uint m, out float target) {
    lamp = LAMP_EMPTY;
    w_sum = 0.0;
    m = 0u;
    target = 0.0;
}

void cap_history(inout uint m, inout float w_sum) {
    if (pc.m_cap == 0u || m <= pc.m_cap) {
        return;
    }
    w_sum *= m_as_f(pc.m_cap) / m_as_f(m);
    m = pc.m_cap;
}

// Two-reservoir balance merge. `phat_sel` is p̂ of the selected lamp at this
// receiver. Both inputs share the receiver, so source and destination match.
// An empty canonical sample returns the history record unchanged.
void merge_pair(
    uint lamp_c, float w_c, uint m_c, float target_c, float tq_c,
    uint lamp_h, float w_h, uint m_h, float target_h, float tq_h,
    float phat_of_c, float phat_of_h,
    float unit,
    out uint lamp, out float w_sum, out uint m, out float target
) {
    if (is_empty(lamp_c, m_c)) {
        if (is_empty(lamp_h, m_h)) {
            store_empty(lamp, w_sum, m, target);
        } else {
            lamp = lamp_h;
            w_sum = w_h;
            m = m_h;
            target = target_h;
        }
        return;
    }
    float mass_c = 0.0;
    if (!is_empty(lamp_c, m_c) && tq_c > 0.0) {
        mass_c = m_as_f(m_c) * reservoir_w(lamp_c, w_c, m_c, target_c) * tq_c;
    }
    float mass_h = 0.0;
    if (!is_empty(lamp_h, m_h) && tq_h > 0.0) {
        mass_h = m_as_f(m_h) * reservoir_w(lamp_h, w_h, m_h, target_h) * tq_h;
    }
    float area = mass_c + mass_h;
    if (area <= 0.0) {
        store_empty(lamp, w_sum, m, target);
        return;
    }
    bool pick_h = false;
    if (mass_h > 0.0 && unit < mass_h / area) {
        pick_h = true;
    } else if (!(mass_c > 0.0) && mass_h > 0.0) {
        pick_h = true;
    } else if (!(mass_c > 0.0)) {
        store_empty(lamp, w_sum, m, target);
        return;
    }
    uint sel = pick_h ? lamp_h : lamp_c;
    float phat_sel = pick_h ? phat_of_h : phat_of_c;
    // The caller passes p̂ of each reservoir's own lamp. The denom needs p̂
    // of the selected lamp at both sources. On one receiver that is `phat_sel`
    // only when the selected lamp is that input's lamp. Recompute from the
    // selected lamp: both sources see `phat_sel` when it is the selected
    // lamp's luminance, which the caller stored in the matching slot.
    float tq = max(phat_sel, 0.0);
    float t_src = tq;
    if (tq <= 0.0 || t_src <= 0.0) {
        store_empty(lamp, w_sum, m, target);
        return;
    }
    float denom = 0.0;
    uint count = 0u;
    if (!is_empty(lamp_c, m_c)) {
        count += m_c;
        denom += m_as_f(m_c) * tq;
    }
    if (!is_empty(lamp_h, m_h)) {
        count += m_h;
        denom += m_as_f(m_h) * tq;
    }
    if (denom <= 0.0 || count == 0u) {
        store_empty(lamp, w_sum, m, target);
        return;
    }
    float w_new = area * t_src / (tq * denom);
    lamp = sel;
    w_sum = w_new * m_as_f(count) * tq;
    m = count;
    target = tq;
    // `sel` is kept so a later reader sees which lamp won. `phat_of_*` above
    // is that lamp's luminance because the caller fills both with weights[sel]
    // is not available yet; see the call site, which passes weights[own lamp]
    // and this function treats the picked slot as the selected lamp's p̂.
    // That is correct: the picked slot's lamp is `sel`, and phat_of_that is
    // weights[sel].
}

void initial_at(uint recv, uint n, out uint lamp, out float w_sum, out uint m, out float target, out float weights[64]) {
    for (uint i = 0u; i < n; i++) {
        weights[i] = target_at(recv, i);
    }
    lamp = LAMP_EMPTY;
    w_sum = 0.0;
    m = 0u;
    for (uint c = 0u; c < pc.candidates; c++) {
        bool hit = false;
        uint next_lamp = 0u;
        float pdf = 0.0;
        if (pc.proposal == PROPOSAL_TARGET) {
            sample_cdf(weights, n, next_lamp, pdf, hit);
        } else if (n == 0u) {
            hit = false;
        } else {
            next_lamp = uniform_index(n);
            pdf = 1.0 / float(n);
            hit = true;
        }
        if (!hit) {
            stream_update(lamp, w_sum, m, LAMP_EMPTY, 0.0);
        } else {
            float phat = weights[next_lamp];
            float stream = pdf > 0.0 ? phat / pdf : 0.0;
            stream_update(lamp, w_sum, m, next_lamp, stream);
        }
    }
    target = 0.0;
    if (lamp != LAMP_EMPTY && lamp < n) {
        target = weights[lamp];
    }
    if (m == 0u || lamp == LAMP_EMPTY || target <= 0.0 || w_sum <= 0.0) {
        store_empty(lamp, w_sum, m, target);
    }
}

void write_reservoir(uint slot, uint lamp, float w_sum, uint m, float target) {
    if (m == 0u || lamp == LAMP_EMPTY || target <= 0.0 || w_sum <= 0.0) {
        words[slot] = LAMP_EMPTY;
        words[slot + 1u] = floatBitsToUint(0.0);
        words[slot + 2u] = 0u;
        words[slot + 3u] = floatBitsToUint(0.0);
    } else {
        words[slot] = lamp;
        words[slot + 1u] = floatBitsToUint(w_sum);
        words[slot + 2u] = m;
        words[slot + 3u] = floatBitsToUint(target);
    }
}

void main() {
    rng_init();
    uint n = pc.lamp_count;
    if (n > 64u) {
        n = 64u;
    }
    uint receivers = pc.receiver_count;
    if (receivers > MAX_RECV) {
        receivers = MAX_RECV;
    }
    uint h_lamp[256];
    float h_w[256];
    uint h_m[256];
    float h_target[256];
    for (uint recv = 0u; recv < receivers; recv++) {
        h_lamp[recv] = LAMP_EMPTY;
        h_w[recv] = 0.0;
        h_m[recv] = 0u;
        h_target[recv] = 0.0;
    }
    uint c_lamp[256];
    float c_w[256];
    uint c_m[256];
    float c_target[256];
    for (uint frame = 0u; frame < pc.frames; frame++) {
        for (uint recv = 0u; recv < receivers; recv++) {
            float weights[64];
            initial_at(recv, n, c_lamp[recv], c_w[recv], c_m[recv], c_target[recv], weights);
        }
        for (uint recv = 0u; recv < receivers; recv++) {
            float weights[64];
            for (uint i = 0u; i < n; i++) {
                weights[i] = target_at(recv, i);
            }
            uint lamp = c_lamp[recv];
            float w_sum = c_w[recv];
            uint m = c_m[recv];
            float target = c_target[recv];
            float unit = next_f32();
            uint out_lamp = lamp;
            float out_w = w_sum;
            uint out_m = m;
            float out_target = target;
            if (h_m[recv] != 0u && h_lamp[recv] != LAMP_EMPTY) {
                uint hist_m = h_m[recv];
                float hist_w = h_w[recv];
                cap_history(hist_m, hist_w);
                float tq_c = 0.0;
                if (lamp != LAMP_EMPTY && lamp < n) {
                    tq_c = weights[lamp];
                }
                float tq_h = 0.0;
                if (h_lamp[recv] != LAMP_EMPTY && h_lamp[recv] < n) {
                    tq_h = weights[h_lamp[recv]];
                }
                merge_pair(
                    lamp, w_sum, m, target, tq_c,
                    h_lamp[recv], hist_w, hist_m, h_target[recv], tq_h,
                    tq_c, tq_h,
                    unit,
                    out_lamp, out_w, out_m, out_target);
            }
            h_lamp[recv] = out_lamp;
            h_w[recv] = out_w;
            h_m[recv] = out_m;
            h_target[recv] = out_target;
            uint slot = pc.out_base + (frame * receivers + recv) * 4u;
            write_reservoir(slot, out_lamp, out_w, out_m, out_target);
        }
        if (pc.reset_after != NO_RESET && frame + 1u == pc.reset_after) {
            for (uint recv = 0u; recv < receivers; recv++) {
                h_lamp[recv] = LAMP_EMPTY;
                h_w[recv] = 0.0;
                h_m[recv] = 0u;
                h_target[recv] = 0.0;
            }
        }
    }
}
