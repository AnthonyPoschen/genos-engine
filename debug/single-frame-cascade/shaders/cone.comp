#version 450
// Cone-march benchmark (genos-single-frame-cascade --gpu-bench): the same march
// as the CPU prototype's cone tracer, one cone a pixel, through a clip volume of
// voxel levels kept in 3D textures. Seven textures: one for each axis direction
// (rgb: light of the area that faces that way, a: that area) and one for the
// lamps. The eight levels are stacked along z in each texture. The hardware's
// trilinear filter is the prototype's eight-voxel read.
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform sampler3D faces[7];
layout(std430, set = 0, binding = 1) readonly buffer Surface { vec4 surface[]; }; // 2 a pixel: point + t0, normal + shown
layout(std430, set = 0, binding = 2) writeonly buffer Out { vec4 result[]; };     // 5 a pixel: 4 cascades (light, through), then steps and reads
layout(std140, set = 0, binding = 3) uniform Params {
    vec4 clip[8];  // xyz: world corner of each level's clip volume
    vec4 misc;     // cone width at cascade 0, cascades, pixels, frame
    vec4 sky;
};

const float BASE = 1.0 / 64.0;
const int FINEST = 2;
const int COARSEST = 9;
const float SIDE = 96.0;
const float REACH = 200.0;

uint hash(uint x) {
    x ^= x >> 16u; x *= 0x7feb352du; x ^= x >> 15u; x *= 0x846ca68bu; x ^= x >> 16u;
    return x;
}

float reads = 0.0;

void face(int d, vec3 uvw, float toward, inout float facing, inout vec3 sent) {
    if (toward > 0.0) {
        vec4 v = textureLod(faces[d], uvw, 0.0);
        facing += v.a * toward;
        sent += v.rgb * toward;
        reads += 1.0;
    }
}

// The share of the cone's cross-section that surfaces facing it cover at `at`,
// and their light over the whole cross-section.
void voxel(int level, vec3 at, vec3 dir, out float cover, out vec3 light) {
    cover = 0.0;
    light = vec3(0.0);
    float size = BASE * exp2(float(level));
    vec3 local = (at - clip[level - FINEST].xyz) / size;
    if (any(lessThan(local, vec3(0.5))) || any(greaterThan(local, vec3(SIDE - 0.5)))) {
        return;
    }
    vec3 uvw = vec3(local.xy / SIDE, (local.z + SIDE * float(level - FINEST)) / (SIDE * 8.0));
    vec4 lamp = textureLod(faces[6], uvw, 0.0);
    reads += 1.0;
    float facing = lamp.a;
    vec3 sent = lamp.rgb;
    face(0, uvw, -dir.x, facing, sent);
    face(1, uvw, dir.x, facing, sent);
    face(2, uvw, -dir.y, facing, sent);
    face(3, uvw, dir.y, facing, sent);
    face(4, uvw, -dir.z, facing, sent);
    face(5, uvw, dir.z, facing, sent);
    float cross_section = size * size;
    float raw = facing / cross_section;
    if (raw <= 0.0) {
        return;
    }
    cover = min(raw, 1.0);
    light = sent * (cover / raw / cross_section);
}

void main() {
    uint p = gl_GlobalInvocationID.x;
    if (p >= uint(misc.z)) {
        return;
    }
    vec4 at = surface[2u * p];
    vec4 facing = surface[2u * p + 1u];
    for (uint c = 0u; c < 5u; c++) {
        result[5u * p + c] = vec4(0.0);
    }
    if (facing.w < 0.5) {
        return;
    }
    vec3 n = facing.xyz;
    // One direction in the hemisphere, new each frame.
    uint h = hash(p ^ hash(uint(misc.w) + 0x9e3779b9u));
    float u = float(h & 0xffffu) / 65536.0;
    float v = float(h >> 16u) / 65536.0;
    float z = 2.0 * v - 1.0;
    float r = sqrt(max(1.0 - z * z, 0.0));
    vec3 dir = vec3(r * cos(6.2831853 * u), r * sin(6.2831853 * u), z);
    if (dot(dir, n) < 0.0) {
        dir = -dir;
    }
    float finest = BASE * exp2(float(FINEST));
    vec3 start = at.xyz + n * (0.75 * finest);
    float t = 0.75 * finest;
    float covered = 0.0;
    float reach = at.w;
    float steps = 0.0;
    int cascades = int(misc.y);
    for (int c = 0; c < cascades; c++) {
        float end = c + 1 == cascades ? REACH : reach;
        float width = misc.x / float(1 << c);
        float open = 1.0 - covered;
        vec3 met = vec3(0.0);
        while (t < end && covered < 0.98) {
            float wide = max(width * t, finest);
            int level = clamp(int(ceil(log2(wide / BASE))), FINEST, COARSEST);
            float cover;
            vec3 light;
            voxel(level, start + dir * t, dir, cover, light);
            if (cover > 0.0) {
                float seen = min(cover, 1.0 - covered);
                met += light * (seen / cover);
                covered += seen;
            }
            t += BASE * exp2(float(level));
            steps += 1.0;
        }
        float through = (1.0 - covered) / open;
        if (c + 1 == cascades) {
            met += sky.rgb * (1.0 - covered);
            through = 0.0;
        }
        result[5u * p + uint(c)] = vec4(met / open, through);
        if (covered >= 0.98) {
            break;
        }
        reach *= 4.0;
    }
    result[5u * p + 4u] = vec4(steps, reads, covered, 0.0);
}
